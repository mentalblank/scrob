---
/** Opens the ImagePicker modal for one artwork. Sits over the image it changes. */
interface Props {
  subjectUri: string | null | undefined;
  kind: "poster" | "backdrop" | "still";
  label: string;
  seasonNumber?: number;
  episodeNumber?: number;
  class?: string;
}

const { subjectUri, kind, label, seasonNumber, episodeNumber, class: className = "" } = Astro.props;
---

{subjectUri && (
  <button
    type="button"
    data-image-picker
    data-subject-uri={subjectUri}
    data-kind={kind}
    data-season={seasonNumber != null ? String(seasonNumber) : undefined}
    data-episode={episodeNumber != null ? String(episodeNumber) : undefined}
    data-label={label}
    title={label}
    aria-label={label}
    class={`absolute top-2 right-2 z-20 p-2 rounded-full bg-zinc-950/70 hover:bg-zinc-950/90 text-white/70 hover:text-white ring-1 ring-white/10 transition active:scale-95 cursor-pointer ${className}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
    </svg>
  </button>
)}
