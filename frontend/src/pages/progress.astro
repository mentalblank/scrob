---
import Base from "../layouts/Base.astro";
import MediaCard from "../components/MediaCard.astro";
import ProgressRow from "../components/ProgressRow.astro";
import Pagination from "../components/Pagination.astro";
import InfiniteScroll from "../components/InfiniteScroll.astro";
import { api, type MediaItem, type ProgressTotals, type ShowProgress } from "../lib/api";

export const prerender = false;

const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

const TABS: [string, string][] = [
  ["all", "All"],
  ["in_progress", "In Progress"],
  ["completed", "Completed"],
  ["dropped", "Dropped"],
];

const SORTS: [string, string][] = [
  ["recent", "Recently watched"],
  ["progress", "Most complete"],
  ["remaining", "Fewest left"],
  ["time", "Most time watched"],
  ["title", "Title"],
];

const params = Astro.url.searchParams;
const tab = params.get("tab") || "all";
const sort = params.get("sort") || "recent";
const search = params.get("search") || "";
const genre = params.getAll("genre").filter(Boolean);
const view = params.get("view") || "infinite";
const page = Number(params.get("page") || 1);
const preferTvdb = Astro.cookies.get("primary_metadata_source")?.value === "tvdb";

let shows: ShowProgress[] = [];
let dropped: MediaItem[] = [];
let totals: ProgressTotals = { watched_minutes: 0, replay_minutes: 0, watched_episodes: 0 };
let totalPages = 1;
let totalResults = 0;
let error = "";

try {
  const [data, blocklist] = await Promise.all([
    api.history.progress(
      {
        page,
        sort,
        status: tab === "dropped" ? "all" : tab,
        search: search || undefined,
        genre,
      },
      token,
    ),
    api.media.getBlocklistEnriched(token!).catch(() => []),
  ]);
  shows = data?.results ?? [];
  totals = data?.totals ?? totals;
  totalPages = data?.total_pages ?? 1;
  totalResults = data?.total_results ?? shows.length;
  // Dropped shows are started-then-abandoned, so they belong with the rest of
  // the watch lifecycle rather than with the content filters.
  dropped = (blocklist ?? []).filter((i: MediaItem) => i.is_dropped);
} catch (e: unknown) {
  error = e instanceof Error ? e.message : "Failed to load";
}

const genreOptions = Array.from(new Set(shows.flatMap((s) => s.genres ?? []))).sort();

function formatMinutes(total: number): string {
  if (!total) return "0m";
  const days = Math.floor(total / 1440);
  const hours = Math.floor((total % 1440) / 60);
  if (days) return `${days}d ${hours}h`;
  const minutes = total % 60;
  return hours ? `${hours}h ${minutes}m` : `${minutes}m`;
}

function withParams(changes: Record<string, string | null>): string {
  const next = new URLSearchParams(params);
  for (const [key, value] of Object.entries(changes)) {
    if (value === null) next.delete(key);
    else next.set(key, value);
  }
  next.delete("page");
  const q = next.toString();
  return `/progress${q ? `?${q}` : ""}`;
}

const baseUrl = withParams({});
---

<Base title="Progress">
  <div id="app-data" data-token={token} class="hidden" aria-hidden="true"></div>

  <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1 class="page-title mb-2">Progress</h1>
      <p class="text-zinc-500">
        {formatMinutes(totals.watched_minutes)} watched across {totals.watched_episodes.toLocaleString()} episodes
        {totals.replay_minutes > 0 && <span class="text-zinc-600"> · {formatMinutes(totals.replay_minutes)} in replays</span>}
      </p>
    </div>

    <div class="flex gap-1 p-1 bg-zinc-950/60 border border-zinc-800/50 rounded-xl shrink-0">
      {[["infinite", "Scroll"], ["pagination", "Pages"]].map(([mode, label]) => (
        <a
          href={withParams({ view: mode })}
          class={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${
            view === mode ? "bg-zinc-100 text-zinc-900" : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/60"
          }`}
        >{label}</a>
      ))}
    </div>
  </div>

  <div class="flex flex-nowrap gap-2 mb-6 border-b border-zinc-800/80 pb-4 w-full overflow-x-auto no-scrollbar">
    {TABS.map(([id, label]) => (
      <a
        href={withParams({ tab: id })}
        class={`px-5 py-2.5 rounded-xl text-sm font-semibold transition-all shrink-0 ${
          tab === id
            ? "bg-blue-600/10 border border-blue-500/30 text-zinc-100 shadow-md shadow-blue-500/5"
            : "border border-transparent bg-zinc-900/40 text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/60"
        }`}
      >
        {label}
        {id === "dropped" && dropped.length > 0 && (
          <span class="ml-1 text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-zinc-800 text-zinc-400">{dropped.length}</span>
        )}
      </a>
    ))}
  </div>

  {tab !== "dropped" && (
    <form method="GET" class="flex flex-wrap items-center gap-3 mb-8">
      <input type="hidden" name="tab" value={tab} />
      <input type="hidden" name="view" value={view} />
      <input
        type="search"
        name="search"
        value={search}
        placeholder="Search shows…"
        class="px-4 py-2 bg-zinc-950 border border-zinc-800 rounded-xl text-sm text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-blue-500/50 transition w-full sm:w-64"
      />
      <select
        name="genre"
        class="px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-xl text-xs font-bold text-zinc-300 focus:outline-none focus:border-blue-500/50 transition cursor-pointer"
      >
        <option value="">All genres</option>
        {genreOptions.map((g) => (
          <option value={g} selected={genre.includes(g)}>{g}</option>
        ))}
      </select>
      <select
        name="sort"
        class="px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-xl text-xs font-bold text-zinc-300 focus:outline-none focus:border-blue-500/50 transition cursor-pointer"
      >
        {SORTS.map(([value, label]) => (
          <option value={value} selected={sort === value}>{label}</option>
        ))}
      </select>
      <button
        type="submit"
        class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-xl transition-all active:scale-95 cursor-pointer"
      >Apply</button>
      {(search || genre.length > 0 || sort !== "recent") && (
        <a href={`/progress?tab=${tab}&view=${view}`} class="text-xs font-bold text-zinc-500 hover:text-zinc-300 transition-colors">Reset</a>
      )}
    </form>
  )}

  {error && (
    <div class="bg-red-500/10 border border-red-500 text-red-500 p-4 rounded-xl mb-8">
      {error}
    </div>
  )}

  {tab === "dropped" ? (
    dropped.length === 0 ? (
      <div class="bg-zinc-900/50 rounded-2xl p-12 text-center">
        <div class="text-zinc-500 mb-2">No dropped shows</div>
        <p class="text-zinc-600 text-sm">Dropping a show hides it from Next Up without losing its history.</p>
      </div>
    ) : (
      <div id="dropped-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {dropped.map((item) => (
          <div class="relative group/dropped" data-tmdb-id={item.tmdb_id} data-uri-id={item.uri_id} data-media-type={item.type}>
            <MediaCard item={item} hideBlock={true} hideRating={true} hideActionBar={true} />
            <div class="absolute inset-x-0 top-0 p-2 flex justify-end opacity-0 group-hover/dropped:opacity-100 transition-opacity z-20 pointer-events-none">
              <button
                data-action="unblock-direct"
                class="pointer-events-auto bg-zinc-900/90 backdrop-blur-md border border-zinc-700 hover:border-emerald-500/50 hover:bg-emerald-950/40 text-zinc-200 text-[11px] font-bold px-2.5 py-1.5 rounded-xl flex items-center gap-1.5 transition-all cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                Resume Tracking
              </button>
            </div>
          </div>
        ))}
      </div>
    )
  ) : shows.length === 0 && !error ? (
    <div class="bg-zinc-900/50 rounded-2xl p-12 text-center">
      <div class="text-zinc-500 mb-2">Nothing matches these filters</div>
      <a href="/shows" class="text-blue-500 hover:text-blue-400 font-medium transition-colors">Browse your shows</a>
    </div>
  ) : (
    <div>
      <p class="text-xs text-zinc-500 mb-3">{totalResults.toLocaleString()} shows</p>
      <div id="progress-list" class="grid grid-cols-1 lg:grid-cols-2 gap-3">
        {shows.map((show) => <ProgressRow show={show} preferTvdb={preferTvdb} />)}
      </div>

      {view === "pagination" ? (
        <Pagination currentPage={page} totalPages={totalPages} baseUrl={baseUrl} />
      ) : (
        <InfiniteScroll
          type="progress"
          currentPage={page}
          totalPages={totalPages}
          params={{
            status: tab,
            sort,
            ...(search ? { search } : {}),
            ...(genre.length ? { genre } : {}),
          }}
          targetSelector="#progress-list"
          endpoint="/partials/progress-rows"
        />
      )}
    </div>
  )}
</Base>

<script>
  const token = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';

  // Drop hides a show from Next Up; block hides it everywhere. Both are
  // blocklist entries, separated by the is_dropped flag.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-progress-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const row = btn.closest('[data-progress-row]') as HTMLElement | null;
    const uriId = row?.dataset.uriId;
    if (!row || !uriId) return;

    const isDrop = btn.dataset.progressAction === 'drop';
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = '…';
    try {
      const res = await fetch('/api/proxy/media/blocklist', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ uri_id: uriId, media_type: 'series', is_dropped: isDrop }),
      });
      if (!res.ok) throw new Error();
      row.style.transition = 'opacity 0.2s ease';
      row.style.opacity = '0';
      setTimeout(() => row.remove(), 200);
      (window as any).showToast?.(isDrop ? 'Show dropped' : 'Show blocked', 'success');
    } catch {
      btn.disabled = false;
      btn.textContent = original;
      (window as any).showToast?.('Could not update this show', 'error');
    }
  });

  // Resume a dropped show by clearing its blocklist entry.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-action="unblock-direct"]') as HTMLButtonElement | null;
    if (!btn) return;
    const container = btn.closest('[data-uri-id]') as HTMLElement | null;
    const uriId = container?.dataset.uriId;
    const mediaType = container?.dataset.mediaType;
    if (!container || !uriId || !mediaType) return;

    btn.disabled = true;
    const original = btn.innerHTML;
    btn.innerHTML = '<span class="animate-spin inline-block w-3 h-3 border-2 border-white/30 border-t-white rounded-full"></span>';
    try {
      const res = await fetch(`/api/proxy/media/blocklist?uri_id=${encodeURIComponent(uriId)}&media_type=${mediaType}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error();
      container.remove();
      const grid = document.getElementById('dropped-grid');
      if (grid && grid.children.length === 0) window.location.reload();
    } catch {
      btn.disabled = false;
      btn.innerHTML = original;
    }
  });
</script>
