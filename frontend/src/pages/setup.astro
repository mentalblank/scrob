---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";

const { user, token } = Astro.locals;

if (!user?.is_admin) {
  return Astro.redirect("/");
}

const globalSettings = await api.admin.getSettings(token!).catch(() => null);
---

<Base title="Setup" hideNav>
  <div class="max-w-lg mx-auto mt-10 md:mt-16 mb-16">
    <div class="flex flex-col items-center mb-8 text-center">
      <img src="/scrob.png" alt="Scrob Logo" class="w-20 object-contain mb-3" />
      <h1 class="text-2xl font-bold text-zinc-100">Welcome to Scrob</h1>
      <p class="text-sm text-zinc-400 mt-1">Let's get the server configured. This only takes a minute.</p>
    </div>

    <!-- Step indicator -->
    <div class="flex items-center gap-2 mb-8 px-2" id="step-indicator">
      {[0, 1, 2, 3].map((i) => (
        <div class="flex-1 h-1.5 rounded-full bg-zinc-800 step-dot" data-step={i}></div>
      ))}
    </div>

    <div class="bg-zinc-900/40 border border-zinc-800 rounded-3xl shadow-2xl backdrop-blur-md p-8">
      <div id="setup-error" class="hidden bg-red-500/10 border border-red-500 text-red-400 p-3 rounded-xl mb-6 text-sm"></div>

      <!-- Step 0: TMDB -->
      <section class="setup-step" data-step="0">
        <h2 class="text-lg font-bold text-zinc-100 mb-1">TMDB API Key</h2>
        <p class="text-sm text-zinc-400 mb-5">Powers all movie & show metadata, posters, and search. <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener" class="text-blue-400 hover:underline">Get a free key</a>.</p>
        <input
          type="text"
          id="tmdb_api_key"
          placeholder="TMDB API Key (v3 auth)"
          value={globalSettings?.tmdb_api_key || ""}
          class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
        />
        <p class="text-xs text-zinc-500 mt-2">Required to use Scrob. You can also set this later in Settings.</p>
      </section>

      <!-- Step 1: TVDB -->
      <section class="setup-step hidden" data-step="1">
        <h2 class="text-lg font-bold text-zinc-100 mb-1">TVDB API Key <span class="text-zinc-500 font-normal text-sm">(optional)</span></h2>
        <p class="text-sm text-zinc-400 mb-5">Lets users choose TVDB episode ordering for shows aired out of TMDB order. <a href="https://thetvdb.com/api-information" target="_blank" rel="noopener" class="text-blue-400 hover:underline">Get a free key</a>.</p>
        <input
          type="text"
          id="tvdb_api_key"
          placeholder="TVDB API Key"
          value={globalSettings?.tvdb_api_key || ""}
          class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
        />
      </section>

      <!-- Step 2: Radarr/Sonarr -->
      <section class="setup-step hidden" data-step="2">
        <h2 class="text-lg font-bold text-zinc-100 mb-1">Radarr & Sonarr <span class="text-zinc-500 font-normal text-sm">(optional)</span></h2>
        <p class="text-sm text-zinc-400 mb-5">Lets users request movies/shows for download. Fine-tune quality profiles and root folders later in Settings.</p>
        <div class="space-y-3">
          <div class="grid grid-cols-2 gap-3">
            <input type="url" id="radarr_url" placeholder="Radarr URL" value={globalSettings?.radarr_url || ""}
              class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            <input type="text" id="radarr_token" placeholder="Radarr API Key" value={globalSettings?.radarr_token || ""}
              class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <input type="url" id="sonarr_url" placeholder="Sonarr URL" value={globalSettings?.sonarr_url || ""}
              class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            <input type="text" id="sonarr_token" placeholder="Sonarr API Key" value={globalSettings?.sonarr_token || ""}
              class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
          </div>
        </div>
      </section>

      <!-- Step 3: Done -->
      <section class="setup-step hidden" data-step="3">
        <div class="text-center py-2">
          <div class="w-14 h-14 bg-green-500/10 border border-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h2 class="text-lg font-bold text-zinc-100 mb-1">You're all set</h2>
          <p class="text-sm text-zinc-400">Global configuration is done. You can revisit any of this later in Settings → Admin.</p>
        </div>
      </section>

      <!-- Nav buttons -->
      <div class="flex items-center justify-between mt-8">
        <button id="setup-back-btn" class="hidden px-4 py-2.5 text-sm text-zinc-400 hover:text-zinc-100 transition cursor-pointer">Back</button>
        <div class="flex-1"></div>
        <button id="setup-skip-btn" class="px-4 py-2.5 text-sm text-zinc-500 hover:text-zinc-300 transition cursor-pointer">Skip</button>
        <button id="setup-next-btn" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm rounded-xl transition-all shadow-lg shadow-blue-600/20 active:scale-95 cursor-pointer ml-2">
          Continue
        </button>
      </div>
    </div>
  </div>
</Base>

<script define:vars={{ token }}>
  const TOTAL_STEPS = 4;
  let step = 0;

  const steps = document.querySelectorAll('.setup-step');
  const dots = document.querySelectorAll('.step-dot');
  const backBtn = document.getElementById('setup-back-btn');
  const skipBtn = document.getElementById('setup-skip-btn');
  const nextBtn = document.getElementById('setup-next-btn');
  const errorEl = document.getElementById('setup-error');

  function render() {
    steps.forEach(s => s.classList.toggle('hidden', Number(s.dataset.step) !== step));
    dots.forEach(d => d.classList.toggle('bg-blue-500', Number(d.dataset.step) <= step));
    backBtn.classList.toggle('hidden', step === 0);
    skipBtn.classList.toggle('hidden', step === TOTAL_STEPS - 1);
    nextBtn.textContent = step === TOTAL_STEPS - 1 ? 'Finish' : 'Continue';
    errorEl.classList.add('hidden');
  }

  function collectPayload() {
    return {
      tmdb_api_key: (document.getElementById('tmdb_api_key')?.value || '').trim() || null,
      tvdb_api_key: (document.getElementById('tvdb_api_key')?.value || '').trim() || null,
      radarr_url: (document.getElementById('radarr_url')?.value || '').trim() || null,
      radarr_token: (document.getElementById('radarr_token')?.value || '').trim() || null,
      sonarr_url: (document.getElementById('sonarr_url')?.value || '').trim() || null,
      sonarr_token: (document.getElementById('sonarr_token')?.value || '').trim() || null,
    };
  }

  async function finish() {
    nextBtn.disabled = true;
    nextBtn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/proxy/admin/settings', {
        method: 'PATCH',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...collectPayload(), setup_completed: true }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.detail || 'Failed to save settings');
      }
      window.location.href = '/welcome';
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Failed to save settings';
      errorEl.classList.remove('hidden');
      nextBtn.disabled = false;
      nextBtn.textContent = 'Finish';
    }
  }

  nextBtn.addEventListener('click', () => {
    if (step === TOTAL_STEPS - 1) {
      finish();
      return;
    }
    step++;
    render();
  });

  skipBtn.addEventListener('click', () => {
    step++;
    render();
  });

  backBtn.addEventListener('click', () => {
    if (step > 0) step--;
    render();
  });

  render();
</script>
