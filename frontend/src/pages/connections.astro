  function renderLibraryCheckboxes(containerId, libraries, idKey) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    // Clear loading state
    container.classList.remove('italic', 'text-zinc-500');
    
    if (!libraries.length) {
      container.innerHTML = '<span class="not-italic text-zinc-500 text-sm">No supported libraries found.</span>';
      return;
    }
    
    container.innerHTML = libraries.map(lib => `
      <label class="flex items-center gap-2 cursor-pointer group px-2 py-1.5 rounded-xl border border-transparent hover:bg-zinc-800/50 transition-colors">
        <input
          type="checkbox"
          class="library-checkbox w-4 h-4 rounded accent-blue-500 cursor-pointer"
          data-id="${esc(String(lib[idKey]))}"
          ${lib.selected ? 'checked' : ''}
        />
        <span class="text-zinc-300 group-hover:text-zinc-100 transition-colors not-italic">
          ${esc(lib.name)}
          <span class="text-zinc-400 text-xs ml-1">${lib.type === 'movies' || lib.type === 'movie' ? 'Movies' : 'Shows'}</span>
        </span>
      </label>
    `).join('');

    // Add click listeners to update styling for visual feedback
    container.querySelectorAll('label').forEach(label => {
      const cb = label.querySelector('input') as HTMLInputElement;
      const updateStyle = () => {
        if (cb.checked) {
          label.classList.add('bg-blue-500/10', 'border-blue-500/30');
          label.classList.remove('hover:bg-zinc-800/50', 'border-transparent');
        } else {
          label.classList.remove('bg-blue-500/10', 'border-blue-500/30');
          label.classList.add('hover:bg-zinc-800/50', 'border-transparent');
        }
      };
      
      cb.addEventListener('change', updateStyle);
      updateStyle(); // init
    });
  }


  function setupConnections() {
    const apiKey = (document.getElementById('scrob_api_key') as HTMLInputElement | null)?.value ?? '';

    // Set webhook URLs and wire copy buttons for all existing connection cards
    document.querySelectorAll('[data-connection-id]').forEach(card => {
      const connId = card.getAttribute('data-connection-id');
      const webhookInput = card.querySelector('.conn-webhook-url') as HTMLInputElement | null;
      const connType = webhookInput?.getAttribute('data-conn-type') ?? '';
      if (webhookInput && connId && connType) {
        webhookInput.value = `${window.location.origin}/api/proxy/webhooks/${connType}/${connId}?api_key=${encodeURIComponent(apiKey)}`;
      }
      const copyBtn = card.querySelector('.conn-copy-webhook');
      if (copyBtn && webhookInput) {
        copyBtn.addEventListener('click', async () => {
          try {
            await copyToClipboard(webhookInput.value);
            flashCopied(copyBtn as HTMLElement);
          } catch {
            showMessage('Could not copy to clipboard', 'error');
          }
        });
      }
    });

    // Add Connection toggle
    const addBtn = document.getElementById('add-connection-btn');
    const addForm = document.getElementById('add-connection-form');
    const cancelBtn = document.getElementById('cancel-add-connection-btn');
    if (addBtn && addForm) {
      addBtn.addEventListener('click', () => {
        addForm.classList.toggle('hidden');
      });
    }
    if (cancelBtn && addForm) {
      cancelBtn.addEventListener('click', () => addForm.classList.add('hidden'));
    }

    // Provider-specific fields for a new connection
    const typeSelect = document.getElementById('new-conn-type') as HTMLSelectElement | null;
    const userIdRow = document.getElementById('new-conn-user-id-row');
    const usernameRow = document.getElementById('new-conn-username-row');
    const nuvioEmailRow = document.getElementById('new-nuvio-email-row');
    const nuvioProfileRow = document.getElementById('new-nuvio-profile-row');
    const urlInput = document.getElementById('new-conn-url') as HTMLInputElement | null;
    const urlLabel = document.getElementById('new-conn-url-label');
    const tokenInput = document.getElementById('new-conn-token') as HTMLInputElement | null;
    const tokenLabel = document.getElementById('new-conn-token-label');
    const nuvioProfileSelect = document.getElementById('new-nuvio-profile') as HTMLSelectElement | null;
    let pendingNuvioRefreshToken = '';
    let previousType = typeSelect?.value ?? 'jellyfin';

    const updateTypeFields = () => {
      const type = typeSelect?.value ?? 'jellyfin';
      const isPlex = type === 'plex';
      const isNuvio = type === 'nuvio';
      userIdRow?.classList.toggle('hidden', isPlex || isNuvio);
      usernameRow?.classList.toggle('hidden', !isPlex);
      nuvioEmailRow?.classList.toggle('hidden', !isNuvio);
      nuvioProfileRow?.classList.toggle('hidden', !isNuvio);
      if (urlInput) {
        if (isNuvio) {
          urlInput.value = 'https://api.nuvio.tv';
          urlInput.disabled = true;
        } else {
          if (previousType === 'nuvio' && urlInput.value === 'https://api.nuvio.tv') urlInput.value = '';
          urlInput.disabled = false;
        }
      }
      if (urlLabel) urlLabel.textContent = isNuvio ? 'Cloud API URL' : 'Server URL';
      if (tokenLabel) tokenLabel.textContent = isNuvio ? 'Nuvio Password' : 'Token';
      if (tokenInput) tokenInput.autocomplete = isNuvio ? 'current-password' : 'off';
      const syncRatings = document.getElementById('new-sync-ratings') as HTMLInputElement | null;
      const pushRatings = document.getElementById('new-push-ratings') as HTMLInputElement | null;
      const pushPlayback = document.getElementById('new-push-playback') as HTMLInputElement | null;
      pushPlayback?.closest('label')?.classList.toggle('hidden', !isNuvio);
      if (pushPlayback) pushPlayback.disabled = !isNuvio;
      const pushCollection = document.getElementById('new-push-collection') as HTMLInputElement | null;
      pushCollection?.closest('label')?.classList.toggle('hidden', !isNuvio);
      if (pushCollection) pushCollection.disabled = !isNuvio;
      for (const checkbox of [syncRatings, pushRatings]) {
        checkbox?.closest('label')?.classList.toggle('hidden', isNuvio);
        if (checkbox) checkbox.disabled = isNuvio;
      }
      const playbackLabel = document.getElementById('new-sync-playback-label');
      if (playbackLabel) playbackLabel.textContent = isNuvio ? 'Playback progress' : 'Playback events';
      const pullHeading = document.getElementById('new-pull-heading');
      const pushHeading = document.getElementById('new-push-heading');
      if (pullHeading) pullHeading.textContent = isNuvio ? 'Nuvio → Scrob' : 'Server → Scrob';
      if (pushHeading) pushHeading.textContent = isNuvio ? 'Scrob → Nuvio' : 'Scrob → Server';
      if (type !== previousType) pendingNuvioRefreshToken = '';
      previousType = type;
    };
    typeSelect?.addEventListener('change', updateTypeFields);
    updateTypeFields();

    const authenticateNuvio = async () => {
      const email = (document.getElementById('new-nuvio-email') as HTMLInputElement | null)?.value.trim() || '';
      const password = tokenInput?.value || '';
      const url = urlInput?.value || 'https://api.nuvio.tv';
      if (!email || !password) throw new Error('Nuvio email and password are required.');
      const selectedProfile = nuvioProfileSelect?.value || '';
      const response = await fetch('/api/proxy/auth/nuvio-login', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, url }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.detail || 'Nuvio sign-in failed');
      pendingNuvioRefreshToken = data.refresh_token;
      if (nuvioProfileSelect) {
        nuvioProfileSelect.innerHTML = (data.profiles || []).map((profile: any) =>
          `<option value="${esc(String(profile.profile_index))}">${esc(profile.name || `Profile ${profile.profile_index}`)} (#${esc(String(profile.profile_index))})</option>`
        ).join('');
        if (selectedProfile && [...nuvioProfileSelect.options].some(option => option.value === selectedProfile)) {
          nuvioProfileSelect.value = selectedProfile;
        }
      }
      if (!nuvioProfileSelect?.value) throw new Error('No Nuvio profile is available for this account.');
      return data;
    };

    // Test new connection button
    const testNewBtn = document.getElementById('test-new-connection-btn');
    if (testNewBtn) {
      testNewBtn.addEventListener('click', async () => {
        const type = typeSelect?.value ?? 'jellyfin';
        const u = (document.getElementById('new-conn-url') as HTMLInputElement)?.value || '';
        const t = (document.getElementById('new-conn-token') as HTMLInputElement)?.value || '';
        const ui = (document.getElementById('new-conn-user-id') as HTMLInputElement)?.value || '';
        testNewBtn.disabled = true;
        const orig = testNewBtn.textContent;
        testNewBtn.textContent = '...';
        try {
          if (type === 'nuvio') {
            await authenticateNuvio();
            showMessage('Nuvio connection successful. Select the profile to sync.');
          } else {
            let ep: string;
            if (type === 'plex') {
              ep = `/api/proxy/auth/test-plex?url=${encodeURIComponent(u)}&token=${encodeURIComponent(t)}`;
            } else if (type === 'emby') {
              ep = `/api/proxy/auth/test-emby?url=${encodeURIComponent(u)}&token=${encodeURIComponent(t)}&user_id=${encodeURIComponent(ui)}`;
            } else {
              ep = `/api/proxy/auth/test-jellyfin?url=${encodeURIComponent(u)}&token=${encodeURIComponent(t)}&user_id=${encodeURIComponent(ui)}`;
            }
            const res = await fetch(ep, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` } });
            const data = await res.json();
            if (res.ok) showMessage(data.message || 'Connection successful!');
            else throw new Error(data.detail || 'Connection test failed');
          }
        } catch (e: any) {
          showMessage(e.message, 'error');
        } finally {
          testNewBtn.disabled = false;
          testNewBtn.textContent = orig;
        }
      });
    }

    // Create connection button
    const createBtn = document.getElementById('create-connection-btn');
    if (createBtn) {
      createBtn.addEventListener('click', async () => {
        const name = (document.getElementById('new-conn-name') as HTMLInputElement)?.value.trim();
        const type = typeSelect?.value ?? 'jellyfin';
        const u = (document.getElementById('new-conn-url') as HTMLInputElement)?.value.trim();
        let connectionToken = (document.getElementById('new-conn-token') as HTMLInputElement)?.value.trim();
        let userId = (document.getElementById('new-conn-user-id') as HTMLInputElement)?.value.trim() || null;
        const username = (document.getElementById('new-conn-username') as HTMLInputElement)?.value.trim() || null;
        if (!name || !u || !connectionToken) {
          showMessage(type === 'nuvio' ? 'Name, Nuvio email and password are required.' : 'Name, URL and Token are required.', 'error');
          return;
        }

        createBtn.disabled = true;
        const orig = createBtn.textContent;
        createBtn.textContent = 'Adding…';

        const externalUrl = (document.getElementById('new-conn-external-url') as HTMLInputElement)?.value || null;

        try {
          if (type === 'nuvio') {
            await authenticateNuvio();
            connectionToken = pendingNuvioRefreshToken;
            userId = nuvioProfileSelect?.value || null;
          }
          const body: Record<string, any> = {
            name, type, url: u, token: connectionToken, external_server_url: externalUrl,
            sync_collection: (document.getElementById('new-sync-collection') as HTMLInputElement)?.checked ?? true,
            sync_watched: (document.getElementById('new-sync-watched') as HTMLInputElement)?.checked ?? true,
            sync_ratings: type === 'nuvio' ? false : ((document.getElementById('new-sync-ratings') as HTMLInputElement)?.checked ?? true),
            sync_playback: (document.getElementById('new-sync-playback') as HTMLInputElement)?.checked ?? true,
            push_watched: (document.getElementById('new-push-watched') as HTMLInputElement)?.checked ?? false,
            push_collection: type === 'nuvio' && ((document.getElementById('new-push-collection') as HTMLInputElement)?.checked ?? false),
            push_playback: type === 'nuvio' && ((document.getElementById('new-push-playback') as HTMLInputElement)?.checked ?? false),
            push_ratings: type === 'nuvio' ? false : ((document.getElementById('new-push-ratings') as HTMLInputElement)?.checked ?? false),
            auto_sync_interval: (() => {
              const value = (document.getElementById('new-auto-sync') as HTMLSelectElement)?.value;
              return value ? parseFloat(value) : null;
            })(),
            partial_sync_interval: (() => {
              const value = (document.getElementById('new-partial-sync') as HTMLSelectElement)?.value;
              return value ? parseFloat(value) : null;
            })(),
            auto_push_interval: (() => {
              const value = (document.getElementById('new-auto-push') as HTMLSelectElement)?.value;
              return value ? parseFloat(value) : null;
            })(),
          };
          if (type === 'plex') body.server_username = username;
          else body.server_user_id = userId;

          const res = await fetch('/api/proxy/auth/connections', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.detail || 'Failed to create connection');
          }
          showMessage('Connection added! Reloading…');
          setTimeout(() => window.location.reload(), 1000);
        } catch (e: any) {
          showMessage(e.message, 'error');
          createBtn.disabled = false;
          createBtn.textContent = orig;
        }
      });
    }
  }

  function setupScrobbleConnections() {
    const apiKey = (document.getElementById('scrob_api_key') as HTMLInputElement | null)?.value ?? '';

    // Set webhook URLs and wire copy buttons for scrobble connection cards
    document.querySelectorAll('[data-scrobble-conn-id]').forEach(card => {
      const connId = card.getAttribute('data-scrobble-conn-id');
      const webhookInput = card.querySelector('.scrobble-webhook-url') as HTMLInputElement | null;
      const connType = webhookInput?.getAttribute('data-conn-type') ?? '';
      if (webhookInput && connId && connType) {
        webhookInput.value = `${window.location.origin}/api/proxy/webhooks/${connType}/scrobble/${connId}?api_key=${encodeURIComponent(apiKey)}`;
      }
      const copyBtn = card.querySelector('.scrobble-copy-webhook');
      if (copyBtn && webhookInput) {
        copyBtn.addEventListener('click', async () => {
          try {
            await copyToClipboard(webhookInput.value);
            flashCopied(copyBtn as HTMLElement);
          } catch {
            showMessage('Could not copy to clipboard', 'error');
          }
        });
      }
    });

    // Show/hide user_id vs username based on new scrobble connection type
    const scrobbleTypeSelect = document.getElementById('new-scrobble-type') as HTMLSelectElement | null;
    const scrobbleUserIdRow = document.getElementById('new-scrobble-user-id-row');
    const scrobbleUsernameRow = document.getElementById('new-scrobble-username-row');
    const updateScrobbleTypeFields = () => {
      const isPlex = scrobbleTypeSelect?.value === 'plex';
      scrobbleUserIdRow?.classList.toggle('hidden', isPlex);
      scrobbleUsernameRow?.classList.toggle('hidden', !isPlex);
    };
    scrobbleTypeSelect?.addEventListener('change', updateScrobbleTypeFields);
    updateScrobbleTypeFields();

    // Create scrobble connection button
    const createScrobbleBtn = document.getElementById('create-scrobble-conn-btn');
    if (createScrobbleBtn) {
      createScrobbleBtn.addEventListener('click', async () => {
        const name = (document.getElementById('new-scrobble-name') as HTMLInputElement)?.value.trim();
        const type = scrobbleTypeSelect?.value ?? 'jellyfin';
        const ui = (document.getElementById('new-scrobble-user-id') as HTMLInputElement)?.value.trim() || null;
        const un = (document.getElementById('new-scrobble-username') as HTMLInputElement)?.value.trim() || null;
        if (!name) { showMessage('Name is required.', 'error'); return; }

        createScrobbleBtn.setAttribute('disabled', 'true');
        const orig = createScrobbleBtn.textContent;
        createScrobbleBtn.textContent = 'Adding…';

        const body: Record<string, any> = { name, type };
        if (type === 'plex') body.server_username = un;
        else body.server_user_id = ui;

        try {
          const res = await fetch('/api/proxy/auth/scrobble-connections', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.detail || 'Failed to create scrobble connection');
          }
          showMessage('Scrobble connection added! Reloading…');
          setTimeout(() => window.location.reload(), 1000);
        } catch (e: any) {
          showMessage(e.message, 'error');
          createScrobbleBtn.removeAttribute('disabled');
          createScrobbleBtn.textContent = orig;
        }
      });
    }
  }


  function setupCollapsibleRows() {
    document.querySelectorAll('.collapsible-header').forEach(header => {
      header.addEventListener('click', () => {
        const targetId = header.getAttribute('data-target');
        const body = targetId ? document.getElementById(targetId) : null;
        if (!body) return;
        const isOpen = !body.classList.contains('hidden');
        if (isOpen) {
          body.classList.add('hidden');
          header.querySelector('.collapsible-chevron')?.classList.remove('rotate-180');
        } else {
          body.classList.remove('hidden');
          header.querySelector('.collapsible-chevron')?.classList.add('rotate-180');
        }
      });
    });
  }

  async function loadLastSynced() {
    const appData = document.getElementById('app-data') as HTMLElement | null;
    const token = appData?.dataset.token ?? '';
    if (!token) return;

    try {
      const res = await fetch('/api/proxy/sync/status', {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) return;
      const jobs: any[] = await res.json();

      function parseUTC(dateStr: string): Date {
        return new Date(dateStr.endsWith('Z') || dateStr.includes('+') ? dateStr : dateStr + 'Z');
      }
      function timeAgo(dateStr: string): string {
        const diff = Math.floor((Date.now() - parseUTC(dateStr).getTime()) / 1000);
        if (diff < 60) return 'just now';
        if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
        return `${Math.floor(diff / 86400)}d ago`;
      }

      for (const source of ['jellyfin', 'emby', 'plex', 'nuvio'] as const) {
        const el = document.getElementById(`${source}-last-sync`);
        if (!el) continue;
        const job = jobs.find(j => j.source === source && (j.status === 'completed' || j.status === 'failed'));
        if (!job) continue;
        const label = job.status === 'failed' ? `failed ${timeAgo(job.updated_at)}` : `synced ${timeAgo(job.updated_at)}`;
        el.textContent = label;
        el.classList.remove('hidden');
      }
    } catch {
      // non-fatal
    }
  }


  const escapeHtml = (window as any).esc;


  async function loadSyncWarnings() {
    const appData = document.getElementById('app-data') as HTMLElement | null;
    const token = appData?.dataset.token ?? '';
    if (!token) return;

    try {
      // Remember which warning detail panes are currently open so we can restore them after rebuild
      const expandedDetails = new Set<string>();
      document.querySelectorAll('[id^="conn-warnings-details-"]').forEach(el => {
        if (!el.classList.contains('hidden')) expandedDetails.add(el.id);
      });

      const [statusRes, overridesRes, matchedRes, unmatchedRes] = await Promise.all([
        fetch('/api/proxy/sync/status', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/proxy/sync/season-overrides', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/proxy/sync/matched-shows', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/proxy/sync/unmatched-warnings', { headers: { 'Authorization': `Bearer ${token}` } }),
      ]);
      if (!statusRes.ok) return;
      const jobs: any[] = await statusRes.json();
      const overrides: any[] = overridesRes.ok ? await overridesRes.json() : [];
      const matchedShows: any[] = matchedRes.ok ? await matchedRes.json() : [];

      // Stored job warnings are a snapshot from sync time — seasons since matched
      // (or that never really failed) are still in there. The unmatched-warnings
      // endpoint re-checks against current data, so use it as the source of truth
      // for which warnings are still worth showing.
      const stillUnmatched: { seasons: any[]; titles: any[] } =
        unmatchedRes.ok ? await unmatchedRes.json() : { seasons: [], titles: [] };
      const liveSeasonKeys = new Set(
        stillUnmatched.seasons.map((x: any) => `${x.source_uri_id}:${x.season}`)
      );
      const liveSeasonCounts = new Map(
        stillUnmatched.seasons.map((x: any) => [`${x.source_uri_id}:${x.season}`, x.affected_episodes])
      );
      const liveTitles = new Set(
        stillUnmatched.titles.map((x: any) => String(x.title ?? '').toLowerCase())
      );
      // Dismissed rows are already filtered out of stillUnmatched, so anything
      // missing from these sets is either resolved or deliberately hidden.

      // Build a lookup: lowercase show_title → matched show info
      // Used to overlay matched state onto SyncJob warnings that lack matched:true stamps
      const matchedShowMap = new Map<string, any>();
      for (const m of matchedShows) {
        if (m.show_title) matchedShowMap.set(m.show_title.toLowerCase(), m);
      }

      const overrideMap = new Map<string, any>();
      for (const o of overrides) {
        overrideMap.set(`${o.source_show_uri_id ?? o.source_show_id}:${o.source_season_number}`, o);
      }

      // Find all connection warning containers on the page
      const containers = document.querySelectorAll<HTMLElement>('[id^="conn-warnings-"]');
      containers.forEach(container => {
        const connId = container.id.replace('conn-warnings-', '');
        const job = jobs.find(j => String(j.connection_id) === connId && j.status === 'completed' && j.warnings?.length > 0);
        if (!job) { container.classList.add('hidden'); container.innerHTML = ''; return; }

        const warnings: any[] = job.warnings;
        const _updatedAt = job.updated_at.endsWith('Z') || job.updated_at.includes('+') ? job.updated_at : job.updated_at + 'Z';
        const date = new Date(_updatedAt).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' });
        const detailsId = `conn-warnings-details-${connId}`;

        const enrichmentWarnings = warnings
          .filter((w: any) => w.tmdb_id !== undefined && w.season !== undefined)
          .filter((w: any) => liveSeasonKeys.has(`${w.source_uri_id ?? `tmdb:s:${w.tmdb_id}`}:${w.season}`))
          .map((w: any) => ({
            ...w,
            affected_episodes:
              liveSeasonCounts.get(`${w.source_uri_id ?? `tmdb:s:${w.tmdb_id}`}:${w.season}`)
              ?? w.affected_episodes,
          }));
        // Warnings stamped matched:true have since been resolved — they are no
        // longer "couldn't be synced", so they must not be listed or counted.
        const unmatchedWarnings = warnings
          .filter((w: any) => w.title !== undefined)
          .filter((w: any) => !w.matched)
          .filter((w: any) => liveTitles.has(String(w.series_name ?? w.title ?? '').toLowerCase()));

        const renderEnrichment = enrichmentWarnings.length > 0 ? `
          <div class="space-y-1">
            <p class="text-xs text-zinc-500 mb-2">These seasons couldn't be resolved against the provider shown on each row — the show is often split into separate series there. Use "Remap" to point each season at the correct show.</p>
            ${enrichmentWarnings.map((w: any) => {
              // Warnings record which catalogue the lookup failed against; older
              // entries predate the field and were always TMDB.
              const provider = (w.provider ?? 'tmdb').toLowerCase();
              const providerLabel = provider === 'tvdb' ? 'TVDB' : 'TMDB';
              const srcUri = w.source_uri_id ?? `${provider}:s:${w.tmdb_id}`;
              const key = `${srcUri}:${w.season}`;
              const existing = overrideMap.get(key);
              const remapAttr = `data-src-uri="${srcUri}" data-src-season="${w.season}" data-src-title="${escapeHtml(w.show)}" data-src-provider="${provider}"`;
              const badgeCls = provider === 'tvdb'
                ? 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30'
                : 'bg-sky-500/10 text-sky-400 border-sky-500/30';
              return `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${escapeHtml(w.show)}</span>
                  <span class="ml-2 text-xs text-zinc-500">Season ${w.season}</span>
                  <span class="ml-2 text-[10px] font-bold px-1.5 py-0.5 rounded border ${badgeCls}" title="Not found on ${providerLabel}">No ${providerLabel} match</span>
                  ${existing ? `<span class="ml-2 text-xs text-green-500">→ remapped</span>` : ''}
                </div>
                <span class="text-xs text-zinc-600 shrink-0 mr-2">${w.affected_episodes} ep${w.affected_episodes !== 1 ? 's' : ''}</span>
                <div class="flex items-center gap-1.5 shrink-0">
                  <button type="button" class="remap-season-btn text-xs px-2.5 py-1 rounded-xl border cursor-pointer transition-colors ${existing ? 'border-green-700/50 text-green-400 hover:bg-green-900/20' : 'bg-amber-500/15 border-amber-500/40 text-amber-500 hover:bg-amber-500/25 hover:border-amber-500/60'}" ${remapAttr}>
                    ${existing ? 'Edit remap' : 'Remap'}
                  </button>
                  <a href="/remaps?mode=season&src_uri=${encodeURIComponent(srcUri)}&src_season=${w.season}" class="text-xs px-2.5 py-1 rounded-xl border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-zinc-200 transition-colors bg-zinc-900/40" title="Advanced mapping on the overrides page">
                    Advanced
                  </a>
                  <button type="button" class="dismiss-warning-btn p-1 rounded-lg text-zinc-600 hover:text-zinc-300 hover:bg-zinc-800 transition-colors cursor-pointer" data-dismiss-key="${srcUri}:${w.season}" title="Dismiss">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  </button>
                </div>
              </div>`;
            }).join('')}
          </div>
        ` : '';
        // Group episode warnings by series_name to avoid N identical rows for the same show.
        // Series-level warnings for the same show are merged in (to carry their GUIDs) rather
        // than rendered as a separate row. Matched state is read directly from warning entries,
        // with a fallback to matchedShowMap for warnings created before auto-stamping existed.
        type GroupEntry = {
          count: number;
          reason: string;
          provider?: string;
          plex_guids: string[];
          matched: boolean;
          matched_tvdb_id?: number;
          matched_show_id?: number;
          matched_show_uri_id?: string;
          matched_show_title?: string;
        };
        const groupedEpisodeWarnings: Map<string, GroupEntry> = new Map();
        const standaloneUnmatched: any[] = [];
        for (const w of unmatchedWarnings) {
          if (w.media_type === 'episode' && w.series_name) {
            // Always overlay DB state — it reflects the current show linkage regardless of stamp age
            const dbMatch = matchedShowMap.get((w.series_name ?? '').toLowerCase());
            const isMatched = !!w.matched || !!dbMatch;
            // Resolved shows aren't part of the "couldn't sync" set any more.
            if (isMatched) continue;
            const existing = groupedEpisodeWarnings.get(w.series_name);
            if (existing) {
              existing.count++;
              if (isMatched) {
                existing.matched = true;
                // Prefer tvdb_id: DB > stamp (stamps from old `already_linked` runs may have null tvdb_id)
                existing.matched_tvdb_id = dbMatch?.tvdb_id ?? w.matched_tvdb_id ?? existing.matched_tvdb_id;
                existing.matched_show_id = dbMatch?.show_id ?? w.matched_show_id ?? existing.matched_show_id;
                existing.matched_show_uri_id = dbMatch?.show_uri_id ?? w.matched_show_uri_id ?? existing.matched_show_uri_id;
                existing.matched_show_title = dbMatch?.show_title_matched ?? w.matched_show_title ?? existing.matched_show_title;
              }
            } else {
              groupedEpisodeWarnings.set(w.series_name, {
                count: 1,
                reason: w.reason ?? 'unknown reason',
                provider: w.provider ?? 'tmdb',
                plex_guids: w.plex_guids ?? [],
                matched: isMatched,
                matched_tvdb_id: dbMatch?.tvdb_id ?? w.matched_tvdb_id,
                matched_show_id: dbMatch?.show_id ?? w.matched_show_id,
                matched_show_uri_id: dbMatch?.show_uri_id ?? w.matched_show_uri_id,
                matched_show_title: dbMatch?.show_title_matched ?? w.matched_show_title,
              });
            }
          } else {
            standaloneUnmatched.push(w);
          }
        }

        // Merge series-level standalone warnings into grouped episode entries where the title
        // matches, absorbing their GUIDs. Suppress the standalone row to avoid duplication.
        // Also apply matchedShowMap overlay to standalone series-level warnings.
        const trueStandaloneUnmatched = standaloneUnmatched.filter((w: any) => {
          const grouped = groupedEpisodeWarnings.get(w.title);
          if (grouped) {
            if (w.plex_guids?.length && !grouped.plex_guids.length) {
              grouped.plex_guids = w.plex_guids;
            }
            return false; // suppress — already shown in grouped section
          }
          // Apply matchedShowMap overlay for series-type standalone warnings
          if (!w.matched && (w.media_type === 'series' || w.media_type === 'episode')) {
            const dbMatch = matchedShowMap.get((w.title ?? '').toLowerCase());
            if (dbMatch) {
              w.matched = true;
              w.matched_tvdb_id = dbMatch.tvdb_id;
              w.matched_show_id = dbMatch.show_id;
              w.matched_show_title = dbMatch.show_title_matched;
            }
          }
          return true;
        });

        const hasUnmatched = groupedEpisodeWarnings.size > 0 || trueStandaloneUnmatched.length > 0;
        const displayCount = enrichmentWarnings.length + groupedEpisodeWarnings.size + trueStandaloneUnmatched.length;
        const renderUnmatched = hasUnmatched ? `
          <div class="space-y-1 ${enrichmentWarnings.length > 0 ? 'mt-4 pt-4 border-t border-zinc-800/60' : ''}">
            <p class="text-xs text-zinc-500 mb-2">Items that couldn't be automatically matched:</p>
            ${[...groupedEpisodeWarnings.entries()].map(([seriesName, {count, reason, provider: groupProvider, plex_guids, matched, matched_tvdb_id, matched_show_id, matched_show_uri_id, matched_show_title}]) => {
              const isMatched = matched;
              const matchedTitle = matched_show_title ?? '';
              const matchHref = matched_show_uri_id ? `/show/${matched_show_uri_id}` : (matched_tvdb_id ? `/show/tvdb:s:${matched_tvdb_id}` : '');
              return `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${escapeHtml(seriesName)}</span>
                  <span class="ml-2 text-xs text-zinc-600">${count} episode${count !== 1 ? 's' : ''}</span>
                  ${isMatched ? '' : `<span class="ml-2 text-[10px] font-bold px-1.5 py-0.5 rounded border bg-sky-500/10 text-sky-400 border-sky-500/30" title="No provider id found during sync">No ${(groupProvider ?? 'tmdb').toUpperCase()} match</span>`}
                  ${isMatched
                    ? `<span class="ml-2 text-xs text-green-500">→ matched${matchedTitle && matchedTitle.toLowerCase() !== seriesName.toLowerCase() ? ` as "${escapeHtml(matchedTitle)}"` : ''}</span>`
                    : `<p class="text-xs text-zinc-500 mt-0.5">${escapeHtml(reason)}</p>`
                  }
                  ${plex_guids.length ? `<p class="text-xs text-zinc-600 font-mono mt-0.5">${plex_guids.map((g: string) => escapeHtml(g)).join(' · ')}</p>` : ''}
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${isMatched && matchHref ? `<a href="${escapeHtml(matchHref)}" class="text-xs px-2.5 py-1 rounded-xl border border-green-700/40 text-green-400 hover:bg-green-900/20 transition-colors">View</a>` : ''}
                  ${isMatched
                    ? `<button type="button" class="unmatch-show-btn text-xs px-2.5 py-1 rounded-xl border border-zinc-700 text-zinc-400 hover:bg-zinc-800 cursor-pointer transition-colors"
                        data-series-name="${escapeHtml(seriesName)}">Unmatch</button>`
                    : `<button type="button" class="match-show-btn text-xs px-2.5 py-1 rounded-xl border bg-amber-500/15 border-amber-500/40 text-amber-500 hover:bg-amber-500/25 hover:border-amber-500/60 cursor-pointer transition-colors"
                        data-series-name="${escapeHtml(seriesName)}">Match</button>`
                  }
                  ${isMatched ? '' : `<button type="button" class="dismiss-warning-btn p-1 rounded-lg text-zinc-600 hover:text-zinc-300 hover:bg-zinc-800 transition-colors cursor-pointer" data-dismiss-key="title:series:${escapeHtml(seriesName.toLowerCase())}" title="Dismiss">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  </button>`}
                </div>
              </div>`;
            }).join('')}
            ${trueStandaloneUnmatched.map((w: any) => {
              const wMatched = !!w.matched;
              const wMatchedTitle = w.matched_movie_title ?? w.matched_show_title ?? '';
              const wMatchHref = w.media_type === 'movie' && w.matched_tmdb_id
                ? `/movie/${w.matched_tmdb_id}`
                : (w.matched_tvdb_id ? `/show/tvdb:s:${w.matched_tvdb_id}` : (w.matched_show_id ? `/show/${w.matched_show_id}` : ''));
              return `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${escapeHtml(w.title)}</span>
                  ${w.media_type ? `<span class="ml-2 text-xs text-zinc-600">${escapeHtml(w.media_type)}</span>` : ''}
                  ${wMatched ? '' : `<span class="ml-2 text-[10px] font-bold px-1.5 py-0.5 rounded border bg-sky-500/10 text-sky-400 border-sky-500/30">No ${(w.provider ?? 'tmdb').toUpperCase()} match</span>`}
                  ${wMatched
                    ? `<span class="ml-2 text-xs text-green-500">→ matched${wMatchedTitle && wMatchedTitle.toLowerCase() !== (w.title ?? '').toLowerCase() ? ` as "${escapeHtml(wMatchedTitle)}"` : ''}</span>`
                    : `<p class="text-xs text-zinc-500 mt-0.5">${escapeHtml(w.reason ?? 'unknown reason')}</p>`
                  }
                  ${w.plex_guids?.length ? `<p class="text-xs text-zinc-600 font-mono mt-0.5">${w.plex_guids.map((g: string) => escapeHtml(g)).join(' · ')}</p>` : ''}
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${wMatched && wMatchHref ? `<a href="${escapeHtml(wMatchHref)}" class="text-xs px-2.5 py-1 rounded-xl border border-green-700/40 text-green-400 hover:bg-green-900/20 transition-colors">View</a>` : ''}
                  ${wMatched
                    ? `<button type="button" class="unmatch-show-btn text-xs px-2.5 py-1 rounded-xl border border-zinc-700 text-zinc-400 hover:bg-zinc-800 cursor-pointer transition-colors"
                        data-series-name="${escapeHtml(w.title)}" data-media-type="${escapeHtml(w.media_type ?? '')}">Unmatch</button>`
                    : `<button type="button" class="match-show-btn text-xs px-2.5 py-1 rounded-xl border bg-amber-500/15 border-amber-500/40 text-amber-500 hover:bg-amber-500/25 hover:border-amber-500/60 cursor-pointer transition-colors shrink-0"
                        data-series-name="${escapeHtml(w.title)}" data-media-type="${escapeHtml(w.media_type ?? '')}">Match</button>`
                  }
                </div>
              </div>`;
            }).join('')}
          </div>
        ` : '';

        // Everything in the stored warnings has since been resolved or dismissed —
        // an empty "0 items couldn't be synced" banner is just noise.
        if (displayCount === 0) {
          container.classList.add('hidden');
          container.innerHTML = '';
          return;
        }

        container.classList.remove('hidden');
        container.innerHTML = `
          <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 overflow-hidden">
            <button
              type="button"
              class="w-full flex items-center justify-between px-4 py-3 text-left hover:bg-amber-500/10 transition-colors cursor-pointer"
              onclick="const d=document.getElementById('${detailsId}');const c=this.querySelector('.warn-chevron');d.classList.toggle('hidden');c.classList.toggle('rotate-180');"
            >
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400 shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">${displayCount} item${displayCount > 1 ? 's' : ''} couldn't be fully synced</span>
                <span class="text-xs text-zinc-500">· ${escapeHtml(date)}</span>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="warn-chevron w-4 h-4 text-amber-500/60 transition-transform shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div id="${detailsId}" class="hidden border-t border-amber-500/15 px-4 py-3">
              ${renderEnrichment}
              ${renderUnmatched}
            </div>
          </div>
        `;

        // Restore expanded state if this pane was open before the rebuild
        if (expandedDetails.has(detailsId)) {
          document.getElementById(detailsId)?.classList.remove('hidden');
          container.querySelector('.warn-chevron')?.classList.add('rotate-180');
        }

        container.querySelectorAll('.remap-season-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const el = btn as HTMLElement;
            window["openRemapModal"](
              el.dataset.srcUri ?? '',
              parseInt(el.dataset.srcSeason ?? '0'),
              el.dataset.srcTitle ?? '',
            );
          });
        });

        container.querySelectorAll('.dismiss-warning-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const el = btn as HTMLButtonElement;
            const key = el.dataset.dismissKey;
            if (!key) return;
            el.disabled = true;
            try {
              const res = await fetch('/api/proxy/sync/warnings/dismiss', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                body: JSON.stringify({ key }),
              });
              if (!res.ok) throw new Error();
              loadSyncWarnings();
            } catch {
              el.disabled = false;
            }
          });
        });

        container.querySelectorAll('.match-show-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const el = btn as HTMLElement;
            const mediaType = el.dataset.mediaType ?? '';
            if (mediaType === 'movie') {
              window["openMatchMovieModal"](el.dataset.seriesName ?? '');
            } else {
              window["openMatchModal"](el.dataset.seriesName ?? '');
            }
          });
        });

        container.querySelectorAll('.unmatch-show-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const el = btn as HTMLButtonElement;
            const seriesName = el.dataset.seriesName ?? '';
            const mediaType = el.dataset.mediaType ?? '';
            if (!seriesName) return;
            el.disabled = true;
            el.textContent = 'Removing…';
            try {
              const isMovie = mediaType === 'movie';
              const res = await fetch(`/api/proxy/sync/${isMovie ? 'unmatch-movie' : 'unmatch-show'}`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(isMovie ? { movie_title: seriesName } : { show_title: seriesName }),
              });
              if (!res.ok) throw new Error(await res.text());
              loadSyncWarnings();
            } catch (e: any) {
              el.disabled = false;
              el.textContent = 'Unmatch';
              alert(`Failed to unmatch: ${e.message ?? 'Unknown error'}`);
            }
          });
        });
      });

      // Wire up static (SSR-rendered) season remap rows in the active remaps panel
      document.querySelectorAll<HTMLElement>('#season-remaps-list .remap-season-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          (window as any).openRemapModal(
            parseInt(btn.dataset.srcTmdb ?? '0'),
            parseInt(btn.dataset.srcSeason ?? '0'),
            btn.dataset.srcTitle ?? '',
          );
        });
      });
      document.querySelectorAll<HTMLButtonElement>('#season-remaps-list .delete-override-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const overrideId = btn.dataset.overrideId;
          if (!overrideId || !confirm('Remove this season remap?')) return;
          btn.disabled = true;
          btn.textContent = 'Removing…';
          try {
            const res = await fetch(`/api/proxy/sync/season-overrides/${overrideId}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            if (res.ok) {
              btn.closest('[data-override-id]')?.remove();
              const list = document.getElementById('season-remaps-list');
              if (list && list.children.length === 0) {
                document.getElementById('season-remaps-panel')?.remove();
              }
            } else {
              btn.disabled = false;
              btn.textContent = 'Remove';
            }
          } catch (_) {
            btn.disabled = false;
            btn.textContent = 'Remove';
          }
        });
      });
    } catch (_) { /* non-critical */ }
  }

  // ── Season remap modal ────────────────────────────────────────────────────


  function setupSeasonRemap() {
    const appData = document.getElementById('app-data') as HTMLElement | null;
    const token = appData?.dataset.token ?? '';
    const modal = document.getElementById('season-remap-modal') as HTMLElement;
    if (!modal) return;

    let srcTmdbId = 0;
    let srcUri: string | null = null;
    let srcSeason = 0;
    let targetTmdbId = 0;
    let targetTvdbId = 0;
    let targetSeasonNumber = 0;
    let modalMode: 'remap' | 'match' | 'match-movie' = 'remap';
    let matchSeriesName = '';
    let matchMovieTitle = '';

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      (document.getElementById('remap-search-input') as HTMLInputElement).value = '';
      (document.getElementById('remap-tvdb-input') as HTMLInputElement).value = '';
      (document.getElementById('remap-search-results') as HTMLElement).innerHTML = '';
      (document.getElementById('remap-tvdb-results') as HTMLElement).innerHTML = '';
      (document.getElementById('remap-seasons-list') as HTMLElement).innerHTML = '';
      (document.getElementById('remap-selected-area') as HTMLElement).classList.add('hidden');
      (document.getElementById('match-tab-bar') as HTMLElement).classList.add('hidden');
      (document.getElementById('remap-save') as HTMLButtonElement).disabled = true;
      (document.getElementById('remap-error') as HTMLElement).classList.add('hidden');
      targetTmdbId = 0;
      targetTvdbId = 0;
      targetSeasonNumber = 0;
      modalMode = 'remap';
      matchSeriesName = '';
      matchMovieTitle = '';
    };

    const setMatchTab = (tab: 'tvdb' | 'tmdb') => {
      const tvdbBtn = document.getElementById('match-tab-tvdb') as HTMLElement;
      const tmdbBtn = document.getElementById('match-tab-tmdb') as HTMLElement;
      const tvdbSection = document.getElementById('remap-tvdb-section') as HTMLElement;
      const tmdbSection = document.getElementById('remap-tmdb-section') as HTMLElement;
      const selectedArea = document.getElementById('remap-selected-area') as HTMLElement;
      const saveBtn = document.getElementById('remap-save') as HTMLButtonElement;
      // Reset selection
      selectedArea.classList.add('hidden');
      saveBtn.disabled = true;
      targetTmdbId = 0;
      targetTvdbId = 0;
      if (tab === 'tvdb') {
        tvdbBtn.className = 'flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer bg-zinc-800 text-zinc-100';
        tmdbBtn.className = 'flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer text-zinc-400 hover:text-zinc-200';
        tvdbSection.classList.remove('hidden');
        tmdbSection.classList.add('hidden');
        (document.getElementById('remap-tvdb-results') as HTMLElement).innerHTML = '';
        const tvdbInput = document.getElementById('remap-tvdb-input') as HTMLInputElement;
        tvdbInput.focus();
        if (tvdbInput.value.trim()) doTvdbSearch();
      } else {
        tmdbBtn.className = 'flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer bg-zinc-800 text-zinc-100';
        tvdbBtn.className = 'flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer text-zinc-400 hover:text-zinc-200';
        tmdbSection.classList.remove('hidden');
        tvdbSection.classList.add('hidden');
        (document.getElementById('remap-search-results') as HTMLElement).innerHTML = '';
        const tmdbInput = document.getElementById('remap-search-input') as HTMLInputElement;
        tmdbInput.focus();
        if (tmdbInput.value.trim()) doSearch();
      }
    };

    document.getElementById('match-tab-tvdb')?.addEventListener('click', () => setMatchTab('tvdb'));
    document.getElementById('match-tab-tmdb')?.addEventListener('click', () => setMatchTab('tmdb'));

    document.getElementById('remap-close')?.addEventListener('click', closeModal);
    document.getElementById('remap-cancel')?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    document.getElementById('remap-clear-selection')?.addEventListener('click', () => {
      (document.getElementById('remap-selected-area') as HTMLElement).classList.add('hidden');
      (document.getElementById('remap-seasons-list') as HTMLElement).innerHTML = '';
      (document.getElementById('remap-save') as HTMLButtonElement).disabled = true;
      targetTmdbId = 0;
      targetTvdbId = 0;
      targetSeasonNumber = 0;
    });

    const searchInput = document.getElementById('remap-search-input') as HTMLInputElement;
    const searchBtn = document.getElementById('remap-search-btn') as HTMLButtonElement;

    const renderSearchResult = (r: any, resultsEl: HTMLElement) => {
      resultsEl.innerHTML = '';
      const year = String(r.first_air_date ?? r.release_date ?? '').slice(0, 4);
      resultsEl.innerHTML = `
        <button type="button" class="remap-result w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-zinc-800 transition-colors cursor-pointer text-left"
          data-tmdb="${r.tmdb_id}" data-title="${escapeHtml(r.title ?? '')}" data-year="${escapeHtml(year)}" data-poster="${escapeHtml(r.poster_path ?? '')}">
          <img src="${escapeHtml(r.poster_path ?? '')}" alt="" class="w-8 h-11 object-cover rounded bg-zinc-700 shrink-0" onerror="this.style.display='none'" />
          <div class="flex-1 min-w-0">
            <p class="text-sm text-zinc-100 truncate">${escapeHtml(r.title ?? '')}</p>
            <p class="text-xs text-zinc-500">${escapeHtml(year)}</p>
          </div>
        </button>`;
      resultsEl.querySelectorAll('.remap-result').forEach(btn => wireResultClick(btn as HTMLElement));
    };

    const wireResultClick = (btn: HTMLElement) => {
      btn.addEventListener('click', async () => {
        const tmdbId = parseInt(btn.dataset.tmdb ?? '0');
        const tvdbId = parseInt(btn.dataset.tvdb ?? '0');
        if (tvdbId) {
          targetTvdbId = tvdbId;
          targetTmdbId = 0;
        } else {
          targetTmdbId = tmdbId;
          targetTvdbId = 0;
        }
        targetSeasonNumber = 0;
        (document.getElementById('remap-selected-poster') as HTMLImageElement).src = btn.dataset.poster ?? '';
        (document.getElementById('remap-selected-title') as HTMLElement).textContent = btn.dataset.title ?? '';
        (document.getElementById('remap-selected-year') as HTMLElement).textContent = btn.dataset.year ?? '';
        (document.getElementById('remap-selected-area') as HTMLElement).classList.remove('hidden');
        (document.getElementById('remap-search-results') as HTMLElement).innerHTML = '';
        (document.getElementById('remap-tvdb-results') as HTMLElement).innerHTML = '';
        searchInput.value = '';

        const saveBtn = document.getElementById('remap-save') as HTMLButtonElement;
        const seasonsArea = document.getElementById('remap-seasons-area') as HTMLElement;

        if (modalMode === 'match' || modalMode === 'match-movie') {
          // No season selection needed for show/movie matching — enable save immediately
          seasonsArea.classList.add('hidden');
          saveBtn.disabled = false;
          return;
        }

        // Remap mode: fetch and render season list
        saveBtn.disabled = true;
        seasonsArea.classList.remove('hidden');
        const seasonsList = document.getElementById('remap-seasons-list') as HTMLElement;
        const seasonsLoading = document.getElementById('remap-seasons-loading') as HTMLElement;
        seasonsList.innerHTML = '';
        seasonsLoading.classList.remove('hidden');
        try {
          const showUri = tvdbId ? `tvdb:s:${tvdbId}` : `tmdb:s:${tmdbId}`;
          const showRes = await fetch(`/api/proxy/shows/${showUri}`, {
            headers: { 'Authorization': `Bearer ${token}` },
          });
          const showData = showRes.ok ? await showRes.json() : null;
          const seasons: any[] = (showData?.seasons_meta ?? []).filter((s: any) => s.season_number > 0);
          seasonsLoading.classList.add('hidden');
          if (!seasons.length) {
            seasonsList.innerHTML = '<p class="text-xs text-zinc-500 py-1">No seasons found.</p>';
            return;
          }
          seasons.forEach((s: any) => {
            const seasonBtn = document.createElement('button');
            seasonBtn.type = 'button';
            seasonBtn.className = 'remap-season-pick w-full flex items-center gap-3 px-3 py-2 rounded-xl border border-transparent hover:border-blue-600/50 hover:bg-blue-600/10 transition-colors cursor-pointer text-left';
            seasonBtn.dataset.season = String(s.season_number);
            seasonBtn.innerHTML = `
              <img src="${escapeHtml(s.poster_path ?? '')}" alt="" class="w-8 h-11 object-cover rounded bg-zinc-700 shrink-0" onerror="this.style.display='none'" />
              <div class="flex-1 min-w-0">
                <p class="text-sm text-zinc-100">${escapeHtml(s.name ?? `Season ${s.season_number}`)}</p>
                <p class="text-xs text-zinc-500">Season ${s.season_number}${s.episode_count ? ` · ${s.episode_count} eps` : ''}</p>
              </div>`;
            seasonBtn.addEventListener('click', () => {
              targetSeasonNumber = s.season_number;
              seasonsList.querySelectorAll('.remap-season-pick').forEach(b => {
                b.classList.remove('border-blue-600/50', 'bg-blue-600/10');
                b.classList.add('border-transparent');
              });
              seasonBtn.classList.add('border-blue-600/50', 'bg-blue-600/10');
              seasonBtn.classList.remove('border-transparent');
              saveBtn.disabled = false;
            });
            seasonsList.appendChild(seasonBtn);
          });
        } catch (_) {
          seasonsLoading.classList.add('hidden');
          seasonsList.innerHTML = '<p class="text-xs text-red-400 py-1">Could not load seasons.</p>';
        }
      });
    };

    const doSearch = async () => {
      const q = searchInput.value.trim();
      if (!q) return;
      const resultsEl = document.getElementById('remap-search-results') as HTMLElement;
      resultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-2">Searching…</p>';
      try {
        const searchType = modalMode === 'match-movie' ? 'movie' : 'series';
        const res = await fetch(`/api/proxy/media/search?q=${encodeURIComponent(q)}&type=${searchType}`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) throw new Error('Search failed');
        const data = await res.json();
        const results: any[] = data.results?.slice(0, 8) ?? [];
        if (!results.length) {
          resultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-2">No results.</p>';
          return;
        }
        resultsEl.innerHTML = results.map((r: any) => {
          const year = escapeHtml(String(r.release_date ?? r.first_air_date ?? '').slice(0, 4));
          return `
          <button type="button" class="remap-result w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-zinc-800 transition-colors cursor-pointer text-left"
            data-tmdb="${r.tmdb_id}" data-title="${escapeHtml(r.title ?? '')}" data-year="${year}" data-poster="${escapeHtml(r.poster_path ?? '')}">
            <img src="${escapeHtml(r.poster_path ?? '')}" alt="" class="w-8 h-11 object-cover rounded bg-zinc-700 shrink-0" onerror="this.style.display='none'" />
            <div class="flex-1 min-w-0">
              <p class="text-sm text-zinc-100 truncate">${escapeHtml(r.title ?? '')}</p>
              <p class="text-xs text-zinc-500">${year}</p>
            </div>
          </button>`;
        }).join('');
        resultsEl.querySelectorAll('.remap-result').forEach(btn => wireResultClick(btn as HTMLElement));
      } catch (_) {
        resultsEl.innerHTML = '<p class="text-xs text-red-400 py-2">Search failed.</p>';
      }
    };

    const doTvdbSearch = async () => {
      const q = (document.getElementById('remap-tvdb-input') as HTMLInputElement).value.trim();
      if (!q) return;
      const resultsEl = document.getElementById('remap-tvdb-results') as HTMLElement;
      resultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-2">Searching…</p>';
      try {
        const res = await fetch(`/api/proxy/sync/tvdb-search`, {
          method: 'POST',
          headers: { 
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ query: q })
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          const detail: string = err.detail ?? 'Search failed';
          if (detail.toLowerCase().includes('api key')) {
            resultsEl.innerHTML = `<div class="py-2 space-y-1">
              <p class="text-xs text-amber-400">A TVDB API key is required to search. Set one in <a href="/settings" class="underline hover:text-amber-300">Settings</a> or ask your admin to configure a global key.</p>
            </div>`;
          } else {
            resultsEl.innerHTML = `<p class="text-xs text-red-400 py-2">${escapeHtml(detail)}</p>`;
          }
          return;
        }
        const data = await res.json();
        const results: any[] = data.results ?? [];
        if (!results.length) {
          resultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-2">No results found on TVDB.</p>';
          return;
        }
        resultsEl.innerHTML = results.slice(0, 8).map((r: any) => `
          <button type="button" class="remap-result w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-zinc-800 transition-colors cursor-pointer text-left"
            data-tvdb="${r.tvdb_id}" data-title="${escapeHtml(r.name ?? '')}" data-year="${escapeHtml(String(r.year ?? ''))}" data-poster="${escapeHtml(r.image ?? '')}">
            <img src="${escapeHtml(r.image ?? '')}" alt="" class="w-8 h-11 object-cover rounded bg-zinc-700 shrink-0" onerror="this.style.display='none'" />
            <div class="flex-1 min-w-0">
              <p class="text-sm text-zinc-100 truncate">${escapeHtml(r.name ?? '')}</p>
              <p class="text-xs text-zinc-500">${escapeHtml(String(r.year ?? ''))}</p>
            </div>
          </button>`).join('');
        resultsEl.querySelectorAll('.remap-result').forEach(btn => wireResultClick(btn as HTMLElement));
      } catch (e: any) {
        resultsEl.innerHTML = `<p class="text-xs text-red-400 py-2">Search failed: ${escapeHtml(e.message ?? '')}</p>`;
      }
    };

    searchBtn.addEventListener('click', doSearch);
    searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') doSearch(); });
    document.getElementById('remap-tvdb-search-btn')?.addEventListener('click', doTvdbSearch);
    (document.getElementById('remap-tvdb-input') as HTMLInputElement)?.addEventListener('keydown', (e) => { if (e.key === 'Enter') doTvdbSearch(); });

    document.getElementById('remap-save')?.addEventListener('click', async () => {
      const saveBtn = document.getElementById('remap-save') as HTMLButtonElement;
      const errEl = document.getElementById('remap-error') as HTMLElement;
      errEl.classList.add('hidden');
      saveBtn.disabled = true;

      if (modalMode === 'match') {
        if (!targetTvdbId && !targetTmdbId) return;
        saveBtn.textContent = 'Matching…';
        try {
          const body: any = { show_title: matchSeriesName };
          if (targetTvdbId) body.uri_id = `tvdb:s:${targetTvdbId}`;
          else if (targetTmdbId) body.uri_id = `tmdb:s:${targetTmdbId}`;
          const res = await fetch('/api/proxy/sync/match-unmatched-show', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) throw new Error(await res.text());
          closeModal();
          loadSyncWarnings();
        } catch (e: any) {
          errEl.textContent = `Error: ${e.message ?? 'Unknown error'}`;
          errEl.classList.remove('hidden');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Match & Apply';
        }
        return;
      }

      if (modalMode === 'match-movie') {
        if (!targetTmdbId) return;
        saveBtn.textContent = 'Matching…';
        try {
          const res = await fetch('/api/proxy/sync/match-unmatched-movie', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ movie_title: matchMovieTitle, uri_id: `tmdb:m:${targetTmdbId}` }),
          });
          if (!res.ok) throw new Error(await res.text());
          closeModal();
          loadSyncWarnings();
        } catch (e: any) {
          errEl.textContent = `Error: ${e.message ?? 'Unknown error'}`;
          errEl.classList.remove('hidden');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Match & Apply';
        }
        return;
      }

      // Remap mode
      if ((!targetTmdbId && !targetTvdbId) || !targetSeasonNumber) return;
      saveBtn.textContent = 'Saving…';
      try {
        const createRes = await fetch('/api/proxy/sync/season-overrides', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source_show_uri_id: srcUri ?? `tmdb:s:${srcTmdbId}`,
            source_season_number: srcSeason,
            target_show_uri_id: targetTvdbId ? `tvdb:s:${targetTvdbId}` : `tmdb:s:${targetTmdbId}`,
            target_season_number: targetSeasonNumber,
          }),
        });
        if (!createRes.ok) throw new Error(await createRes.text());
        const override = await createRes.json();

        saveBtn.textContent = 'Applying…';
        const applyRes = await fetch(`/api/proxy/sync/season-overrides/${override.id}/apply`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!applyRes.ok) throw new Error(await applyRes.text());

        closeModal();
        loadSyncWarnings();
      } catch (e: any) {
        errEl.textContent = `Error: ${e.message ?? 'Unknown error'}`;
        errEl.classList.remove('hidden');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save & Apply';
      }
    });

    window["openRemapModal"] = (uriOrTmdbId: string | number, season: number, title: string) => {
      modalMode = 'remap';
      srcTmdbId = typeof uriOrTmdbId === 'number' ? uriOrTmdbId : (parseInt(String(uriOrTmdbId).split(':').pop() ?? '0') || 0);
      srcUri = typeof uriOrTmdbId === 'string' ? uriOrTmdbId : null;
      srcSeason = season;
      (document.getElementById('remap-modal-title') as HTMLElement).textContent = 'Remap Season';
      (document.getElementById('remap-source-label') as HTMLElement).textContent = `"${title}" — Season ${season}`;
      (document.getElementById('remap-tmdb-label') as HTMLElement).textContent = 'Search for the correct TMDB show';
      (document.getElementById('remap-seasons-area') as HTMLElement).classList.remove('hidden');
      (document.getElementById('remap-save') as HTMLButtonElement).textContent = 'Save & Apply';
      // A season can be split on either catalogue, so let the target be looked up
      // on TVDB as well — default to whichever provider the source uri names.
      (document.getElementById('match-tab-bar') as HTMLElement).classList.remove('hidden');
      const srcProvider = String(uriOrTmdbId).startsWith('tvdb:') ? 'tvdb' : 'tmdb';
      (document.getElementById('remap-tvdb-input') as HTMLInputElement).value = title;
      (document.getElementById('remap-search-input') as HTMLInputElement).value = title;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setMatchTab(srcProvider as 'tvdb' | 'tmdb');
    };

    window["openMatchModal"] = (seriesName: string) => {
      modalMode = 'match';
      matchSeriesName = seriesName;
      (document.getElementById('remap-modal-title') as HTMLElement).textContent = 'Match Show';
      (document.getElementById('remap-source-label') as HTMLElement).textContent = `"${seriesName}"`;
      (document.getElementById('remap-seasons-area') as HTMLElement).classList.add('hidden');
      (document.getElementById('remap-save') as HTMLButtonElement).textContent = 'Match & Apply';
      (document.getElementById('remap-tmdb-label') as HTMLElement).textContent = 'Search for the correct TMDB show';
      (document.getElementById('match-tab-bar') as HTMLElement).classList.remove('hidden');
      const tvdbInput = document.getElementById('remap-tvdb-input') as HTMLInputElement;
      tvdbInput.value = seriesName;
      (document.getElementById('remap-search-input') as HTMLInputElement).value = seriesName;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      // Default to TVDB tab and auto-search
      setMatchTab('tvdb');
      doTvdbSearch();
    };

    window["openMatchMovieModal"] = (movieTitle: string) => {
      modalMode = 'match-movie';
      matchMovieTitle = movieTitle;
      (document.getElementById('remap-modal-title') as HTMLElement).textContent = 'Match Movie on TMDB';
      (document.getElementById('remap-source-label') as HTMLElement).textContent = `"${movieTitle}"`;
      (document.getElementById('remap-tmdb-label') as HTMLElement).textContent = 'Search for the correct TMDB movie';
      (document.getElementById('remap-tmdb-section') as HTMLElement).classList.remove('hidden');
      (document.getElementById('remap-tvdb-section') as HTMLElement).classList.add('hidden');
      (document.getElementById('remap-seasons-area') as HTMLElement).classList.add('hidden');
      (document.getElementById('remap-save') as HTMLButtonElement).textContent = 'Match & Apply';
      searchInput.value = movieTitle;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      searchInput.focus();
      // Auto-search immediately so results appear right away
      doSearch();
    };

    // Auto-open match modal from URL parameters if requested
    const urlParams = new URLSearchParams(window.location.search);
    const matchShow = urlParams.get('match_show');
    const matchMovie = urlParams.get('match_movie');
    if (matchShow) {
      setTimeout(() => {
        window["openMatchModal"](matchShow);
      }, 300);
    } else if (matchMovie) {
      setTimeout(() => {
        window["openMatchMovieModal"](matchMovie);
      }, 300);
    }
  }

  function setupStremioAddon() {
    const appDataEl = document.getElementById('app-data');
    const userApiKey = appDataEl?.dataset.apiKey || (window as any).currentUserApiKey || '';
    const stremioManifestInput = document.getElementById('stremio-manifest-url') as HTMLInputElement | null;
    const installStremioLink = document.getElementById('install-stremio-link') as HTMLAnchorElement | null;
    const configureStremioLink = document.getElementById('configure-stremio-link') as HTMLAnchorElement | null;
    const copyStremioBtn = document.getElementById('copy-stremio-btn');

    if (stremioManifestInput && userApiKey) {
      const httpUrl = `${window.location.origin}/stremio/${userApiKey}/manifest.json`;
      const stremioUrl = `stremio://${window.location.host}/stremio/${userApiKey}/manifest.json`;
      stremioManifestInput.value = httpUrl;
      if (installStremioLink) installStremioLink.href = stremioUrl;
      if (configureStremioLink) configureStremioLink.href = `${window.location.origin}/stremio/${userApiKey}/configure`;
    }
    if (copyStremioBtn && stremioManifestInput) {
      copyStremioBtn.addEventListener('click', () => {
        if (!stremioManifestInput.value) return;
        navigator.clipboard.writeText(stremioManifestInput.value);
        showMessage('Stremio manifest URL copied to clipboard!', 'success');
      });
    }
  }

  const COPY_ICON = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>`;
  const CHECK_ICON = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;

  async function copyToClipboard(text: string): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Clipboard API needs a secure context — fall back to a throwaway textarea.
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
  }

  function flashCopied(btn: HTMLElement): void {
    const original = btn.innerHTML;
    btn.innerHTML = CHECK_ICON;
    setTimeout(() => { btn.innerHTML = original; }, 1500);
  }

  // ── Tab management ────────────────────────────────────────────────────────
  function setupConnTabs() {
    const buttons = document.querySelectorAll('[data-conn-tab-btn]');
    const panes = document.querySelectorAll('[data-conn-tab]');
    const ACTIVE = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-blue-600/10 border border-blue-500/30 text-zinc-100 shadow-md shadow-blue-500/5 cursor-pointer shrink-0";
    const IDLE = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all border border-transparent bg-zinc-900/40 text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/60 cursor-pointer shrink-0";

    function switchTab(tabId: string | null) {
      if (!tabId) return;
      panes.forEach(pane => pane.classList.toggle('hidden', pane.getAttribute('data-conn-tab') !== tabId));
      buttons.forEach(btn => {
        btn.className = btn.getAttribute('data-conn-tab-btn') === tabId ? ACTIVE : IDLE;
      });
      localStorage.setItem('active-connections-tab', tabId);
      history.replaceState(null, '', `#tab-${tabId}`);
    }

    buttons.forEach(btn => btn.addEventListener('click', () => switchTab(btn.getAttribute('data-conn-tab-btn'))));

    const hash = window.location.hash;
    let initial = hash.startsWith('#tab-') ? hash.substring(5) : (localStorage.getItem('active-connections-tab') || 'media-servers');
    if (!document.querySelector(`[data-conn-tab-btn="${initial}"]`)) initial = 'media-servers';
    switchTab(initial);
  }

  // ── Save ──────────────────────────────────────────────────────────────────
  function setupConnectionsForm() {
    const form = document.getElementById('connections-form') as HTMLFormElement | null;
    const saveBtn = document.getElementById('save-connections-btn') as HTMLButtonElement | null;
    if (!form || !saveBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';

      try {
        const formData = new FormData(form);
        const payload: Record<string, unknown> = {
          radarr_url: formData.get('radarr_url') || null,
          radarr_token: formData.get('radarr_token') || null,
          radarr_root_folder: formData.get('radarr_root_folder') || null,
          radarr_quality_profile: formData.get('radarr_quality_profile') ? parseInt(formData.get('radarr_quality_profile') as string) : null,
          radarr_tags: formData.getAll('radarr_tags').map(id => parseInt(id as string)),

          sonarr_url: formData.get('sonarr_url') || null,
          sonarr_token: formData.get('sonarr_token') || null,
          sonarr_root_folder: formData.get('sonarr_root_folder') || null,
          sonarr_quality_profile: formData.get('sonarr_quality_profile') ? parseInt(formData.get('sonarr_quality_profile') as string) : null,
          sonarr_tags: formData.getAll('sonarr_tags').map(id => parseInt(id as string)),
          sonarr_season_folder: formData.get('sonarr_season_folder') === 'true',

          trakt_client_id: formData.get('trakt_client_id') || null,
          trakt_client_secret: formData.get('trakt_client_secret') || null,
          trakt_full_sync_interval: formData.get('trakt_full_sync_interval') ? parseInt(formData.get('trakt_full_sync_interval') as string) : null,
          trakt_partial_sync_interval: formData.get('trakt_partial_sync_interval') ? parseInt(formData.get('trakt_partial_sync_interval') as string) : null,
          simkl_client_id: formData.get('simkl_client_id') || null,
          mdblist_api_key: formData.get('mdblist_api_key') || null,
        };

        const flagKeys = [
          'trakt_sync_watched', 'trakt_sync_ratings', 'trakt_sync_lists', 'trakt_watchlist_split',
          'trakt_push_watched', 'trakt_push_ratings', 'trakt_push_collection', 'trakt_push_lists', 'trakt_scrobble',
          'simkl_sync_watched', 'simkl_sync_ratings', 'simkl_sync_lists',
          'simkl_push_watched', 'simkl_push_ratings', 'simkl_scrobble',
          'mdblist_sync_watched', 'mdblist_sync_ratings', 'mdblist_sync_watchlist',
          'mdblist_push_watched', 'mdblist_push_ratings', 'mdblist_push_watchlist', 'mdblist_push_collection', 'mdblist_scrobble',
        ] as const;
        for (const key of flagKeys) {
          const el = document.querySelector<HTMLInputElement>(`[name="${key}"]`);
          if (el) payload[key] = el.checked;
        }

        const res = await fetch('/api/proxy/auth/settings', {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Failed to update connections');
        }
        showMessage('Connections updated successfully!');
      } catch (e: any) {
        showMessage(e.message, 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  }

  setupConnTabs();
  setupActions();
  setupConnections();
  setupScrobbleConnections();
  setupCollapsibleRows();
  setupConnectionsForm();
  setupStremioAddon();
  checkConnections();
  loadSyncWarnings();
  loadLastSynced();
  setupSeasonRemap();

  document.addEventListener('astro:after-swap', () => {
    setupConnTabs();
    setupActions();
    setupConnections();
    setupScrobbleConnections();
    setupCollapsibleRows();
    setupConnectionsForm();
    setupStremioAddon();
    checkConnections();
    loadSyncWarnings();
    loadLastSynced();
    setupSeasonRemap();
  });
</script>
