    }

    const clearRatingsBtn = document.getElementById('clear-ratings-btn') as HTMLButtonElement | null;
    if (clearRatingsBtn) {
      clearRatingsBtn.onclick = async () => {
        if (!confirm('Are you sure you want to clear all your ratings? This cannot be undone.')) return;
        clearRatingsBtn.disabled = true;
