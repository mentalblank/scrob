                    <span class={`w-2 h-2 ${typeColor} rounded-full shrink-0`}></span>
                    <div class="flex flex-col gap-0.5 min-w-0">
                      <span class="font-medium text-zinc-200">{conn.name}</span>
                      <span class="text-xs text-zinc-500 break-all">{typeLabel}{identity ? ` · ${identity}` : ' · Webhook only'}</span>
                    </div>
                  </div>
                  <div class="flex items-center justify-between sm:justify-end gap-3 w-full sm:w-auto">
                    <div onclick="event.stopPropagation()">
                      <button type="button" data-action="delete_scrobble_connection" data-conn-id={conn.id} data-conn-name={conn.name}
                        class="js-action-btn text-xs sm:text-sm bg-zinc-800 hover:bg-red-900/30 text-red-400 border border-zinc-700 hover:border-red-700 px-2.5 sm:px-3 py-1.5 rounded-xl transition-colors cursor-pointer"
                      >Delete</button>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none shrink-0">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </div>
                </div>
                <div id={`scrobble-body-${conn.id}`} class="hidden border-t border-zinc-800 px-6 py-6">
                  <div class="grid md:grid-cols-2 gap-6">
                    <!-- Left: identity + webhook URL -->
                    <div class="space-y-4">
                      <div class="space-y-2">
                        <label class="block text-sm font-medium text-zinc-400">Display Name</label>
                        <input type="text" class="scrobble-name-input w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" value={conn.name} data-conn-id={conn.id} />
                      </div>
                      {conn.type === "plex" ? (
                        <div class="space-y-2">
                          <label class="block text-sm font-medium text-zinc-400">Plex Username</label>
                          <p class="text-zinc-100 font-mono text-sm">{conn.server_username || <span class="text-zinc-600 italic">not set</span>}</p>
                        </div>
                      ) : (
                        <div class="space-y-2">
                          <label class="block text-sm font-medium text-zinc-400">User ID</label>
                          <p class="text-zinc-100 font-mono text-sm">{conn.server_user_id || <span class="text-zinc-600 italic">not set</span>}</p>
                        </div>
                      )}
                      <div class="space-y-2">
                        <label class="block text-sm font-medium text-zinc-400">Webhook URL</label>
                        <div class="flex gap-2">
