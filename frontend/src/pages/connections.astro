                      <button
                        type="button"
                        class="delete-override-btn text-xs px-2.5 py-1 rounded-lg border border-zinc-700 text-zinc-400 hover:bg-zinc-800 cursor-pointer transition-colors shrink-0"
                        data-override-id={o.id}
                      >Remove</button>
                    </div>
                  ))}
                </div>
              </div>
            </details>
          )}

          <!-- ======== SCROBBLE-ONLY CONNECTIONS SECTION ======== -->
          <div class="space-y-3 mt-8">
            <h2 class="section-headline border-b border-zinc-800 pb-2">Scrobble-only Connections</h2>
            <p class="text-sm text-zinc-500">Webhook-only connections for scrobbling. No URL or token needed — just pick your server type and enter your username or user ID so events can be attributed to you.</p>

            <div id="scrobble-connections-list" class="space-y-2">
            {scrobbleConnections.map((conn) => {
              const typeColor = conn.type === "jellyfin" ? "bg-purple-500" : conn.type === "emby" ? "bg-green-500" : "bg-yellow-500";
              const typeLabel = conn.type === "jellyfin" ? "Jellyfin" : conn.type === "emby" ? "Emby" : "Plex";
              const identity = conn.type === "plex" ? conn.server_username : conn.server_user_id;
              return (
              <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden" data-scrobble-conn-id={conn.id}>
                <div class="collapsible-header flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target={`scrobble-body-${conn.id}`}>
