                        <div class="flex items-center justify-between gap-4">
                          <label class="text-sm text-zinc-300">Push interval</label>
                          <select id="new-auto-push" class="bg-zinc-800 border border-zinc-700 rounded-xl px-3 py-2 text-sm text-zinc-100 cursor-pointer">
