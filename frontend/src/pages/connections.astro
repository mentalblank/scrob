      const connectBtn = document.getElementById('mdblist-connect-btn');
      const disconnectBtn = document.getElementById('mdblist-disconnect-btn');

      if (connectBtn) {
        connectBtn.onclick = async () => {
          // MDBList has no OAuth handshake — the API key is the credential, so
