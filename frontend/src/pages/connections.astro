    const clearCollectionBtn = document.getElementById('clear-collection-btn') as HTMLButtonElement | null;
    if (clearCollectionBtn) {
      clearCollectionBtn.onclick = async () => {
        if (!confirm('Are you sure you want to clear your entire collection? Your watch history will be preserved, but all collection links will be removed.')) return;
        clearCollectionBtn.disabled = true;
        clearCollectionBtn.textContent = 'Clearing...';
        try {
          const res = await fetch(`/api/proxy/sync/collection`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) {
            showMessage('Collection cleared successfully!');
          } else {
