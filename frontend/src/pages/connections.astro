                          <button type="button" class="scrobble-copy-webhook px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-xl transition-colors cursor-pointer" data-conn-id={conn.id}>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.991 1.08 1.991 2.25v12a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.75a2.25 2.25 0 011.991-2.25c.639-.074 1.28-.135 1.927-.184" /></svg>
                          </button>
                        </div>
                      </div>
                    </div>
                    <!-- Right: sync preferences -->
                    <div class="space-y-3">
                      <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
                        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Sync Preferences</p>
                        {[
                          { key: "sync_collection", label: "Add to collection" },
                          { key: "sync_watched",    label: "Watch history" },
                          { key: "sync_playback",   label: "Continue Watching" },
                        ].map(({ key, label }) => (
                          <label class="flex items-center gap-3 cursor-pointer group">
                            <input type="checkbox" class="scrobble-pref-checkbox w-4 h-4 rounded cursor-pointer" data-conn-id={conn.id} data-pref={key} checked={!!conn[key as keyof typeof conn]} />
                            <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
                          </label>
                        ))}
                      </div>
                      <button type="button" data-action="save_scrobble_connection" data-conn-id={conn.id} class="js-action-btn text-sm bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition-colors cursor-pointer">Save</button>
                    </div>
                  </div>
                </div>
              </div>
              );
            })}
            </div>

            <!-- Add Scrobble Connection form -->
            <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
              <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="new-scrobble-conn-body">
                <span class="font-medium text-zinc-300">+ Add Scrobble Connection</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
              <div id="new-scrobble-conn-body" class="hidden border-t border-zinc-800 px-6 py-6">
                <div class="space-y-4 max-w-sm">
                  <div class="space-y-2">
                    <label for="new-scrobble-name" class="block text-sm font-medium text-zinc-400">Name</label>
                    <input type="text" id="new-scrobble-name" placeholder="e.g. Home Plex" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                  </div>
