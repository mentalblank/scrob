---
import Base from "../layouts/Base.astro";
import MediaCard from "../components/MediaCard.astro";
import { api, type MediaItem } from "../lib/api";

export const prerender = false;

const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

let items: MediaItem[] = [];
let error = "";

try {
  const data = await api.history.nextUp(token, undefined, true);
  items = data?.next_up ?? [];
} catch (e: unknown) {
  error = e instanceof Error ? e.message : "Failed to load";
}

const isHidden = (item: MediaItem) =>
  item.next_up_hidden === true || item.is_dropped === true || item.is_blocked === true;
const hasVisible = items.some((i) => !isHidden(i));
---

<Base title="Next Up">
  <div class="mb-8 flex items-center justify-between gap-4">
    <div>
      <h1 class="page-title mb-2">Next Up</h1>
      <p class="text-zinc-500">Continue where you left off</p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <div class="flex gap-1 p-1 bg-zinc-950/60 border border-zinc-800/50 rounded-xl" id="next-up-view-toggle">
        <button
          type="button"
          data-view-mode="comfortable"
          title="Card view"
          class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all duration-200 cursor-pointer flex items-center gap-1.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
          Cards
        </button>
        <button
          type="button"
          data-view-mode="compact"
          title="Compact list view"
          class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all duration-200 cursor-pointer flex items-center gap-1.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
          Compact
        </button>
      </div>
    <button
      id="toggle-hidden-btn"
      class="flex items-center gap-2 px-4 py-2 text-sm font-bold text-zinc-400 bg-zinc-900/40 hover:bg-zinc-900/60 border border-zinc-800/50 rounded-xl hover:border-zinc-600 hover:text-zinc-200 transition-all active:scale-95 cursor-pointer shrink-0"
    >
      <svg id="toggle-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
        <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>
      </svg>
      <span id="toggle-label">Show dropped</span>
    </button>
    </div>
  </div>

  {error && (
    <div class="bg-red-500/10 border border-red-500 text-red-500 p-4 rounded-xl mb-8">
      {error}
    </div>
  )}

  <div id="next-up-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
    {items.map((item) => (
      <div data-nu-wrapper data-next-up-hidden={isHidden(item) ? "true" : "false"} class={isHidden(item) ? "hidden" : ""}>
        <MediaCard item={item} />
      </div>
    ))}
  </div>

  <div id="empty-state" class={hasVisible ? "hidden text-center py-20 text-zinc-500" : "text-center py-20 text-zinc-500"}>
    <p class="text-lg">Nothing to watch next.</p>
    <p class="text-sm mt-2">Start watching a show to see your next episodes here.</p>
  </div>
</Base>

<style is:global>
  .next-up-compact {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  @media (min-width: 1024px) {
    .next-up-compact { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .next-up-compact .media-card {
    flex-direction: row;
    border-radius: 1rem;
  }
  .next-up-compact .media-card-poster {
    width: 4rem;
    flex-shrink: 0;
  }
  .next-up-compact .media-card-poster > div {
    aspect-ratio: auto;
    height: 100%;
  }
  .next-up-compact .media-card-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.5rem 0.875rem;
    min-width: 0;
    order: 2;
  }
  /* The action bar is a full-width strip on a poster card; in a row it has to
     become a narrow column of icons at the end instead. */
  .next-up-compact .card-action-bar {
    order: 3;
    align-self: stretch;
    grid-template-columns: repeat(3, 2.25rem);
    border-top: 0;
    border-left: 1px solid var(--color-glass-border);
    background-color: transparent;
  }
  .next-up-compact .card-action-btn {
    padding: 0;
    gap: 0;
  }
  .next-up-compact .card-action-btn span {
    display: none;
  }
</style>

<script>
  function setupNextUpViewToggle() {
    const toggle = document.getElementById('next-up-view-toggle');
    const grid = document.getElementById('next-up-grid');
    if (!toggle || !grid) return;

    const ACTIVE = 'bg-zinc-100 text-zinc-900 shadow-lg shadow-zinc-100/5';
    const IDLE = 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/60';

    const apply = (mode: string) => {
      grid.classList.toggle('next-up-compact', mode === 'compact');
      toggle.querySelectorAll<HTMLButtonElement>('[data-view-mode]').forEach(btn => {
        const isActive = btn.dataset.viewMode === mode;
        btn.className = `px-3 py-1.5 rounded-lg text-xs font-bold transition-all duration-200 cursor-pointer flex items-center gap-1.5 ${isActive ? ACTIVE : IDLE}`;
      });
    };

    apply(localStorage.getItem('next-up-view-mode') === 'compact' ? 'compact' : 'comfortable');

    toggle.querySelectorAll<HTMLButtonElement>('[data-view-mode]').forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.viewMode || 'comfortable';
        localStorage.setItem('next-up-view-mode', mode);
        apply(mode);
      });
    });
  }

  setupNextUpViewToggle();
  document.addEventListener('astro:after-swap', setupNextUpViewToggle);

  let showingHidden = false;

  const grid = document.getElementById("next-up-grid")!;
  const empty = document.getElementById("empty-state")!;

  function syncWrapper(w: HTMLElement, hidden: boolean) {
    w.dataset.nextUpHidden = hidden ? "true" : "false";
    if (hidden && !showingHidden) {
      w.classList.add("hidden");
      w.classList.remove("opacity-50");
    } else if (hidden && showingHidden) {
      w.classList.remove("hidden");
      w.classList.add("opacity-50");
    } else {
      w.classList.remove("hidden", "opacity-50");
    }
  }

  function updateEmptyState() {
    const wrappers = grid.querySelectorAll<HTMLElement>("[data-nu-wrapper]");
    const anyVisible = [...wrappers].some((w) => w.dataset.nextUpHidden === "false");
    const anyHidden = [...wrappers].some((w) => w.dataset.nextUpHidden === "true");
    const isEmpty = !anyVisible && (!showingHidden || !anyHidden);
    empty.classList.toggle("hidden", !isEmpty);
    grid.classList.toggle("hidden", isEmpty);
  }

  // React to drop/block changes fired by the global card handler
  window.addEventListener("unified-block-changed", (e: Event) => {
    const { uriId, tmdbId, mediaType, isDropped, isBlocked } = (e as CustomEvent).detail;
    if (mediaType !== "series" && mediaType !== "episode") return;

    const card = uriId
      ? grid.querySelector(`[data-card][data-show-uri-id="${CSS.escape(uriId)}"], [data-card][data-uri-id="${CSS.escape(uriId)}"]`)
      : grid.querySelector(`[data-card][data-show-tmdb-id="${tmdbId}"], [data-card][data-tmdb-id="${tmdbId}"]`);
    const wrapper = card?.closest<HTMLElement>("[data-nu-wrapper]");
    if (!wrapper) return;

    syncWrapper(wrapper, isDropped || isBlocked);
    updateEmptyState();
  });

  // Toggle: show/hide dropped items in-place, no refetch
  document.getElementById("toggle-hidden-btn")!.addEventListener("click", () => {
    showingHidden = !showingHidden;

    document.getElementById("toggle-label")!.textContent = showingHidden ? "Hide dropped" : "Show dropped";
    document.getElementById("toggle-icon")!.innerHTML = showingHidden
      ? `<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>`
      : `<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>`;

    grid.querySelectorAll<HTMLElement>('[data-nu-wrapper][data-next-up-hidden="true"]').forEach((w) => syncWrapper(w, true));
    updateEmptyState();
  });

  updateEmptyState();
</script>
