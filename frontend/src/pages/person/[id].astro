---
import Base from "../../layouts/Base.astro";
import PosterModal from "../../components/PosterModal.astro";
import MediaCard from "../../components/MediaCard.astro";
import CommentsSection from "../../components/CommentsSection.astro";
import Pagination from "../../components/Pagination.astro";
import InfiniteScroll from "../../components/InfiniteScroll.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import { api, tmdbImageUrl, type MediaItem } from "../../lib/api";
export const prerender = false;

const { id } = Astro.params;
const { token } = Astro.locals;
const page = Number(Astro.url.searchParams.get("page") ?? 1);

// Parse URI or legacy integer ID. URI format: `tmdb:p:123` or `tvdb:p:456`.
// Provider param `?provider=tvdb` also supported for raw integer IDs.
let provider: "tmdb" | "tvdb" = "tmdb";
let numericId: number;
let fetchKey: string;
const rawId = id ?? "";
if (rawId.includes(":")) {
  const parts = rawId.split(":");
  if (parts.length === 3) {
    provider = parts[0] === "tvdb" ? "tvdb" : "tmdb";
    numericId = Number(parts[2]);
  } else {
    numericId = Number(rawId);
  }
  fetchKey = rawId;  // URI passthrough
} else {
  numericId = Number(rawId);
  const queryProvider = Astro.url.searchParams.get("provider");
  if (queryProvider === "tvdb") provider = "tvdb";
  fetchKey = provider === "tvdb" ? `tvdb:p:${numericId}` : `tmdb:p:${numericId}`;
}

const collectionParam = Astro.url.searchParams.get("collection");
const collection: "in" | "out" | "" = collectionParam === "in" || collectionParam === "out" ? collectionParam : "";
const genre = Astro.url.searchParams.getAll("genre");
const year = Astro.url.searchParams.getAll("year").map(Number).filter((y) => !Number.isNaN(y));
const minRating = Astro.url.searchParams.get("min_rating") ?? "";

// Backend `/media/person/{id}` accepts URI string ("tvdb:p:X", "tmdb:p:X") or raw integer
const person = await api.media.getPerson(fetchKey, page, token, { collection, genre, year, minRating });

const profile = await api.profile.get(token!);
const paginationType = profile?.pagination_type ?? "infinite_scroll";

const credits = person.credits || [];
const totalPages = Math.ceil(person.total_credits / person.page_size);
const filterParams = new URLSearchParams();
if (collection) filterParams.set("collection", collection);
for (const g of genre) filterParams.append("genre", g);
for (const y of year) filterParams.append("year", String(y));
if (minRating) filterParams.set("min_rating", minRating);
const baseUrl = `/person/${rawId}${filterParams.toString() ? `?${filterParams.toString()}` : ""}`;
const personUri = (person as any).uri_id ?? fetchKey;

const MOVIE_GENRES = [
  "Action", "Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Fantasy", "History", "Horror", "Music", "Mystery",
  "Romance", "Science Fiction", "Thriller", "War", "Western",
];
const TV_GENRES = [
  "Action & Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Kids", "Mystery", "News", "Reality",
  "Sci-Fi & Fantasy", "Soap", "Talk", "War & Politics", "Western",
];
const CREDIT_GENRES = Array.from(new Set([...MOVIE_GENRES, ...TV_GENRES])).sort();

const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1949 }, (_, i) => currentYear - i);
---

<Base title={person.name}>
  <div class="flex flex-col md:flex-row gap-12 max-w-5xl mx-auto py-8">
    <!-- Sidebar / Photo -->
    <div class="w-full md:w-72 shrink-0">
      <div class="sticky top-8">
        {person.profile_path ? (
          <div class="relative w-full aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl mb-6 group/photo">
            <button id="poster-zoom-btn" class="w-full h-full block cursor-zoom-in" aria-label={`Enlarge photo of ${person.name}`}>
              <img
                src={tmdbImageUrl(person.profile_path, "w185")}
                alt={person.name}
                class="w-full h-full object-cover transition-transform duration-300 group-hover/photo:scale-105"
                loading="eager"
                decoding="async"
              />
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/photo:opacity-100 transition-opacity duration-200 bg-black/30">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 text-white drop-shadow-lg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </button>
          </div>
        ) : (
          <div class="w-full aspect-[2/3] bg-zinc-900 rounded-2xl flex items-center justify-center text-6xl mb-6 border border-zinc-800">
            👤
          </div>
        )}

        <div class="space-y-6 px-2">
          <div>
            <h3 class="text-zinc-500 text-xs font-bold uppercase tracking-wider mb-1">Personal Info</h3>
            <div class="space-y-4">
              {person.known_for_department && (
                <div>
                  <p class="text-zinc-100 text-sm font-semibold">Known For</p>
                  <p class="text-zinc-400 text-sm">{person.known_for_department}</p>
                </div>
              )}
              {person.birthday && (
                <div>
                  <p class="text-zinc-100 text-sm font-semibold">Birthday</p>
                  <p class="text-zinc-400 text-sm">{person.birthday}</p>
                </div>
              )}
              {person.place_of_birth && (
                <div>
                  <p class="text-zinc-100 text-sm font-semibold">Place of Birth</p>
                  <p class="text-zinc-400 text-sm">{person.place_of_birth}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <h1 class="page-title">{person.name}</h1>
      </div>

      {person.biography && (
        <div class="mb-12">
          <h2 class="section-headline mb-4">Biography</h2>
          <p class="text-zinc-400 leading-relaxed text-lg whitespace-pre-wrap">{person.biography}</p>
        </div>
      )}

      <div>
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <h2 class="section-headline">Known For</h2>
          <FilterPanel
            id="person-credits-filters"
            basePath={`/person/${id}`}
            sections={[
              { key: "collection", label: "Collection", options: [{ value: "in", label: "In My Collection" }, { value: "out", label: "Not In My Collection" }], selected: collection ? [collection] : [], multi: false },
              { key: "genre", label: "Genre", options: CREDIT_GENRES.map((g) => ({ value: g, label: g })), selected: genre },
              { key: "year", label: "Year", options: years.map((y) => ({ value: String(y), label: String(y) })), selected: year.map(String) },
              {
                key: "min_rating",
                label: "Rating",
                options: [
                  ...[9, 8, 7, 6, 5].map((r) => ({ value: String(r), label: `${r}+ Stars` })),
                  { value: "lt5", label: "Less than 5 Stars" },
                ],
                selected: minRating ? [minRating] : [],
                multi: false,
              },
            ]}
          />
        </div>

        <div id="credits-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {credits.map((item) => (
            <div class="flex flex-col gap-1">
              <MediaCard item={item as unknown as MediaItem} />
              {item.character && (
                <p class="text-xs text-zinc-500 truncate px-1">as {item.character}</p>
              )}
            </div>
          ))}
        </div>

        {credits.length === 0 && (
          <p class="text-zinc-500 text-sm py-8">No credits match these filters.</p>
        )}

        {paginationType === "pagination" ? (
          <Pagination
            currentPage={page}
            totalPages={totalPages}
            baseUrl={baseUrl}
          />
        ) : (
          <InfiniteScroll
            type="person_credits"
            currentPage={page}
            totalPages={totalPages}
            params={{
              person_id: String(numericId),
              source: provider,
              ...(collection ? { collection } : {}),
              ...(genre.length ? { genre } : {}),
              ...(year.length ? { year: year.map(String) } : {}),
              ...(minRating ? { min_rating: minRating } : {}),
            }}
            targetSelector="#credits-grid"
            endpoint="/partials/person-credits"
          />
        )}
      </div>
<CommentsSection
  mediaType="person"
  uriId={personUri}
/>
</div>
</div>
<PosterModal posterPath={person.profile_path} title={person.name} />
</Base>

