                    {backupCodes.map((bc) => (
                      <span class={`font-mono text-sm px-3 py-1.5 rounded-xl border ${bc.used ? "text-zinc-400 border-zinc-850 line-through" : "text-zinc-300 border-zinc-750 bg-zinc-950/40"}`}>
                        {bc.code}
                      </span>
                    ))}
                  </div>
                </div>
              </details>
            </div>
          )}
        </section>

        <!-- Your API Key -->
        <section class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">API Key</h2>
          </div>
          <div class="space-y-4 max-w-xl">
            <p class="text-sm text-zinc-400">Use this key to authenticate requests to the Scrob API. Keep it secret — if it leaks, regenerate it immediately.</p>
            <div class="space-y-2">
              <label for="scrob_api_key" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">Your API Key</label>
              <div class="flex gap-2">
                <div class="relative flex-1 group/field">
                  <input
                    type="password"
                    id="scrob_api_key"
                    readonly
                    value={me.api_key}
                    class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl pl-4 pr-10 py-3 text-zinc-100 font-mono text-sm focus:outline-none cursor-default select-all"
                  />
                  <PasswordToggle />
                </div>
                <button
                  type="button"
                  id="copy-api-key-btn"
                  title="Copy to clipboard"
                  class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-xl transition-colors cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                  </svg>
                </button>
              </div>
            </div>
            <button
              type="button"
              id="regenerate-api-key-btn"
              class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-xl text-sm transition-colors cursor-pointer disabled:opacity-50"
            >
              Regenerate Key
            </button>
          </div>
        </section>

        <!-- API & Metadata Keys -->
        <section class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">API & Metadata Keys</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- TMDB API Key -->
            <div class="space-y-2">
              <label for="tmdb_api_key" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">TMDB API Key</label>
              <div class="flex gap-2">
                <div class="relative flex-1 group/field">
                  <input
                    type="password"
                    name="tmdb_api_key"
                    id="tmdb_api_key"
                    value={settings.tmdb_api_key || ""}
                    placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                    class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                  <PasswordToggle />
                </div>
                <button
                  type="button"
                  data-action="test_tmdb"
                  title="Test TMDB key"
                  class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-xl transition-colors cursor-pointer disabled:opacity-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
                  </svg>
                </button>
              </div>
              {settings.has_global_tmdb_key && !settings.tmdb_api_key ? (
                <p class="text-xs text-blue-400">A server-wide TMDB key is configured by your admin. You can leave this blank to use it, or enter your own key to override it.</p>
              ) : settings.has_global_tmdb_key && settings.tmdb_api_key ? (
                <p class="text-xs text-blue-400">A server-wide TMDB key is configured, but you are using your own key. Clear this field to fall back to the server key.</p>
              ) : (
                <p class="text-xs text-zinc-500">Required for fetching metadata and posters. Will be validated before saving.</p>
              )}
            </div>

            <!-- TVDB API Key -->
            <div class="space-y-2">
              <label for="tvdb_api_key" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">TVDB API Key</label>
              <div class="flex gap-2">
                <div class="relative flex-1 group/field">
                  <input
                    type="password"
                    name="tvdb_api_key"
                    id="tvdb_api_key"
                    value={settings.tvdb_api_key || ""}
                    placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                    class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                  <PasswordToggle />
                </div>
                <button
                  type="button"
                  data-action="test_tvdb"
                  title="Test TVDB key"
                  class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-xl transition-colors cursor-pointer disabled:opacity-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
                  </svg>
                </button>
              </div>
              {settings.has_global_tvdb_key && !settings.tvdb_api_key ? (
                <p class="text-xs text-blue-400">A server-wide TVDB key is configured by your admin. You can leave this blank to use it, or enter your own key to override it.</p>
              ) : settings.has_global_tvdb_key && settings.tvdb_api_key ? (
                <p class="text-xs text-blue-400">A server-wide TVDB key is configured, but you are using your own key. Clear this field to fall back to the server key.</p>
              ) : (
                <p class="text-xs text-zinc-500">Required for TVDB-sourced shows. Get your key at thetvdb.com.</p>
              )}
            </div>

            <!-- Primary Metadata Source -->
            <div class="space-y-2 col-span-1 md:col-span-2">
              <label for="primary_metadata_source" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">Primary Metadata Source</label>
              <select
                name="primary_metadata_source"
                id="primary_metadata_source"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-300 text-xs focus:border-blue-500 focus:outline-none transition cursor-pointer appearance-none"
              >
                <option value="tmdb" selected={settings.preferences?.primary_metadata_source !== "tvdb"}>TheMovieDB (TMDB) - Default</option>
                <option value="tvdb" selected={settings.preferences?.primary_metadata_source === "tvdb"}>TheTVDB (TVDB)</option>
              </select>
              <p class="text-xs text-zinc-500">Choose which provider to use as the primary metadata source for TV shows. Movies will continue to use TMDB.</p>
            </div>

            <!-- Default Episode Order -->
            <div class="space-y-2 col-span-1 md:col-span-2">
              <label for="default_episode_order" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">Default Episode Order</label>
              <select
                name="default_episode_order"
                id="default_episode_order"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-300 text-xs focus:border-blue-500 focus:outline-none transition cursor-pointer appearance-none"
              >
                <option value="tmdb" selected={settings.default_episode_order !== "tvdb"}>TheMovieDB (TMDB) Order - Default</option>
                <option value="tvdb" selected={settings.default_episode_order === "tvdb"}>TheTVDB (TVDB) Order</option>
              </select>
              <p class="text-xs text-zinc-500">Default episode ordering scheme (TMDB vs TVDB) used when browsing TV shows.</p>
            </div>
          </div>
        </section>

        <!-- Danger Zone -->
        <section class="bg-red-950/20 border border-red-500/20 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-red-500/20 pb-2">
            <h2 class="text-2xl font-black text-red-500 tracking-tight">Danger Zone</h2>
          </div>
          <div class="bg-red-950/30 border border-red-500/10 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <h3 class="text-lg font-bold text-zinc-100 mb-1">Delete Account</h3>
              <p class="text-zinc-400 text-sm">Once you delete your account, there is no going back. All your data will be permanently removed.</p>
            </div>
            <button
              type="button"
              id="delete-account-btn"
              class="px-6 py-3 bg-red-600 hover:bg-red-500 text-zinc-100 font-bold rounded-xl transition-all shadow-lg shadow-red-600/20 active:scale-95 whitespace-nowrap cursor-pointer text-center"
            >
              Delete Account
            </button>
          </div>
        </section>
      </div>

      <!-- Tab Panel: Maintenance & Data -->
      <div data-settings-tab="maintenance" class="space-y-12 hidden">
        <!-- Maintenance -->
        <section class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">Maintenance</h2>
          </div>
          <div class="space-y-4">
            <!-- Heal missing metadata -->
            <div class="bg-zinc-950/40 border border-zinc-800 rounded-2xl overflow-hidden">
              <div class="p-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                  <h3 class="text-lg font-bold text-zinc-100 mb-1">Heal missing metadata</h3>
                  <p class="text-zinc-400 text-sm">Re-fetches posters and dates for collection items that are missing them due to TMDB errors during sync.</p>
                </div>
                <button
                  id="heal-btn"
                  type="button"
                  disabled={!hasTmdbKey}
                  title={!hasTmdbKey ? "TMDB API Key is required" : ""}
                  class="w-full md:w-auto md:shrink-0 px-6 py-3 rounded-xl text-sm font-bold transition-all cursor-pointer disabled:opacity-50 bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 border border-blue-500/30 text-center"
                >
                  Heal
                </button>
              </div>
              <div id="heal-progress" class="hidden border-t border-zinc-800 px-6 py-4">
                <div class="flex justify-between items-center mb-1.5">
                  <span id="heal-job-label" class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Working…</span>
                  <span id="heal-job-pct" class="text-xs font-bold text-zinc-400"></span>
                </div>
                <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
                  <div id="heal-job-bar" class="h-1.5 rounded-full transition-all duration-500 bg-blue-600 animate-pulse" style="width: 100%"></div>
                </div>
                <div class="flex justify-between text-xs text-zinc-500 mt-1">
                  <span id="heal-job-items"></span>
                </div>
              </div>
            </div>

            <!-- Heal unmatched show titles -->
            <div class="bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div>
                <h3 class="text-lg font-bold text-zinc-100 mb-1">Heal unmatched show titles</h3>
                <p class="text-zinc-400 text-sm">Fixes episodes stuck as "unmatched" where the show title was lost — usually affects items synced before the title-preservation fix. Restores the title from sync history so the Match button works.</p>
              </div>
              <button
                id="heal-stub-titles-btn"
                type="button"
                class="w-full md:w-auto md:shrink-0 px-6 py-3 rounded-xl text-sm font-bold transition-all cursor-pointer bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 border border-blue-500/30 text-center"
              >
                Heal
              </button>
            </div>

            <!-- Clear now playing -->
            <div class="bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div>
                <h3 class="text-lg font-bold text-zinc-100 mb-1">Clear now playing</h3>
                <p class="text-zinc-400 text-sm">Removes all active now playing sessions. Use this if a ghost session is stuck in the bar after a restart or network interruption.</p>
              </div>
              <button
                id="clear-sessions-btn"
                type="button"
                class="w-full md:w-auto md:shrink-0 px-6 py-3 rounded-xl text-sm font-bold transition-all cursor-pointer bg-red-600/20 hover:bg-red-600/30 text-red-400 border border-red-500/30 text-center"
              >
                Clear
              </button>
            </div>
          </div>
        </section>

        <!-- Export Data -->
        <section class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">Export Data</h2>
          </div>
          <div class="bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <h3 class="text-lg font-bold text-zinc-100 mb-1">Download My Data</h3>
              <p class="text-zinc-400 text-sm">Export your watch history, ratings, collection, lists and comments as a zip you can re-import later.</p>
            </div>
            <button
              type="button"
              id="export-data-btn"
              class="px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 font-bold rounded-xl transition-all cursor-pointer whitespace-nowrap disabled:opacity-50"
            >
              Download
            </button>
          </div>
        </section>

        <!-- Data Management -->
        <section class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">Data Management</h2>
          </div>
          <div class="space-y-4">
            <div class="bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6">
              <div>
                <h3 class="text-lg font-bold text-zinc-100 mb-1">Clear Watch History</h3>
                <p class="text-zinc-400 text-sm">This will permanently delete all your watch history and progress. Your collection and ratings will not be affected.</p>
              </div>
              <button
                type="button"
                id="clear-history-btn"
                class="px-6 py-3 bg-red-600/10 hover:bg-red-600/20 text-red-500 border border-red-500/30 font-bold rounded-xl transition-all cursor-pointer whitespace-nowrap text-center"
              >
                Clear History
              </button>
            </div>

            <div class="bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6">
              <div>
                <h3 class="text-lg font-bold text-zinc-100 mb-1">Clear Ratings</h3>
                <p class="text-zinc-400 text-sm">Permanently deletes all your ratings. Your watch history and collection will not be affected.</p>
              </div>
              <button
                type="button"
                id="clear-ratings-btn"
                class="px-6 py-3 bg-red-600/10 hover:bg-red-600/20 text-red-500 border border-red-500/30 font-bold rounded-xl transition-all cursor-pointer whitespace-nowrap text-center"
              >
                Clear Ratings
              </button>
            </div>

            <div class="bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6">
              <div>
                <h3 class="text-lg font-bold text-zinc-100 mb-1">Clear Collection</h3>
                <p class="text-zinc-400 text-sm">This will permanently remove all items from your collection. Your watch history and ratings will not be affected.</p>
              </div>
              <button
                type="button"
                id="clear-collection-btn"
                class="px-6 py-3 bg-red-600/10 hover:bg-red-600/20 text-red-500 border border-red-500/30 font-bold rounded-xl transition-all cursor-pointer whitespace-nowrap text-center"
              >
                Clear Collection
              </button>
            </div>
          </div>
        </section>
      </div>

      <div id="save-settings-footer" class="pt-6 border-t border-zinc-800/60 mt-8 flex justify-end">
        <button
          id="save-settings-btn"
          type="submit"
          class="w-full sm:w-auto bg-zinc-100 text-zinc-950 font-bold px-8 py-3 rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer disabled:opacity-50"
        >
          Save Changes
        </button>
      </div>
    </form>
  </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="confirm-action-modal" class="fixed inset-0 bg-zinc-950/85 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl p-8 max-w-md w-full shadow-2xl backdrop-blur-xl overflow-hidden">
      <h2 id="confirm-action-title" class="text-2xl font-bold text-zinc-100 mb-2"></h2>
      <p id="confirm-action-body" class="text-zinc-400 mb-8 text-sm leading-relaxed"></p>
      <div class="flex gap-3">
        <button type="button" id="cancel-action" class="flex-1 px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">Cancel</button>
        <button type="button" id="confirm-action" class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer"></button>
      </div>
    </div>
  </div>

  <!-- Data Export Modal -->
  <div id="export-data-modal" class="fixed inset-0 bg-zinc-950/85 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl p-8 max-w-md w-full shadow-2xl backdrop-blur-xl max-h-[90vh] overflow-y-auto">
      <h2 class="text-2xl font-bold text-zinc-100 mb-2">Export your data</h2>
      <p class="text-zinc-400 mb-6 text-sm leading-relaxed">Choose what to include in the export.</p>
      <div class="space-y-2 mb-6">
        {[
          { key: "watched", label: "Watch History" },
          { key: "ratings", label: "Ratings" },
          { key: "collection", label: "Collection" },
          { key: "lists", label: "Lists" },
          { key: "comments", label: "Comments" },
        ].map(({ key, label }) => (
          <button
            type="button"
            data-export-option={key}
            class="export-option w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700 border-2 border-transparent rounded-xl transition-colors cursor-pointer"
          >
            <span class="text-sm font-medium text-zinc-100">{label}</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="check-icon w-5 h-5 text-blue-500">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </button>
        ))}
      </div>

      <p class="text-xs text-amber-400/90 mb-2 leading-relaxed flex items-start gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="text-red-500 w-4 h-4 shrink-0 mt-0.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <span>These include API keys and tokens in <strong>plain text</strong> — only enable if you understand the risk.</span>
      </p>
      <div class="space-y-2 mb-8">
        {[
          { key: "api_keys", label: "API Keys" },
          { key: "media_connections", label: "Media & Cloud Connections" },
          { key: "scrobble_connections", label: "Scrobble-only Connections" },
          { key: "connections", label: "Connections" },
        ].map(({ key, label }) => (
          <button
            type="button"
            data-export-option={key}
            data-secret="true"
            class="export-option w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700 border-2 border-transparent rounded-xl transition-colors cursor-pointer"
          >
            <span class="text-sm font-medium text-zinc-100">{label}</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="check-icon w-5 h-5 text-amber-500 invisible">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </button>
        ))}
      </div>
      <div class="flex gap-3">
        <button type="button" id="export-data-modal-cancel" class="flex-1 px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">Cancel</button>
        <button type="button" id="export-data-modal-confirm" class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">Export</button>
      </div>
    </div>
  </div>

  <div id="heal-modal" class="fixed inset-0 bg-zinc-950/85 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl p-8 max-w-md w-full shadow-2xl backdrop-blur-xl overflow-hidden">
      <h2 class="text-2xl font-bold text-zinc-100 mb-2">Heal missing metadata?</h2>
      <p class="text-zinc-400 mb-8 text-sm leading-relaxed">
        This will re-fetch posters and dates for collection items that are missing them. It runs in the background and may take a few minutes.
      </p>
      <div class="flex gap-3">
        <button type="button" id="cancel-heal" class="flex-1 px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">
          Cancel
        </button>
        <button type="button" id="confirm-heal" class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">
          Heal
        </button>
      </div>
    </div>
  </div>

  <div id="delete-modal" class="fixed inset-0 bg-zinc-950/85 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl p-8 max-w-md w-full shadow-2xl backdrop-blur-xl overflow-hidden">
      <h2 class="text-2xl font-bold text-zinc-100 mb-2">Are you sure?</h2>
      <p class="text-zinc-400 mb-8 text-sm leading-relaxed">
        This will permanently delete your account and remove all your data. This action cannot be undone.
      </p>
      <div class="flex gap-3">
        <button type="button" id="cancel-delete" class="flex-1 px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">
          Cancel
        </button>
        <button type="button" id="confirm-delete" class="flex-1 px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl transition-all cursor-pointer">
          Yes, delete
        </button>
      </div>
    </div>
  </div>

  <!-- Season remap / unmatched show match modal -->
  <div id="season-remap-modal" class="fixed inset-0 bg-zinc-950/85 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl w-full max-w-lg shadow-2xl flex flex-col max-h-[90vh] backdrop-blur-xl overflow-hidden">
      <div class="flex items-center justify-between px-6 py-5 border-b border-zinc-800 shrink-0">
        <div>
          <h2 id="remap-modal-title" class="text-lg font-bold text-zinc-100">Remap Season</h2>
          <p id="remap-source-label" class="text-sm text-zinc-400 mt-0.5"></p>
        </div>
        <button type="button" id="remap-close" class="text-zinc-500 hover:text-zinc-300 transition-colors cursor-pointer p-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div class="px-6 py-5 overflow-y-auto flex-1 space-y-5">
        <!-- Tab bar (match mode only) -->
        <div id="match-tab-bar" class="hidden flex gap-1 p-1 bg-zinc-950 rounded-xl">
          <button type="button" id="match-tab-tvdb" class="flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer bg-zinc-800 text-zinc-100">TVDB</button>
          <button type="button" id="match-tab-tmdb" class="flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer text-zinc-400 hover:text-zinc-200">TMDB</button>
        </div>
        <!-- TMDB title search (remap mode) -->
        <div id="remap-tmdb-section">
          <label id="remap-tmdb-label" class="block text-sm font-medium text-zinc-400 mb-2">Search for the correct TMDB show</label>
          <div class="flex gap-2">
            <input type="text" id="remap-search-input" placeholder="Show title…" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            <button type="button" id="remap-search-btn" class="px-4 py-2.5 bg-zinc-700 hover:bg-zinc-600 text-zinc-100 text-sm font-medium rounded-xl transition-colors cursor-pointer shrink-0">Search</button>
          </div>
          <div id="remap-search-results" class="mt-2 space-y-1 max-h-48 overflow-y-auto"></div>
        </div>
        <!-- TVDB title search (match mode) -->
        <div id="remap-tvdb-section" class="hidden">
          <label class="block text-sm font-medium text-zinc-400 mb-2">Search for the show on TVDB</label>
          <div class="flex gap-2">
            <input type="text" id="remap-tvdb-input" placeholder="Show title…" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            <button type="button" id="remap-tvdb-search-btn" class="px-4 py-2.5 bg-zinc-700 hover:bg-zinc-600 text-zinc-100 text-sm font-medium rounded-xl transition-colors cursor-pointer shrink-0">Search</button>
          </div>
          <div id="remap-tvdb-results" class="mt-2 space-y-1 max-h-48 overflow-y-auto"></div>
        </div>
        <!-- Selected show + season input -->
        <div id="remap-selected-area" class="hidden">
          <div class="flex items-center gap-3 p-3 bg-zinc-800 rounded-xl mb-4">
            <img id="remap-selected-poster" src="" alt="" class="w-10 h-14 object-cover rounded-lg bg-zinc-700 shrink-0" />
            <div class="flex-1 min-w-0">
              <p id="remap-selected-title" class="text-sm font-medium text-zinc-100 truncate"></p>
              <p id="remap-selected-year" class="text-xs text-zinc-500"></p>
            </div>
            <button type="button" id="remap-clear-selection" class="text-zinc-500 hover:text-zinc-300 cursor-pointer text-xs shrink-0">Change</button>
          </div>
          <div id="remap-seasons-area">
            <label id="remap-seasons-label" class="block text-sm font-medium text-zinc-400 mb-2">Select the target season</label>
            <div id="remap-seasons-list" class="space-y-1 overflow-y-auto" style="max-height: calc(var(--spacing) * 49)"></div>
            <p id="remap-seasons-loading" class="text-xs text-zinc-500 py-1 hidden">Loading seasons…</p>
          </div>
        </div>
        <p id="remap-error" class="text-sm text-red-400 hidden"></p>
      </div>
      <div class="px-6 py-4 border-t border-zinc-800 flex gap-3 shrink-0">
        <button type="button" id="remap-cancel" class="flex-1 px-4 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 text-sm font-medium rounded-xl transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="remap-save" class="flex-1 px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-xl transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" disabled>Save &amp; Apply</button>
      </div>
    </div>
  </div>
</section>

<script>
  const appData = document.getElementById('app-data');
  const token = appData?.dataset.token ?? '';

  let selectedStreaming = new Set<string>();
  let selectedLikedGenres = new Set<string>();
  let selectedDislikedGenres = new Set<string>();

  // ── Tab Management ────────────────────────────────────────────────────────
  function setupTabs() {
    const buttons = document.querySelectorAll('[data-settings-tab-btn]');
    const panes = document.querySelectorAll('[data-settings-tab]');

    function switchTab(tabId) {
      if (!tabId) return;
      panes.forEach(pane => {
        if (pane.getAttribute('data-settings-tab') === tabId) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });

      buttons.forEach(btn => {
        if (btn.getAttribute('data-settings-tab-btn') === tabId) {
          btn.className = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-blue-600/10 border border-blue-500/30 text-zinc-100 shadow-md shadow-blue-500/5 cursor-pointer shrink-0";
        } else {
          btn.className = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all border border-transparent bg-zinc-900/40 text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/60 cursor-pointer shrink-0";
        }
      });



      localStorage.setItem('active-settings-tab', tabId);
      history.replaceState(null, '', `#tab-${tabId}`);
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-settings-tab-btn');
        switchTab(tabId);
      });
    });

    let initialTab = 'profile';
    const hash = window.location.hash;
    if (hash && hash.startsWith('#tab-')) {
      initialTab = hash.substring(5);
    } else {
      const stored = localStorage.getItem('active-settings-tab');
      if (stored) initialTab = stored;
    }

    if (!document.querySelector(`[data-settings-tab-btn="${initialTab}"]`)) {
      initialTab = 'profile';
    }

    switchTab(initialTab);
  }

  setupTabs();

  // ── Plex account link ─────────────────────────────────────────────────────
  (function setupPlexAccount() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('plex_linked') === 'true') {
      window.showToast?.('Plex account linked', 'success');
    }
    const plexErr = params.get('plex_error');
    if (plexErr) {
      window.showToast?.(plexErr, 'error');
    }
    if (params.has('plex_linked') || params.has('plex_error')) {
      const url = new URL(window.location.href);
      url.searchParams.delete('plex_linked');
      url.searchParams.delete('plex_error');
      history.replaceState(null, '', url.pathname + url.search + window.location.hash);
    }

    const unlinkBtn = document.getElementById('plex-unlink-btn') as HTMLButtonElement | null;
    unlinkBtn?.addEventListener('click', async () => {
      unlinkBtn.disabled = true;
      const tok = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';
      try {
        const res = await fetch('/api/proxy/auth/plex/unlink', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${tok}` },
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Failed to unlink Plex');
        }
        window.showToast?.('Plex account unlinked', 'success');
        setTimeout(() => window.location.reload(), 600);
      } catch (err: unknown) {
        window.showToast?.(err instanceof Error ? err.message : 'Failed to unlink Plex', 'error');
        unlinkBtn.disabled = false;
      }
    });
  })();

  const esc = (window as any).esc || function(str: any) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  };
  const showMessage = (window as any).showMessage;
  const escapeHtml = (window as any).esc;

  // ── Shared sync-job cancellation ──────────────────────────────────────────
  // The background job only notices on its next cooperative checkpoint, so the
  // strip keeps showing "Cancelling…" until the next poll reflects status=cancelled.
  const connPollers = new Map<string, ReturnType<typeof setTimeout>>();

  async function cancelSyncJob(jobId: number, btn: HTMLButtonElement | null) {
    if (btn) { btn.disabled = true; btn.textContent = 'Cancelling…'; }
    try {
      await fetch(`/api/proxy/sync/${jobId}/cancel`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
      });
    } catch {
      // best-effort — the next poll reflects the real state either way
    }
  }

  function wireCancelButton(btn: HTMLButtonElement | null, job: any) {
    if (!btn) return;
    btn.classList.remove('hidden');
    btn.disabled = false;
    btn.textContent = 'Cancel';
    btn.onclick = () => cancelSyncJob(job.id, btn);
  }

  // ── Per-connection progress tracking ─────────────────────────────────────
  let healPoller: ReturnType<typeof setTimeout> | null = null;

  function renderHealProgress(job: any) {
    const strip = document.getElementById('heal-progress');
    const bar   = document.getElementById('heal-job-bar');
    const pctEl = document.getElementById('heal-job-pct');
    const label = document.getElementById('heal-job-label');
    const items = document.getElementById('heal-job-items');
    const cancelBtn = document.getElementById('heal-job-cancel') as HTMLButtonElement | null;
    if (!strip) return;

    if (!job) { strip.classList.add('hidden'); return; }
    strip.classList.remove('hidden');

    const isFailed    = job.status === 'failed';
    const isCancelled = job.status === 'cancelled';
    const isCompleted = job.status === 'completed';
    const isPending   = job.status === 'pending';

    if (isFailed || isCancelled) {
      if (cancelBtn) cancelBtn.classList.add('hidden');
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-red-500'; bar.style.width = '100%'; }
      if (label) label.textContent = isCancelled ? 'Heal cancelled' : 'Heal failed';
      if (pctEl) pctEl.textContent = '';
      if (items) items.textContent = isCancelled ? '' : esc(job.error_message || 'Unknown error');
      return;
    }

    if (isCompleted) {
      if (cancelBtn) cancelBtn.classList.add('hidden');
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-blue-600'; bar.style.width = '100%'; }
      if (label) label.textContent = 'Heal complete';
      if (pctEl) pctEl.textContent = '100%';
      if (items) items.textContent = `${job.processed_items} item${job.processed_items !== 1 ? 's' : ''} healed`;
      return;
    }

    wireCancelButton(cancelBtn, job);
    const pct = job.total_items > 0 ? Math.min(100, Math.round((job.processed_items / job.total_items) * 100)) : 0;
    const indeterminate = isPending || pct === 0;
    if (bar) {
      bar.className = `h-1.5 rounded-full transition-all duration-500 bg-blue-600${indeterminate ? ' animate-pulse' : ''}`;
      bar.style.width = indeterminate ? '100%' : `${pct}%`;
    }
    if (label) label.textContent = isPending ? 'Heal queued…' : 'Healing…';
    if (pctEl) pctEl.textContent = pct > 0 ? `${pct}%` : '';
    if (items) items.textContent = job.total_items > 0 ? `${job.processed_items} / ${job.total_items} items` : 'Loading…';
  }

  async function pollHealJob() {
    try {
      const res = await fetch('/api/proxy/sync/status', { headers: { 'Authorization': `Bearer ${token}` } });
      if (!res.ok) return;
      const jobs: any[] = await res.json();
      const job = jobs.find((j: any) => j.source === 'tmdb' && j.job_type === 'heal');
      const isActive = job && (job.status === 'pending' || job.status === 'running');
      const isRecentDone = job && (job.status === 'completed' || job.status === 'failed' || job.status === 'cancelled')
        && new Date(job.updated_at).getTime() > Date.now() - 8000;
      renderHealProgress((isActive || isRecentDone) ? job : null);
      if (isActive) {
        healPoller = setTimeout(pollHealJob, 2000);
      } else if (isRecentDone) {
        healPoller = setTimeout(() => { renderHealProgress(null); healPoller = null; }, 4000);
      } else {
        healPoller = null;
      }
    } catch {
      healPoller = null;
    }
  }

  function startHealPoller() {
    if (healPoller != null) clearTimeout(healPoller);
    pollHealJob();
  }

  // On page load, resume an in-progress heal job (connection jobs are tracked
  // on /connections).
  (async () => {
    try {
      const res = await fetch('/api/proxy/sync/status', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) return;
      const jobs: any[] = await res.json();
      for (const job of jobs) {
        if (job.source === 'tmdb' && job.job_type === 'heal' && (job.status === 'pending' || job.status === 'running')) {
          startHealPoller();
        }
      }
    } catch { /* non-fatal */ }
  })();
  // ── End progress tracking ─────────────────────────────────────────────────

  function formatList(items: string[]): string {
    if (items.length === 0) return '';
    if (items.length === 1) return items[0];
    if (items.length === 2) return `${items[0]} and ${items[1]}`;
    return `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;
  }

  function showConfirmModal(title: string, body: string, confirmLabel: string, infoOnly = false): Promise<boolean> {
    return new Promise(resolve => {
      const modal = document.getElementById('confirm-action-modal');
      const titleEl = document.getElementById('confirm-action-title');
      const bodyEl = document.getElementById('confirm-action-body');
      const confirmBtn = document.getElementById('confirm-action') as HTMLButtonElement | null;
      const cancelBtn = document.getElementById('cancel-action') as HTMLButtonElement | null;
      if (!modal || !titleEl || !bodyEl || !confirmBtn || !cancelBtn) { resolve(false); return; }
      titleEl.textContent = title;
      bodyEl.textContent = body;
      confirmBtn.textContent = confirmLabel;
      cancelBtn.classList.toggle('hidden', infoOnly);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      const cleanup = (result: boolean) => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        cancelBtn.classList.remove('hidden');
        confirmBtn.removeEventListener('click', onConfirm);
        cancelBtn.removeEventListener('click', onCancel);
        resolve(result);
      };
      const onConfirm = () => cleanup(infoOnly ? false : true);
      const onCancel = () => cleanup(false);
      confirmBtn.addEventListener('click', onConfirm, { once: true });
      cancelBtn.addEventListener('click', onCancel, { once: true });
    });
  }

  // Only the metadata-provider key tests live on this page; every connection
  // action moved to /connections.
  function setupActions() {
    document.querySelectorAll('.js-action-btn').forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', async () => {
        const action = newBtn.getAttribute('data-action');
        if (action !== 'test_tmdb' && action !== 'test_tvdb') return;

        (newBtn as HTMLButtonElement).disabled = true;
        const originalHTML = newBtn.innerHTML;
        newBtn.textContent = '...';

        try {
          const inputId = action === 'test_tmdb' ? 'tmdb_api_key' : 'tvdb_api_key';
          const key = (document.getElementById(inputId) as HTMLInputElement)?.value ?? '';
          const url = action === 'test_tmdb' ? '/api/proxy/auth/test-tmdb' : '/api/proxy/auth/test-tvdb';
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ key }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Action failed');
          showMessage(data.message || 'Action successful!', 'success');
        } catch (e: any) {
          showMessage(e.message, 'error');
        } finally {
          (newBtn as HTMLButtonElement).disabled = false;
          newBtn.innerHTML = originalHTML;
        }
      });
    });
  }

  function setupAccentSwatches() {
    const saved = localStorage.getItem('accentTheme') || 'purple';

    function applyAccent(id) {
      if (id === 'purple') {
        document.documentElement.removeAttribute('data-accent');
      } else {
        document.documentElement.setAttribute('data-accent', id);
      }
      localStorage.setItem('accentTheme', id);

      document.querySelectorAll('.accent-swatch').forEach(btn => {
        const isActive = btn.getAttribute('data-accent-id') === id;
        btn.classList.toggle('border-zinc-100', isActive);
        btn.classList.toggle('text-zinc-100', isActive);
        btn.classList.toggle('border-zinc-800', !isActive);
        btn.classList.toggle('text-zinc-400', !isActive);
      });
    }

    applyAccent(saved);

    document.querySelectorAll('.accent-swatch').forEach(btn => {
      btn.addEventListener('click', () => applyAccent(btn.getAttribute('data-accent-id')));
    });
  }

  function setupVisibilityToggles() {
    document.querySelectorAll('[data-v-group]').forEach(group => {
      const input = group.querySelector('input') as HTMLInputElement;
      group.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-v-action');
          if (!action) return;
          input.value = action;
          group.querySelectorAll('button').forEach(b => {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-lg');
            b.classList.add('text-zinc-500', 'hover:text-zinc-300');
          });
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-lg');
          btn.classList.remove('text-zinc-500', 'hover:text-zinc-300');
        });
      });
    });
  }

  function setupSettingsForm() {
    const form = document.getElementById('settings-form');
    const saveBtn = document.getElementById('save-settings-btn');
    if (!form || !saveBtn) return;

    // Plex "Also monitor users" — toggle picker visibility and lazy-load friends
    async function loadPlexFriends(picker: HTMLElement, token: string) {
      const connId = picker.getAttribute('data-conn-id');
      const monitored: string[] = JSON.parse(picker.getAttribute('data-monitored') || '[]');
      const list = picker.querySelector('.plex-user-list') as HTMLElement;
      if (!list || list.querySelector('.plex-user-checkbox')) return; // already loaded
      list.innerHTML = '<p class="text-xs text-zinc-500 italic">Loading users…</p>';
      try {
        const res = await fetch(`/api/proxy/sync/connection/${connId}/plex-friends`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) throw new Error('Failed to load users');
        const data = await res.json();
        if (!data.friends?.length) {
          list.innerHTML = '<p class="text-xs text-zinc-500 italic">No friends found.</p>';
          return;
        }
        list.innerHTML = data.friends.map((f: any) => `
          <label class="flex items-center gap-3 cursor-pointer group">
            <input type="checkbox" class="plex-user-checkbox w-4 h-4 rounded cursor-pointer"
              data-user-id="${f.watchlist_id}"
              ${monitored.includes(f.watchlist_id) ? 'checked' : ''}
            />
            <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">
              ${f.display_name || f.username}
            </span>
          </label>
        `).join('');
      } catch {
        list.innerHTML = '<p class="text-xs text-red-400 italic">Could not load users.</p>';
      }
    }

    document.querySelectorAll('.plex-user-picker-toggle').forEach((btn) => {
      const connId = btn.getAttribute('data-conn-id');
      const picker = document.querySelector(`.plex-user-picker[data-conn-id="${connId}"]`) as HTMLElement | null;
      const chevron = btn.querySelector('.plex-user-picker-chevron') as HTMLElement | null;
      if (!picker) return;

      btn.addEventListener('click', () => {
        const open = !picker.classList.contains('hidden');
        picker.classList.toggle('hidden', open);
        if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
        if (!open) loadPlexFriends(picker, token);
      });
    });

    // Show/hide the watchlist split sub-option based on the Lists checkbox
    const syncListsCb = document.getElementById('trakt_sync_lists') as HTMLInputElement | null;
    const splitRow = document.getElementById('trakt-watchlist-split-row');
    if (syncListsCb && splitRow) {
      syncListsCb.addEventListener('change', () => {
        splitRow.classList.toggle('hidden', !syncListsCb.checked);
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      saveBtn.disabled = true;
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';

      try {
        const saves = [];
        const appData = document.getElementById('app-data') as HTMLElement;

        // Gather general settings
        const formData = new FormData(form);
        const tmdbApiEl = document.getElementById('tmdb_api_key') as HTMLInputElement | null;
        const tvdbApiEl = document.getElementById('tvdb_api_key') as HTMLInputElement | null;
        const settings = {
          tmdb_api_key: tmdbApiEl ? tmdbApiEl.value.trim() || null : null,
          tvdb_api_key: tvdbApiEl ? tvdbApiEl.value.trim() || null : null,

        };

        // Collect boolean checkboxes (cloud sync preferences + app preferences)
        const syncKeys = [
          'blur_explicit',
          'time_format_24h',
          'show_comments',
          'show_user_ratings',
          'use_hls_player',
          'shuffle_next_up',
          'minimalist_next_up',
        ] as const;
        const syncPrefs: Record<string, boolean> = {};
        for (const key of syncKeys) {
          const el = document.querySelector<HTMLInputElement>(`[name="${key}"]`);
          if (el) syncPrefs[key] = el.checked;
        }

        // Sync blur_explicit to a cookie (read server-side by Base.astro) and apply immediately
        const blurEl = document.querySelector<HTMLInputElement>('[name="blur_explicit"]');
        if (blurEl) {
          const val = blurEl.checked ? 'true' : 'false';
          document.cookie = `blur_explicit=${val}; path=/; SameSite=Lax; Max-Age=31536000`;
          document.documentElement.classList.toggle('blur-explicit', blurEl.checked);
        }
        const commentsEl = document.querySelector<HTMLInputElement>('[name="show_comments"]');
        if (commentsEl) {
          const val = commentsEl.checked ? 'true' : 'false';
          document.cookie = `show_comments=${val}; path=/; SameSite=Lax; Max-Age=31536000`;
          document.documentElement.classList.toggle('show-comments', commentsEl.checked);
        }
        const ratingsEl = document.querySelector<HTMLInputElement>('[name="show_user_ratings"]');
        if (ratingsEl) {
          const val = ratingsEl.checked ? 'true' : 'false';
          document.cookie = `show_user_ratings=${val}; path=/; SameSite=Lax; Max-Age=31536000`;
          document.documentElement.classList.toggle('show-user-ratings', ratingsEl.checked);
        }

        // Gather visibility filters
        const visibilityFilters: Record<string, string> = {};
        document.querySelectorAll('[data-v-group]').forEach(group => {
          const key = group.getAttribute('data-v-group')!;
          const input = group.querySelector(`input[name="v_${key}"]`) as HTMLInputElement;
          visibilityFilters[key] = input.value;
        });

        const existingPrefs = JSON.parse(appData?.dataset?.preferences || '{}');
        const specialsEl = document.getElementById('include-specials-toggle') as HTMLInputElement | null;
        const specialsLabelEl = document.getElementById('specials-label-toggle') as HTMLInputElement | null;
        const enrichmentEl = document.getElementById('media-server-enrichment-toggle') as HTMLInputElement | null;
        const primarySourceEl = document.getElementById('primary_metadata_source') as HTMLSelectElement | null;
        const showBioEl = document.getElementById('show-bio-toggle') as HTMLInputElement | null;
        const unifiedFiltersEl = document.querySelector<HTMLInputElement>('input[name="unified_filters"]:checked');
        const updatedPreferences = {
          ...existingPrefs,
          explore_filters: visibilityFilters,
          unified_filters: unifiedFiltersEl ? unifiedFiltersEl.value === 'true' : (existingPrefs.unified_filters !== false),
          include_specials: specialsEl ? specialsEl.checked : (existingPrefs.include_specials ?? false),
          specials_label: specialsLabelEl ? specialsLabelEl.checked : (existingPrefs.specials_label ?? false),
          media_server_enrichment: enrichmentEl ? enrichmentEl.checked : (existingPrefs.media_server_enrichment ?? true),
          primary_metadata_source: primarySourceEl ? primarySourceEl.value : (existingPrefs.primary_metadata_source ?? 'tmdb'),
          show_bio: showBioEl ? showBioEl.checked : (existingPrefs.show_bio ?? true)
        };

        if (appData) {
          appData.dataset.preferences = JSON.stringify(updatedPreferences);
        }

        if (showBioEl) {
          document.cookie = `show_bio=${showBioEl.checked ? 'true' : 'false'}; path=/; SameSite=Lax; Max-Age=31536000`;
        }

        if (primarySourceEl) {
          document.cookie = `primary_metadata_source=${primarySourceEl.value}; path=/; SameSite=Lax; Max-Age=31536000`;
        }

        if (specialsLabelEl) {
          document.cookie = `specials_label=${specialsLabelEl.checked ? 'true' : 'false'}; path=/; SameSite=Lax; Max-Age=31536000`;
        }

        const timeFormatEl = document.querySelector<HTMLInputElement>('[name="time_format_24h"]');
        if (timeFormatEl) {
          document.cookie = `time_format_24h=${timeFormatEl.checked ? 'true' : 'false'}; path=/; SameSite=Lax; Max-Age=31536000`;
        }

        const defaultOrderEl = document.getElementById('default_episode_order') as HTMLSelectElement | null;
        const default_episode_order = defaultOrderEl ? defaultOrderEl.value : 'tmdb';

        // Save auth settings
        saves.push(fetch(`/api/proxy/auth/settings`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...settings, ...syncPrefs, default_episode_order, preferences: updatedPreferences }),
        }));

        const usernameInput = document.getElementById('username') as HTMLInputElement | null;
        const newUsername = usernameInput?.value.trim() || '';
        if (usernameInput && newUsername && newUsername !== usernameInput.defaultValue) {
          saves.push(fetch('/api/proxy/auth/change-username', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: newUsername }),
          }));
        }

        // Save profile preferences
        saves.push(fetch('/api/proxy/profile/me', {
          method: 'PATCH',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            display_name: formData.get('display_name')?.toString().trim() || null,
            bio: formData.get('bio')?.toString().trim() || null,
            country: formData.get('country') || null,
            content_language: formData.get('content_language') || null,
            privacy_level: (document.querySelector('input[name="privacy_level"]:checked') as HTMLInputElement | null)?.value || 'private',
            pagination_type: (document.querySelector('input[name="pagination_type"]:checked') as HTMLInputElement | null)?.value || 'infinite_scroll',
            streaming_services: Array.from(selectedStreaming),
            liked_genres: Array.from(selectedLikedGenres),
            disliked_genres: Array.from(selectedDislikedGenres),
          }),
        }));

        const results = await Promise.all(saves);
        const failed = results.find(r => !r.ok);
        
        if (failed) {
          const data = await failed.json();
          throw new Error(data.detail || 'Failed to update settings');
        }

        if (usernameInput && newUsername) usernameInput.defaultValue = newUsername;

        showMessage('Settings updated successfully!');
      } catch (e: any) {
        showMessage(e.message, 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  }

  function setupPasswordForm() {
    const form = document.getElementById('password-form');
    const updateBtn = document.getElementById('update-password-btn');
    if (!form || !updateBtn) return;

    updateBtn.addEventListener('click', async (e) => {
      e.preventDefault();

      const current_password_el = document.getElementById('current_password') as HTMLInputElement | null;
      const new_password_el = document.getElementById('new_password') as HTMLInputElement | null;
      const confirm_password_el = document.getElementById('confirm_password') as HTMLInputElement | null;

      const current_password = current_password_el ? current_password_el.value : null;
      const new_password = new_password_el ? new_password_el.value : '';
      const confirm_password = confirm_password_el ? confirm_password_el.value : '';

      if ((current_password_el && !current_password) || !new_password || !confirm_password) {
        showMessage('Fill in all password fields', 'error');
        return;
      }
      if (new_password !== confirm_password) {
        showMessage('New passwords do not match', 'error');
        return;
      }

      updateBtn.disabled = true;
      const originalText = updateBtn.textContent;
      updateBtn.textContent = 'Updating...';

      try {
        const res = await fetch(`/api/proxy/auth/change-password`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_password, new_password }),
        });

        if (res.ok) {
          showMessage('Password updated successfully!');
          if (current_password_el) current_password_el.value = '';
          if (new_password_el) new_password_el.value = '';
          if (confirm_password_el) confirm_password_el.value = '';
        } else {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to update password');
        }
      } catch (e: any) {
        showMessage(e.message, 'error');
      } finally {
        updateBtn.disabled = false;
        updateBtn.textContent = originalText;
      }
    });
  }

