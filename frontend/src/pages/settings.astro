  const CHECK_ICON = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;

  async function copyToClipboard(text: string): Promise<void> {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Fallback for HTTP (non-secure context) — works in all browsers
    const el = document.createElement('textarea');
    el.value = text;
    el.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
    document.body.appendChild(el);
    el.focus();
    el.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(el);
    if (!ok) throw new Error('execCommand copy failed');
  }

  function flashCopied(btn: HTMLElement): void {
    btn.innerHTML = CHECK_ICON;
    btn.classList.add('bg-green-900', 'border-green-700', 'text-green-400');
    btn.classList.remove('bg-zinc-800', 'hover:bg-zinc-700', 'border-zinc-700', 'text-zinc-300');
    setTimeout(() => {
      btn.innerHTML = COPY_ICON;
      btn.classList.remove('bg-green-900', 'border-green-700', 'text-green-400');
      btn.classList.add('bg-zinc-800', 'hover:bg-zinc-700', 'border-zinc-700', 'text-zinc-300');
    }, 2000);
  }

  function setupApiKey() {
    const copyBtn = document.getElementById('copy-api-key-btn');
    const regenBtn = document.getElementById('regenerate-api-key-btn');
    const keyInput = document.getElementById('scrob_api_key');

    if (copyBtn && keyInput) {
      copyBtn.addEventListener('click', async () => {
        try {
          await copyToClipboard((keyInput as HTMLInputElement).value);
          flashCopied(copyBtn as HTMLElement);
        } catch {
          showMessage('Could not copy to clipboard', 'error');
        }
      });
    }

    if (regenBtn && keyInput) {
      regenBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to regenerate your API key? The old key will stop working immediately.')) return;

        regenBtn.disabled = true;
        const originalText = regenBtn.textContent;
        regenBtn.textContent = 'Regenerating...';

        try {
          const res = await fetch(`/api/proxy/auth/api-key/regenerate`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` },
          });
          if (!res.ok) {
            const data = await res.json();
            throw new Error(data.detail || 'Failed to regenerate key');
          }
          const data = await res.json();
          keyInput.value = data.api_key;
          showMessage('API key regenerated successfully!');
        } catch (e) {
          showMessage(e.message, 'error');
        } finally {
          regenBtn.disabled = false;
          regenBtn.textContent = originalText;
        }
      });
    }
  }

  interface ExportSelection {
    watched: boolean;
    ratings: boolean;
    collection: boolean;
    lists: boolean;
    comments: boolean;
    api_keys: boolean;
    media_connections: boolean;
    scrobble_connections: boolean;
    connections: boolean;
  }

  function showExportDataModal(): Promise<ExportSelection | null> {
    return new Promise(resolve => {
      const modal = document.getElementById('export-data-modal');
      const confirmBtn = document.getElementById('export-data-modal-confirm') as HTMLButtonElement | null;
      const cancelBtn = document.getElementById('export-data-modal-cancel') as HTMLButtonElement | null;
      const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.export-option'));
      if (!modal || !confirmBtn || !cancelBtn || options.length === 0) { resolve(null); return; }

      // Secret-bearing options start unselected; everything else is preselected.
      const selected = new Set(
        options.filter(o => o.getAttribute('data-secret') !== 'true').map(o => o.getAttribute('data-export-option')!)
      );

      const syncOptionUI = () => {
        options.forEach(opt => {
          const isOn = selected.has(opt.getAttribute('data-export-option')!);
          const isSecret = opt.getAttribute('data-secret') === 'true';
          opt.querySelector('.check-icon')?.classList.toggle('invisible', !isOn);
          opt.classList.toggle(isSecret ? 'border-amber-500' : 'border-blue-500', isOn);
          opt.classList.toggle('border-transparent', !isOn);
        });
        confirmBtn.disabled = selected.size === 0;
      };
      syncOptionUI();

      const optionHandlers = options.map(opt => {
        const handler = () => {
          const name = opt.getAttribute('data-export-option')!;
          if (selected.has(name)) selected.delete(name); else selected.add(name);
          syncOptionUI();
        };
        opt.addEventListener('click', handler);
        return { opt, handler };
      });

      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const cleanup = (result: ExportSelection | null) => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        confirmBtn.removeEventListener('click', onConfirm);
        cancelBtn.removeEventListener('click', onCancel);
        optionHandlers.forEach(({ opt, handler }) => opt.removeEventListener('click', handler));
        resolve(result);
      };
      const onConfirm = () => cleanup({
        watched: selected.has('watched'),
        ratings: selected.has('ratings'),
        collection: selected.has('collection'),
        lists: selected.has('lists'),
        comments: selected.has('comments'),
        api_keys: selected.has('api_keys'),
        media_connections: selected.has('media_connections'),
        scrobble_connections: selected.has('scrobble_connections'),
        connections: selected.has('connections'),
      });
      const onCancel = () => cleanup(null);
      confirmBtn.addEventListener('click', onConfirm, { once: true });
      cancelBtn.addEventListener('click', onCancel, { once: true });
    });
  }

  function setupExportData() {
    const btn = document.getElementById('export-data-btn') as HTMLButtonElement | null;
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const selection = await showExportDataModal();
      if (!selection) return;

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Preparing…';

      try {
        const params = new URLSearchParams(
          Object.entries(selection).map(([key, value]) => [key, String(value)])
        );
        const res = await fetch(`/api/proxy/export/data?${params}`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Export failed');
        }
        const cd = res.headers.get('Content-Disposition');
        const filename = cd?.match(/filename="([^"]+)"/)?.[1] ?? 'scrob-export.zip';
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
        showMessage('Export downloaded successfully!');
      } catch (e) {
        showMessage(e instanceof Error ? e.message : 'Export failed', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText ?? 'Download';
      }
    });
  }

  function setupHealButton() {
    const btn = document.getElementById('heal-btn');
    const modal = document.getElementById('heal-modal');
    const cancelBtn = document.getElementById('cancel-heal');
    const confirmBtn = document.getElementById('confirm-heal');
    if (!btn || !modal || !cancelBtn || !confirmBtn) return;

    btn.addEventListener('click', () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    cancelBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    confirmBtn.addEventListener('click', async () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Healing...';
      try {
        const res = await fetch('/api/proxy/sync/heal', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (res.ok) {
          startHealPoller();
        } else {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to start heal');
        }
      } catch (e) {
        showMessage(e.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  }

