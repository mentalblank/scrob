                  Scan the QR code with your authenticator app (Google Authenticator, Authy, etc.), then enter the 6-digit code to confirm.
                </div>

                <div class="flex flex-col md:flex-row gap-6 items-start">
                  <div class="shrink-0">
                    <canvas id="totp-qr-canvas" class="rounded-xl bg-white p-2" width="160" height="160"></canvas>
                  </div>
                  <div class="space-y-3 flex-1">
                    <div>
                      <p class="text-xs text-zinc-500 mb-1">Manual entry key</p>
                      <code id="totp-secret-display" class="block bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-300 font-mono text-sm tracking-widest break-all select-all"></code>
                    </div>
                    <div class="space-y-2">
                      <label for="totp-verify-code" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">Verification Code</label>
                      <input
                        type="text"
                        id="totp-verify-code"
                        autocomplete="one-time-code"
                        inputmode="numeric"
                        maxlength="6"
                        placeholder="000000"
                        class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                      />
                    </div>
                    <div class="flex gap-3">
                      <button
                        type="button"
                        id="confirm-enable-2fa-btn"
                        class="px-5 py-2 bg-zinc-100 text-zinc-950 font-bold rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer text-sm disabled:opacity-50"
                      >
                        Verify &amp; Enable
                      </button>
                      <button
                        type="button"
                        id="cancel-2fa-setup-btn"
                        class="px-5 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-xl text-sm transition-colors cursor-pointer"
                      >
                        Cancel
                      </button>
                    </div>
                    <p id="2fa-setup-error" class="hidden text-sm text-red-400"></p>
                  </div>
                </div>
              </div>

              <!-- Backup codes shown after successful enable (hidden initially) -->
              <div id="2fa-new-codes-panel" class="hidden border border-green-500/30 bg-green-500/5 rounded-2xl p-6 space-y-4">
                <div class="flex items-center gap-2 text-green-400 font-semibold">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  2FA Enabled
                </div>
                <p class="text-sm text-zinc-400">Save these backup codes somewhere safe. Each can only be used once. They cannot be shown again — regenerate them in settings if needed.</p>
                <div id="2fa-new-codes-grid" class="grid grid-cols-2 gap-2"></div>
                <button
                  type="button"
                  id="2fa-new-codes-done-btn"
                  class="px-5 py-2 bg-zinc-100 text-zinc-950 font-bold rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer text-sm"
                >
                  Done — reload page
                </button>
              </div>
            </div>
          ) : (
            <div class="space-y-4">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-green-500 shrink-0"></span>
                  <div>
                    <h3 class="font-semibold text-zinc-100">2FA is enabled</h3>
                    <p class="text-sm text-zinc-400">Your account is protected with an authenticator app.</p>
                  </div>
                </div>
                <button
                  type="button"
                  id="disable-2fa-btn"
                  class="shrink-0 px-5 py-2 bg-red-600/10 hover:bg-red-600/20 text-red-400 border border-red-500/30 font-bold rounded-xl text-sm transition-colors cursor-pointer"
                >
                  Disable 2FA
                </button>
              </div>

              <!-- Disable confirmation (hidden initially) -->
              <div id="2fa-disable-panel" class="hidden border border-zinc-800 rounded-2xl p-6 space-y-4 bg-zinc-950/40">
                <p class="text-sm text-zinc-400">Enter your authenticator code or a backup code to disable 2FA.</p>
                <div class="flex gap-3 items-end">
                  <div class="space-y-2 flex-1">
                    <label for="totp-disable-code" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">Code</label>
                    <input
                      type="text"
                      id="totp-disable-code"
                      autocomplete="one-time-code"
                      placeholder="000000 or XXXX-XXXX"
                      class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl px-4 py-3 text-zinc-100 font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                    />
                  </div>
                  <button
                    type="button"
                    id="confirm-disable-2fa-btn"
                    class="px-5 py-2 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl text-sm transition-colors cursor-pointer disabled:opacity-50"
                  >
                    Confirm
                  </button>
                  <button
                    type="button"
                    id="cancel-disable-2fa-btn"
                    class="px-5 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-xl text-sm transition-colors cursor-pointer"
                  >
                    Cancel
                  </button>
                </div>
                <p id="2fa-disable-error" class="hidden text-sm text-red-400"></p>
              </div>

              <!-- Backup codes -->
              <details class="group border border-zinc-800 rounded-2xl bg-zinc-950/20 overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none select-none hover:bg-zinc-950/40 transition-colors">
                  <span class="font-medium text-zinc-300">Backup Codes</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-500 transition-transform group-open:rotate-180">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </summary>
                <div class="px-6 pb-6 space-y-4">
                  <p class="text-sm text-zinc-500">Used codes are shown with strikethrough and cannot be reused. Keep these somewhere safe.</p>
