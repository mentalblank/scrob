                    <span class="w-5 h-5 rounded-full shrink-0" style={`background-color: ${color}`}></span>
                    {label}
                  </button>
                ))}
              </div>
            </div>

            <!-- Pagination Style -->
            <div class="space-y-4 pt-2">
              <label class="block text-xs font-bold text-zinc-400 uppercase tracking-widest">Pagination Style</label>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class={`relative flex flex-col p-4 rounded-xl border cursor-pointer transition-all hover:bg-zinc-900/50 group ${prefs.pagination_type === 'infinite_scroll' ? 'bg-blue-500/5 border-blue-500/50' : 'bg-zinc-950/40 border-zinc-800'}`}>
                  <div class="flex items-center justify-between mb-1">
                    <span class={`font-semibold ${prefs.pagination_type === 'infinite_scroll' ? 'text-blue-400' : 'text-zinc-100 group-hover:text-zinc-200'}`}>Infinite Scroll</span>
                    <input
                      type="radio"
                      name="pagination_type"
                      value="infinite_scroll"
                      checked={prefs.pagination_type === 'infinite_scroll'}
                      class="w-4 h-4 text-blue-500 bg-zinc-800 border-zinc-700 focus:ring-blue-500 focus:ring-offset-zinc-900"
                    />
                  </div>
                  <span class="text-xs text-zinc-500 leading-relaxed">Automatically load more items as you scroll down.</span>
                </label>

                <label class={`relative flex flex-col p-4 rounded-xl border cursor-pointer transition-all hover:bg-zinc-900/50 group ${prefs.pagination_type === 'pagination' ? 'bg-blue-500/5 border-blue-500/50' : 'bg-zinc-950/40 border-zinc-800'}`}>
                  <div class="flex items-center justify-between mb-1">
                    <span class={`font-semibold ${prefs.pagination_type === 'pagination' ? 'text-blue-400' : 'text-zinc-100 group-hover:text-zinc-200'}`}>Classic Pagination</span>
                    <input
                      type="radio"
                      name="pagination_type"
                      value="pagination"
                      checked={prefs.pagination_type === 'pagination'}
                      class="w-4 h-4 text-blue-500 bg-zinc-800 border-zinc-700 focus:ring-blue-500 focus:ring-offset-zinc-900"
                    />
                  </div>
                  <span class="text-xs text-zinc-500 leading-relaxed">Traditional page numbers for deliberate navigation.</span>
                </label>
              </div>
            </div>

            <!-- Visibility Filters Behavior -->
            <div class="space-y-4 pt-2">
              <label class="block text-xs font-bold text-zinc-400 uppercase tracking-widest">Visibility Filters Behavior</label>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class={`relative flex flex-col p-4 rounded-xl border cursor-pointer transition-all hover:bg-zinc-900/50 group ${prefs.unified_filters !== false ? 'bg-blue-500/5 border-blue-500/50' : 'bg-zinc-950/40 border-zinc-800'}`}>
                  <div class="flex items-center justify-between mb-1">
                    <span class={`font-semibold ${prefs.unified_filters !== false ? 'text-blue-400' : 'text-zinc-100 group-hover:text-zinc-200'}`}>Unified Filters</span>
                    <input
                      type="radio"
                      name="unified_filters"
                      value="true"
                      checked={prefs.unified_filters !== false}
                      class="w-4 h-4 text-blue-500 bg-zinc-800 border-zinc-700 focus:ring-blue-500 focus:ring-offset-zinc-900"
                    />
                  </div>
                  <span class="text-xs text-zinc-500 leading-relaxed">Apply the same visibility filters across all pages.</span>
                </label>

                <label class={`relative flex flex-col p-4 rounded-xl border cursor-pointer transition-all hover:bg-zinc-900/50 group ${prefs.unified_filters === false ? 'bg-blue-500/5 border-blue-500/50' : 'bg-zinc-950/40 border-zinc-800'}`}>
                  <div class="flex items-center justify-between mb-1">
                    <span class={`font-semibold ${prefs.unified_filters === false ? 'text-blue-400' : 'text-zinc-100 group-hover:text-zinc-200'}`}>Independent per Page</span>
                    <input
                      type="radio"
                      name="unified_filters"
                      value="false"
                      checked={prefs.unified_filters === false}
                      class="w-4 h-4 text-blue-500 bg-zinc-800 border-zinc-700 focus:ring-blue-500 focus:ring-offset-zinc-900"
                    />
                  </div>
                  <span class="text-xs text-zinc-500 leading-relaxed">Each page (Explore, Trending, Lists, etc.) remembers its own filters.</span>
                </label>
              </div>
            </div>

            <!-- Playback Behavior -->
            <div class="space-y-4 pt-2">
              <label class="block text-xs font-bold text-zinc-400 uppercase tracking-widest">Playback</label>
              <p class="text-xs text-zinc-500 -mt-2">What happens when you press Play on an item. Applies to all media server connections.</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {PLAYBACK_TARGETS.map(([value, label, desc]) => (
                  <label class={`relative flex flex-col p-4 rounded-xl border cursor-pointer transition-all hover:bg-zinc-900/50 group ${playbackTarget === value ? 'bg-blue-500/5 border-blue-500/50' : 'bg-zinc-950/40 border-zinc-800'}`}>
                    <div class="flex items-center justify-between mb-1">
                      <span class={`font-semibold ${playbackTarget === value ? 'text-blue-400' : 'text-zinc-100 group-hover:text-zinc-200'}`}>{label}</span>
                      <input
                        type="radio"
                        name="playback_target"
                        value={value}
                        checked={playbackTarget === value}
                        class="w-4 h-4 text-blue-500 bg-zinc-800 border-zinc-700 focus:ring-blue-500 focus:ring-offset-zinc-900"
                      />
                    </div>
                    <span class="text-xs text-zinc-500 leading-relaxed">{desc}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- UI Feature Toggles -->
            <div class="space-y-4 pt-2">
              <label class="block text-xs font-bold text-zinc-400 uppercase tracking-widest">Interface Options</label>
              <div class="space-y-4">
                {[
                  { id: 'blur-explicit-toggle', name: 'blur_explicit', label: 'Blur explicit content', desc: 'Blur posters flagged as adult content by TMDB. Click a blurred poster to reveal it.', checked: settings.blur_explicit !== false },
                  { id: 'time-format-24h-toggle', name: 'time_format_24h', label: '24-hour time format', desc: 'Display watch times in 24-hour format (e.g. 23:31) instead of 12-hour (e.g. 11:31 PM).', checked: settings.time_format_24h !== false },
                  { id: 'show-comments-toggle', name: 'show_comments', label: 'Show comments', desc: 'Show user comments on media detail pages site-wide.', checked: settings.show_comments !== false },
                  { id: 'show-user-ratings-toggle', name: 'show_user_ratings', label: 'Show user ratings', desc: 'Show ratings from users of this app. TMDB ratings will still be visible.', checked: settings.show_user_ratings !== false },
                  { id: 'show-bio-toggle', name: 'show_bio', label: 'Show bios / about', desc: 'Show user bios and about sections on profile pages site-wide.', checked: settings.preferences?.show_bio !== false },
                  { id: 'media-server-enrichment-toggle', name: 'media_server_enrichment', label: 'Media server enrichment', desc: 'Fetch metadata (resolution, languages) from media servers (Plex, Jellyfin, Emby) during sync. If disabled, only TMDB metadata will be used.', checked: settings.preferences?.media_server_enrichment !== false },
                  { id: 'include-specials-toggle', name: 'include_specials', label: 'Include specials in counts', desc: 'Include Specials (Season 0) when calculating show and season watch/collection progress.', checked: settings.preferences?.include_specials === true },
                  { id: 'specials-label-toggle', name: 'specials_label', label: 'Label Season 0 as Specials', desc: 'Show Season 0 as "Specials", and its episodes as SP01 rather than S00E01.', checked: settings.preferences?.specials_label === true },
                  { id: 'shuffle-next-up-toggle', name: 'shuffle_next_up', label: 'Shuffle Next Up', desc: 'Randomise the order of the Next Up row. When off, shows are ordered by most recently watched.', checked: settings.shuffle_next_up === true },
                  { id: 'minimalist-next-up-toggle', name: 'minimalist_next_up', label: 'Minimalist Next Up', desc: 'Show Next Up as a plain row of episode cards, without the large hero banner.', checked: settings.minimalist_next_up === true },
                  { id: 'use-hls-player-toggle', name: 'use_hls_player', label: 'HLS player (Experimental)', desc: 'Use the HLS-based player for Plex and Jellyfin/Emby sources. Enables transcoding if your browser doesn\'t natively support the file\'s codecs. Disable this if playback is broken.', checked: settings.use_hls_player === true },
                ].map(({ id, name, label, desc, checked }) => (
                  <div class="flex items-start justify-between gap-6 p-4 bg-zinc-950/40 rounded-2xl border border-zinc-800">
                    <div>
                      <p class="text-sm font-semibold text-zinc-100 mb-1">{label}</p>
                      <p class="text-xs text-zinc-400">{desc}</p>
                    </div>
                    <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
                      <input
                        type="checkbox"
                        name={name}
                        id={id}
                        class="sr-only peer"
                        checked={checked}
                      />
                      <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
                    </label>
                  </div>
                ))}
              </div>
            </div>
          </section>
        </div>

      <!-- Tab Panel: Security & API Keys -->
      <div data-settings-tab="security" class="space-y-12 hidden">
        <!-- Change Password -->
        <section class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">Change Password</h2>
          </div>
          <div id="password-form" class="space-y-6 max-w-md">
            <div class="space-y-4">
              {me.has_password && <div class="space-y-2">
                <label for="current_password" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">Current Password</label>
                <div class="relative group/field">
                  <input
                    type="password"
                    name="current_password"
                    id="current_password"
                    class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                  <PasswordToggle />
                </div>
              </div>}
              <div class="space-y-2">
                <label for="new_password" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">New Password</label>
                <div class="relative group/field">
                  <input
                    type="password"
                    name="new_password"
                    id="new_password"
                    class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                  <PasswordToggle />
                </div>
              </div>
              <div class="space-y-2">
                <label for="confirm_password" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">Confirm New Password</label>
                <div class="relative group/field">
                  <input
                    type="password"
                    name="confirm_password"
                    id="confirm_password"
                    class="w-full bg-zinc-950/60 border border-zinc-800 focus:border-zinc-700 rounded-xl pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                  <PasswordToggle />
                </div>
              </div>
            </div>
            <div class="pt-2">
              <button
                id="update-password-btn"
                type="button"
                class="bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold px-8 py-2 rounded-xl transition-colors cursor-pointer border border-zinc-700 disabled:opacity-50"
              >
                Update Password
              </button>
            </div>
          </div>
        </section>

        <!-- Plex Account -->
        <section class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">Plex Account</h2>
          </div>
          <div class="flex items-center justify-between gap-4 flex-wrap">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#e5a00d]/15 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#e5a00d" class="w-5 h-5">
                  <path d="M12 0L4 6v12l8 6 8-6V6l-8-6zm0 4.3l4.8 3.6v8.2L12 19.7l-4.8-3.6V7.9L12 4.3z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-zinc-100">{me.plex_linked ? "Plex connected" : "Connect your Plex account"}</h3>
                <p class="text-sm text-zinc-400">
                  {me.plex_linked
                    ? <>Signed-in via Plex {me.plex_username ? <span class="text-zinc-300">as {me.plex_username}</span> : null}. Use “Find servers” to import your Plex servers.</>
                    : "Link Plex to sign in with one click and import your servers."}
                </p>
              </div>
            </div>
            {me.plex_linked ? (
              <div class="flex items-center gap-2">
                <a
                  href="/plex-link-start"
                  class="bg-[#e5a00d] hover:bg-[#cc8f0b] text-zinc-950 font-bold px-5 py-2 rounded-xl transition-colors cursor-pointer"
                >
                  Find servers
                </a>
                <button
                  id="plex-unlink-btn"
                  type="button"
                  class="bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold px-6 py-2 rounded-xl transition-colors cursor-pointer border border-zinc-700 disabled:opacity-50"
                >
                  Unlink
                </button>
              </div>
            ) : (
              <a
                href="/plex-link-start"
                class="bg-[#e5a00d] hover:bg-[#cc8f0b] text-zinc-950 font-bold px-6 py-2 rounded-xl transition-colors cursor-pointer"
              >
                Connect Plex
              </a>
            )}
          </div>
          {me.plex_linked && !me.has_password && (
            <p class="text-xs text-amber-400/80">Set a password above before unlinking, or you'll be locked out of this account.</p>
          )}
        </section>

        <!-- Two-Factor Authentication -->
        <section id="2fa-section" class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl backdrop-blur-xl shadow-xl p-6 md:p-8 space-y-6">
          <div class="mb-4 border-b border-zinc-800 pb-2">
            <h2 class="section-headline">Two-Factor Authentication</h2>
          </div>

          {!me.totp_enabled ? (
            <div class="space-y-4">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-zinc-950/40 border border-zinc-800 rounded-2xl p-6">
                <div>
                  <h3 class="font-semibold text-zinc-100 mb-1">Authenticator App</h3>
                  <p class="text-sm text-zinc-400">Protect your account with a time-based one-time password (TOTP) from any authenticator app.</p>
                </div>
                <button
                  type="button"
                  id="enable-2fa-btn"
                  class="w-full sm:w-auto sm:shrink-0 px-6 py-3 bg-zinc-100 text-zinc-950 font-bold rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer text-sm"
                >
                  Enable 2FA
                </button>
              </div>

              <!-- Setup panel (hidden until "Enable 2FA" is clicked) -->
              <div id="2fa-setup-panel" class="hidden border border-zinc-800 rounded-2xl p-6 space-y-5 bg-zinc-950/40">
