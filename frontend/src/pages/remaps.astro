        const payloadStr = button.getAttribute("data-payload");
        if (!payloadStr) return;
        const item = JSON.parse(payloadStr);

        if (!confirm(`Are you sure you want to remove the custom title for ${item.context}? It will revert to '${item.original_title}'.`)) return;

        const body: any = {};
        if (item.type === 'show') {
          body.show_uri_id = item.show_uri_id;
          body.custom_title = null;
        } else if (item.type === 'season') {
          body.show_uri_id = item.show_uri_id;
          body.season_number = item.season_number;
          body.season_custom_name = null;
        } else if (item.type === 'episode') {
          body.media_id = item.media_id;
          body.custom_title = null;
        } else if (item.type === 'movie') {
          body.media_id = item.media_id;
          body.custom_title = null;
        }

        try {
          const res = await fetch('/api/proxy/sync/custom-title', {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(body)
          });
          
          if (res.ok) {
            window.showToast?.("Custom title removed successfully", "success");
            setTimeout(() => window.location.reload(), 600);
          } else {
            window.showToast?.("Failed to remove custom title", "error");
          }
        } catch (e) {
          window.showToast?.("Error removing custom title", "error");
        }
      });
    });

    // Episode Remap Modal Logic
    const epModal = document.getElementById("ep-remap-modal")!;
    const addEpRemapBtn = document.getElementById("add-ep-remap-btn")!;
    const closeEpModalBtn = document.getElementById("close-ep-modal-btn")!;
    const cancelEpModalBtn = document.getElementById("cancel-ep-modal-btn")!;
    const saveEpRemapBtn = document.getElementById("save-ep-remap-btn") as HTMLButtonElement;

    const epSrcTmdbInput = document.getElementById("ep-src-tmdb") as HTMLInputElement;
    const epTgtTmdbInput = document.getElementById("ep-tgt-tmdb") as HTMLInputElement;
    
    const epSrcSeasonInput = document.getElementById("ep-src-season") as HTMLInputElement;
    const epSrcEpisodeStartInput = document.getElementById("ep-src-episode-start") as HTMLInputElement;
    const epSrcEpisodeEndInput = document.getElementById("ep-src-episode-end") as HTMLInputElement;
    const epTgtSeasonInput = document.getElementById("ep-tgt-season") as HTMLInputElement;
    const epTgtEpisodeStartInput = document.getElementById("ep-tgt-episode-start") as HTMLInputElement;

    function openEpModal() {
      epModal.classList.remove("opacity-0", "pointer-events-none");
      epModal.classList.add("opacity-100");
    }

    function closeEpModal() {
      epModal.classList.add("opacity-0", "pointer-events-none");
      epModal.classList.remove("opacity-100");
      
      const epSrcTypeSelect = document.getElementById("ep-src-type") as HTMLSelectElement;
      const epTgtTypeSelect = document.getElementById("ep-tgt-type") as HTMLSelectElement;
      if (epSrcTypeSelect) epSrcTypeSelect.value = "tmdb";
      if (epTgtTypeSelect) epTgtTypeSelect.value = "tmdb";

      // Reset inputs
      epSrcTmdbInput.value = "";
      epTgtTmdbInput.value = "";
      epSrcSeasonInput.value = "";
      epSrcEpisodeStartInput.value = "";
      epSrcEpisodeEndInput.value = "";
      epTgtSeasonInput.value = "";
      epTgtEpisodeStartInput.value = "";
    }

    addEpRemapBtn.addEventListener("click", openEpModal);
    closeEpModalBtn.addEventListener("click", closeEpModal);
    cancelEpModalBtn.addEventListener("click", closeEpModal);
    epModal.addEventListener("click", (e) => {
      if (e.target === epModal) closeEpModal();
    });

    // Auto-fill target TMDB ID when source TMDB ID is typed
    let lastSrcTmdb = "";
    epSrcTmdbInput.addEventListener("input", () => {
      if (epTgtTmdbInput.value === lastSrcTmdb || !epTgtTmdbInput.value) {
        epTgtTmdbInput.value = epSrcTmdbInput.value;
      }
      lastSrcTmdb = epSrcTmdbInput.value;
    });

    // Save Action supporting ranges
    saveEpRemapBtn.addEventListener("click", async () => {
      const srcType = (document.getElementById("ep-src-type") as HTMLSelectElement).value;
      const tgtType = (document.getElementById("ep-tgt-type") as HTMLSelectElement).value;

      const srcRaw = epSrcTmdbInput.value.trim();
      const tgtRaw = epTgtTmdbInput.value.trim();
      const srcUri = srcRaw.includes(":") ? srcRaw : `${srcType}:s:${srcRaw}`;
      const tgtUri = tgtRaw.includes(":") ? tgtRaw : `${tgtType}:s:${tgtRaw}`;

      const srcSeason = parseInt(epSrcSeasonInput.value);
      const srcEpStart = parseInt(epSrcEpisodeStartInput.value);
      const srcEpEndVal = epSrcEpisodeEndInput.value ? parseInt(epSrcEpisodeEndInput.value) : NaN;
      const tgtSeason = parseInt(epTgtSeasonInput.value);
      const tgtEpStart = parseInt(epTgtEpisodeStartInput.value);

      if (!srcRaw || !tgtRaw || isNaN(srcSeason) || isNaN(srcEpStart) || isNaN(tgtSeason) || isNaN(tgtEpStart)) {
        window.showToast?.("Please enter valid IDs, Season, and Episode Start values.", "error");
        return;
      }

      if (!isNaN(srcEpEndVal) && srcEpEndVal < srcEpStart) {
        window.showToast?.("Source Episode End must be greater than or equal to Episode Start.", "error");
        return;
      }

      const count = !isNaN(srcEpEndVal) ? (srcEpEndVal - srcEpStart + 1) : 1;
      saveEpRemapBtn.disabled = true;
      saveEpRemapBtn.textContent = count > 1 ? `Saving (${count} overrides)...` : "Saving...";

      try {
        const savedIds = [];
        // Save sequentially to avoid DB lock issues on large ranges
        for (let i = 0; i < count; i++) {
          const bodyData = {
            source_show_uri_id: srcUri,
            source_season_number: srcSeason,
            source_episode_number: srcEpStart + i,
            target_show_uri_id: tgtUri,
            target_season_number: tgtSeason,
            target_episode_number: tgtEpStart + i
          };
          
          const res = await fetch('/api/proxy/sync/episode-overrides', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(bodyData)
          });
          if (!res.ok) throw new Error(`Failed to save override ${i+1}`);
          const data = await res.json();
          savedIds.push(data.id);
          
          if (count > 1) {
            saveEpRemapBtn.textContent = `Saved ${i + 1}/${count}...`;
          }
        }

        // Apply all overrides
        saveEpRemapBtn.textContent = "Applying Changes...";
        for (let i = 0; i < savedIds.length; i++) {
          const id = savedIds[i];
          if (count > 1) {
            saveEpRemapBtn.textContent = `Applying ${i + 1}/${count}...`;
          }
          const applyRes = await fetch(`/api/proxy/sync/episode-overrides/${id}/apply`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!applyRes.ok) console.warn(`Failed to apply episode override ${id}`);
        }

        window.showToast?.(count > 1 ? `Successfully saved and applied ${count} episode overrides!` : "Successfully applied episode remap!", "success");
        closeEpModal();
        setTimeout(() => window.location.reload(), 800);
      } catch (e: any) {
        window.showToast?.(e.message || "Error communicating with server", "error");
        saveEpRemapBtn.disabled = false;
        saveEpRemapBtn.textContent = "Save Episode Remap";
      }
    });

    // Edit Existing Mappings Logic
    document.querySelectorAll(".edit-ep-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const srcUri = btn.getAttribute("data-src-uri") || "";
        const srcSeason = btn.getAttribute("data-src-season");
        const srcEp = btn.getAttribute("data-src-ep");
        const tgtUri = btn.getAttribute("data-tgt-uri") || "";
        const tgtSeason = btn.getAttribute("data-tgt-season");
        const tgtEp = btn.getAttribute("data-tgt-ep");

        openEpModal();

        const srcTypeSelect = document.getElementById("ep-src-type") as HTMLSelectElement;
        const tgtTypeSelect = document.getElementById("ep-tgt-type") as HTMLSelectElement;

        const srcProvider = srcUri.split(":")[0] || "tmdb";
        if (srcTypeSelect) srcTypeSelect.value = srcProvider;
        epSrcTmdbInput.value = srcUri;

        const tgtProvider = tgtUri.split(":")[0] || "tmdb";
        if (tgtTypeSelect) tgtTypeSelect.value = tgtProvider;
        epTgtTmdbInput.value = tgtUri;

        epSrcSeasonInput.value = srcSeason || "";
        epSrcEpisodeStartInput.value = srcEp || "";
        epSrcEpisodeEndInput.value = "";
        epTgtSeasonInput.value = tgtSeason || "";
        epTgtEpisodeStartInput.value = tgtEp || "";
      });
    });

    // Edit Season Override
    document.querySelectorAll(".edit-season-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const srcUri = btn.getAttribute("data-source-uri") || "";
        const srcSeason = btn.getAttribute("data-source-season") || "";
        const tgtUri = btn.getAttribute("data-target-uri") || "";
        const tgtSeason = btn.getAttribute("data-target-season") || "";

        resetModalState();
        remapModal.classList.remove("opacity-0", "pointer-events-none");

        // Toggle to manual entry mode
        sourceShowSearch.parentElement!.classList.add("hidden");
        sourceShowResults.classList.add("hidden");
        sourceManualToggle.classList.add("hidden");
        sourceManualGroup.classList.remove("hidden");

        const srcProvider = srcUri.split(":")[0] || "tmdb";
        const tgtProvider = tgtUri.split(":")[0] || "tmdb";
        const sourceShowIdType = document.getElementById("source-show-id-type") as HTMLSelectElement;
        const targetShowIdType = document.getElementById("target-show-id-type") as HTMLSelectElement;
        if (sourceShowIdType) sourceShowIdType.value = srcProvider;
        if (targetShowIdType) targetShowIdType.value = tgtProvider;

        sourceShowTmdbInput.value = srcUri;
        sourceSeasonInput.value = srcSeason;
        targetShowTmdbInput.value = tgtUri;
        targetSeasonInput.value = tgtSeason;

        // Trigger lookups
        sourceShowLookupBtn.click();
        targetShowLookupBtn.click();

        validateForm();
      });
    });

    // ── Revert an episode -> movie conversion ─────────────────────────────────
    document.querySelectorAll<HTMLElement>(".revert-conversion-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.conversionId;
        if (!id) return;
        if (!confirm("Put this back as an episode? Its collected status and watch history stay with it.")) return;
        (btn as HTMLButtonElement).disabled = true;
        try {
          const res = await fetch(`/api/proxy/sync/episode-movie-conversions/${id}`, {
            method: "DELETE",
            headers: { "Authorization": `Bearer ${token}` },
          });
          if (!res.ok) throw new Error();
          window.showToast?.("Reverted to episode", "success");
          setTimeout(() => window.location.reload(), 600);
        } catch {
          window.showToast?.("Failed to revert", "error");
          (btn as HTMLButtonElement).disabled = false;
        }
      });
    });

    // ── Dismiss a warning ─────────────────────────────────────────────────────
    // Some rows can't be fixed (a film on one catalogue, missing upstream data).
    // Dismissing hides them without pretending they were resolved.
    document.querySelectorAll<HTMLElement>(".dismiss-warning-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const key = btn.dataset.dismissKey;
        if (!key) return;
        const row = btn.closest("div.flex.items-center") as HTMLElement | null;
        (btn as HTMLButtonElement).disabled = true;
        try {
          const res = await fetch("/api/proxy/sync/warnings/dismiss", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Authorization": `Bearer ${token}` },
            body: JSON.stringify({ key }),
          });
          if (!res.ok) throw new Error("Failed to dismiss");
          const wrapper = btn.closest(".flex.items-center.gap-3") as HTMLElement | null;
          const target = wrapper ?? row;
          if (target) {
            target.style.transition = "all 0.25s ease";
            target.style.opacity = "0";
            setTimeout(() => target.remove(), 250);
          }
          window.showToast?.("Dismissed", "success");
        } catch {
          window.showToast?.("Failed to dismiss", "error");
          (btn as HTMLButtonElement).disabled = false;
        }
      });
    });

    document.getElementById("restore-dismissed-btn")?.addEventListener("click", async () => {
      try {
        const res = await fetch("/api/proxy/sync/warnings/dismiss", {
          method: "DELETE",
          headers: { "Authorization": `Bearer ${token}` },
        });
        if (!res.ok) throw new Error();
        window.showToast?.("Restored dismissed items", "success");
        setTimeout(() => window.location.reload(), 500);
      } catch {
        window.showToast?.("Failed to restore", "error");
      }
    });

    // ── Episode -> movie ──────────────────────────────────────────────────────
    // Some catalogues file films as episodes of a series (TVDB lists the Sally
    // Lockhart films that way; TMDB has them as standalone movies). A season
    // remap can't express that, so convert the row's type instead.
    const epMovieModal = document.getElementById("epmovie-modal")!;
    const epMovieList = document.getElementById("epmovie-list")!;
    const epMovieErr = document.getElementById("epmovie-error")!;

    function closeEpMovieModal() {
      epMovieModal.classList.add("opacity-0", "pointer-events-none");
    }
    document.getElementById("epmovie-close")?.addEventListener("click", closeEpMovieModal);
    document.getElementById("epmovie-done")?.addEventListener("click", () => {
      closeEpMovieModal();
      window.location.reload();
    });

    async function convertEpisode(mediaId: number, tmdbId: number, row: HTMLElement) {
      epMovieErr.classList.add("hidden");
      try {
        const res = await fetch("/api/proxy/sync/match-episode-to-movie", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Authorization": `Bearer ${token}` },
          body: JSON.stringify({ media_id: mediaId, uri_id: `tmdb:m:${tmdbId}` }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.detail || "Conversion failed");
        row.innerHTML = `<div class="flex items-center gap-2 px-3 py-2 text-xs text-green-400">
          <span class="font-bold">✓</span> Converted to movie — ${data.title ?? ""}</div>`;
        window.showToast?.("Converted to movie", "success");
      } catch (e: any) {
        epMovieErr.textContent = e.message ?? "Conversion failed";
        epMovieErr.classList.remove("hidden");
      }
    }

    async function searchMoviesFor(row: HTMLElement, mediaId: number, query: string) {
      const resultsEl = row.querySelector<HTMLElement>("[data-ep-results]")!;
      resultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-1">Searching…</p>';
      try {
        const res = await fetch(`/api/proxy/media/search?q=${encodeURIComponent(query)}&type=movie&page=1`, {
          headers: { "Authorization": `Bearer ${token}` },
        });
        if (!res.ok) throw new Error("Search failed");
        const rows = ((await res.json()).results ?? []).slice(0, 5);
        if (!rows.length) {
          resultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-1">No movies found.</p>';
          return;
        }
        resultsEl.innerHTML = "";
        rows.forEach((r: any) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "w-full flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-zinc-800 cursor-pointer text-left";
          b.innerHTML = `<span class="text-xs text-zinc-200 truncate flex-1">${r.title ?? ""}</span>
            <span class="text-[10px] text-zinc-500 shrink-0">${(r.release_date ?? "").slice(0, 4)} • TMDB ${r.tmdb_id}</span>`;
          b.addEventListener("click", () => convertEpisode(mediaId, r.tmdb_id, row));
          resultsEl.appendChild(b);
        });
      } catch (e: any) {
        resultsEl.innerHTML = `<p class="text-xs text-red-400 py-1">${e.message ?? "Search failed"}</p>`;
      }
    }

    async function loadEpisodesForConversion(showUri: string, season: string | number, includeMatched: boolean) {
      epMovieList.innerHTML = '<p class="text-xs text-zinc-500">Loading…</p>';
      try {
        const res = await fetch(
          `/api/proxy/sync/unmatched-episodes?show_uri_id=${encodeURIComponent(showUri)}`
          + `&season_number=${season}&include_matched=${includeMatched}`,
          { headers: { "Authorization": `Bearer ${token}` } },
        );
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).detail || "Failed to load episodes");
        const eps = (await res.json()).episodes ?? [];
        if (!eps.length) {
          epMovieList.innerHTML = `<p class="text-xs text-zinc-500">No ${includeMatched ? "" : "unmatched "}episodes in this season.</p>`;
          return;
        }
        epMovieList.innerHTML = "";
        eps.forEach((ep: any) => {
          const row = document.createElement("div");
          row.className = "border border-zinc-800 rounded-xl p-3 bg-zinc-950/40";
          row.innerHTML = `
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[10px] font-black text-zinc-500 shrink-0">E${ep.episode_number}</span>
              <span class="text-sm text-zinc-200 truncate flex-1">${ep.title ?? ""}</span>
              ${ep.matched ? '<span class="text-[9px] font-bold text-green-500 shrink-0">matched</span>' : ''}
            </div>
            <div class="flex gap-2">
              <input type="text" data-ep-query class="flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-2.5 py-1.5 text-xs text-zinc-100 focus:outline-none focus:border-indigo-500" />
              <button type="button" data-ep-search class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 text-xs font-medium rounded-lg cursor-pointer shrink-0">Search</button>
            </div>
            <div data-ep-results class="mt-1.5 space-y-0.5"></div>`;
          const input = row.querySelector<HTMLInputElement>("[data-ep-query]")!;
          input.value = ep.title ?? "";
          const go = () => searchMoviesFor(row, ep.media_id, input.value.trim());
          row.querySelector("[data-ep-search]")!.addEventListener("click", go);
          input.addEventListener("keydown", e => {
            if ((e as KeyboardEvent).key === "Enter") { e.preventDefault(); go(); }
          });
          epMovieList.appendChild(row);
        });
      } catch (e: any) {
        epMovieList.innerHTML = "";
        epMovieErr.textContent = e.message ?? "Failed to load episodes";
        epMovieErr.classList.remove("hidden");
      }
    }

    document.querySelectorAll<HTMLElement>(".ep-to-movie-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        (document.getElementById("epmovie-picker") as HTMLElement).classList.add("hidden");
        (document.getElementById("epmovie-source") as HTMLElement).textContent =
          `${btn.dataset.show ?? ""} — Season ${btn.dataset.season}`;
        epMovieErr.classList.add("hidden");
        epMovieModal.classList.remove("opacity-0", "pointer-events-none");
        await loadEpisodesForConversion(btn.dataset.showUri!, btn.dataset.season!, false);
      });
    });

    // ── Add a movie match from scratch ────────────────────────────────────────
    // The per-season button only appears on unmatched rows, so once everything is
    // matched there was no way in. This entry point works from any show/season.
    const epMoviePicker = document.getElementById("epmovie-picker")!;
    const epMovieShowSearch = document.getElementById("epmovie-show-search") as HTMLInputElement;
    const epMovieShowResults = document.getElementById("epmovie-show-results")!;
    const epMovieShowSelected = document.getElementById("epmovie-show-selected")!;
    const epMovieSeasonGroup = document.getElementById("epmovie-season-group")!;
    const epMovieSeasonButtons = document.getElementById("epmovie-season-buttons")!;
    let epMovieShow: any = null;

    function resetEpMoviePicker() {
      epMovieShow = null;
      epMovieShowSearch.value = "";
      epMovieShowResults.innerHTML = "";
      epMovieShowResults.classList.add("hidden");
      epMovieShowSelected.classList.add("hidden");
      epMovieShowSearch.parentElement!.classList.remove("hidden");
      epMovieSeasonGroup.classList.add("hidden");
      epMovieSeasonButtons.innerHTML = "";
      epMovieList.innerHTML = "";
      epMovieErr.classList.add("hidden");
    }

    function renderEpMovieShowResults(rows: any[]) {
      epMovieShowResults.innerHTML = "";
      if (!rows.length) {
        epMovieShowResults.innerHTML = '<p class="text-xs text-zinc-500 py-1">No matching shows.</p>';
        epMovieShowResults.classList.remove("hidden");
        return;
      }
      rows.slice(0, 8).forEach(show => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "w-full flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-zinc-800 cursor-pointer text-left";
        b.innerHTML = `<span class="text-xs text-zinc-200 truncate flex-1">${show.title}</span>
          <span class="text-[10px] text-zinc-500 shrink-0">${idLabelFor(show)}</span>`;
        b.addEventListener("click", () => selectEpMovieShow(show));
        epMovieShowResults.appendChild(b);
      });
      epMovieShowResults.classList.remove("hidden");
    }

    async function selectEpMovieShow(show: any) {
      epMovieShow = show;
      (document.getElementById("epmovie-show-title") as HTMLElement).textContent = show.title;
      epMovieShowSearch.parentElement!.classList.add("hidden");
      epMovieShowResults.classList.add("hidden");
      epMovieShowSelected.classList.remove("hidden");
      epMovieSeasonGroup.classList.remove("hidden");
      epMovieSeasonButtons.innerHTML = "";
      const seasons = await seasonsFor(show, show.tvdb_id && !show.tmdb_id ? "tvdb" : primarySource);
      if (!seasons.length) {
        epMovieSeasonButtons.innerHTML = '<span class="text-xs text-zinc-500">No seasons found.</span>';
        return;
      }
      seasons.forEach((sea: any) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "px-3 py-1.5 border border-zinc-800 bg-zinc-900/40 text-zinc-300 font-bold text-xs rounded-xl cursor-pointer transition";
        b.textContent = sea.season_number === 0 ? "Specials" : `Season ${sea.season_number}`;
        b.addEventListener("click", async () => {
          epMovieSeasonButtons.querySelectorAll("button").forEach(x => {
            x.className = "px-3 py-1.5 border border-zinc-800 bg-zinc-900/40 text-zinc-300 font-bold text-xs rounded-xl cursor-pointer transition";
          });
          b.className = "px-3 py-1.5 border border-indigo-500/40 bg-indigo-600/10 text-indigo-300 font-bold text-xs rounded-xl cursor-pointer transition shadow-md";
          const uri = show.uri_id ?? (show.tmdb_id ? `tmdb:s:${show.tmdb_id}` : `tvdb:s:${show.tvdb_id}`);
          await loadEpisodesForConversion(uri, sea.season_number, true);
        });
        epMovieSeasonButtons.appendChild(b);
      });
    }

    document.getElementById("epmovie-show-change")?.addEventListener("click", resetEpMoviePicker);
    epMovieShowSearch?.addEventListener("input", () => {
      const q = epMovieShowSearch.value.trim().toLowerCase();
      if (!q) { epMovieShowResults.classList.add("hidden"); return; }
      renderEpMovieShowResults(localShowsList.filter(sh => matchesQuery(sh, q)));
    });

    document.getElementById("add-movie-match-btn")?.addEventListener("click", async () => {
      await fetchLocalShows();
      resetEpMoviePicker();
      (document.getElementById("epmovie-source") as HTMLElement).textContent = "Pick the episode that is really a film";
      epMoviePicker.classList.remove("hidden");
      epMovieModal.classList.remove("opacity-0", "pointer-events-none");
      epMovieShowSearch.focus();
    });

    // ── Match an unmatched title, in place ────────────────────────────────────
    // Previously this linked to /settings, which meant leaving the page (and
    // getting bounced to /login if the session check blipped mid-navigation).
    const matchModal = document.getElementById("match-modal")!;
    let matchTitle = "";
    let matchMediaType = "series";
    let matchProvider: "tvdb" | "tmdb" = "tvdb";
    let matchPickedUri = "";

    const matchResultsEl = document.getElementById("match-results")!;
    const matchInput = document.getElementById("match-search-input") as HTMLInputElement;
    const matchSaveBtn = document.getElementById("match-save") as HTMLButtonElement;
    const matchErrEl = document.getElementById("match-error")!;

    const MATCH_TAB_ON = "flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer bg-zinc-800 text-zinc-100";
    const MATCH_TAB_OFF = "flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer text-zinc-400 hover:text-zinc-200";

    function setMatchProvider(p: "tvdb" | "tmdb") {
      matchProvider = p;
      matchPickedUri = "";
      matchSaveBtn.disabled = true;
      matchResultsEl.innerHTML = "";
      document.querySelectorAll<HTMLElement>("[data-match-tab]").forEach(b => {
        b.className = b.dataset.matchTab === p ? MATCH_TAB_ON : MATCH_TAB_OFF;
      });
      // Movies only exist on TMDB here.
      const tvdbTab = document.querySelector<HTMLElement>('[data-match-tab="tvdb"]');
      if (tvdbTab) tvdbTab.style.display = matchMediaType === "movie" ? "none" : "";
      if (matchInput.value.trim()) runMatchSearch();
    }

    function closeMatchModal() {
      matchModal.classList.add("opacity-0", "pointer-events-none");
    }

    async function runMatchSearch() {
      const q = matchInput.value.trim();
      if (!q) return;
      matchErrEl.classList.add("hidden");
      matchResultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-2">Searching…</p>';
      try {
        let rows: any[] = [];
        if (matchProvider === "tvdb") {
          const res = await fetch("/api/proxy/sync/tvdb-search", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Authorization": `Bearer ${token}` },
            body: JSON.stringify({ query: q }),
          });
          if (!res.ok) throw new Error((await res.json().catch(() => ({}))).detail || "TVDB search failed");
          rows = ((await res.json()).results ?? []).map((r: any) => ({
            uri: `tvdb:s:${r.tvdb_id}`, title: r.name, year: r.year, poster: r.image, idLabel: `TVDB: ${r.tvdb_id}`,
          }));
        } else {
          const type = matchMediaType === "movie" ? "movie" : "series";
          const res = await fetch(`/api/proxy/media/search?q=${encodeURIComponent(q)}&type=${type}&page=1`, {
            headers: { "Authorization": `Bearer ${token}` },
          });
          if (!res.ok) throw new Error("TMDB search failed");
          rows = ((await res.json()).results ?? []).map((r: any) => ({
            uri: `tmdb:${type === "movie" ? "m" : "s"}:${r.tmdb_id}`,
            title: r.title, year: (r.release_date ?? "").slice(0, 4), poster: r.poster_path,
            idLabel: `TMDB: ${r.tmdb_id}`,
          }));
        }
        if (!rows.length) {
          matchResultsEl.innerHTML = '<p class="text-xs text-zinc-500 py-2">No results.</p>';
          return;
        }
        matchResultsEl.innerHTML = "";
        rows.slice(0, 10).forEach(r => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-zinc-800 transition-colors cursor-pointer text-left";
          btn.innerHTML = `
            ${r.poster ? `<img src="${r.poster}" class="w-8 h-11 object-cover rounded bg-zinc-800 shrink-0" onerror="this.style.display='none'" />`
                       : `<div class="w-8 h-11 rounded bg-zinc-800 shrink-0"></div>`}
            <div class="min-w-0 flex-1">
              <p class="text-sm text-zinc-100 truncate">${r.title ?? ""}</p>
              <p class="text-xs text-zinc-500">${r.year ?? ""} • ${r.idLabel}</p>
            </div>`;
          btn.addEventListener("click", () => {
            matchPickedUri = r.uri;
            matchSaveBtn.disabled = false;
            matchResultsEl.querySelectorAll("button").forEach(b => b.classList.remove("bg-indigo-600/20", "ring-1", "ring-indigo-500/40"));
            btn.classList.add("bg-indigo-600/20", "ring-1", "ring-indigo-500/40");
          });
          matchResultsEl.appendChild(btn);
        });
      } catch (e: any) {
        matchResultsEl.innerHTML = "";
        matchErrEl.textContent = e.message ?? "Search failed";
        matchErrEl.classList.remove("hidden");
      }
    }

    document.querySelectorAll<HTMLElement>("[data-match-tab]").forEach(btn => {
      btn.addEventListener("click", () => setMatchProvider(btn.dataset.matchTab as "tvdb" | "tmdb"));
    });
    document.getElementById("match-search-btn")?.addEventListener("click", runMatchSearch);
    matchInput.addEventListener("keydown", e => { if (e.key === "Enter") { e.preventDefault(); runMatchSearch(); } });
    document.getElementById("match-modal-close")?.addEventListener("click", closeMatchModal);
    document.getElementById("match-cancel")?.addEventListener("click", closeMatchModal);

    matchSaveBtn.addEventListener("click", async () => {
      if (!matchPickedUri) return;
      matchSaveBtn.disabled = true;
      matchSaveBtn.textContent = "Matching…";
      matchErrEl.classList.add("hidden");
      try {
        const isMovie = matchMediaType === "movie";
        const endpoint = isMovie ? "/api/proxy/sync/match-unmatched-movie" : "/api/proxy/sync/match-unmatched-show";
        const body = isMovie
          ? { movie_title: matchTitle, uri_id: matchPickedUri }
          : { show_title: matchTitle, uri_id: matchPickedUri };
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", "Authorization": `Bearer ${token}` },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).detail || "Match failed");
        window.showToast?.("Matched successfully", "success");
        setTimeout(() => window.location.reload(), 600);
      } catch (e: any) {
        matchErrEl.textContent = e.message ?? "Match failed";
        matchErrEl.classList.remove("hidden");
        matchSaveBtn.disabled = false;
        matchSaveBtn.textContent = "Match & Apply";
      }
    });

    document.querySelectorAll<HTMLElement>(".unmatched-match-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        matchTitle = btn.dataset.title ?? "";
        matchMediaType = btn.dataset.mediaType ?? "series";
        matchPickedUri = "";
        matchSaveBtn.disabled = false;
        matchSaveBtn.disabled = true;
        matchSaveBtn.textContent = "Match & Apply";
        matchErrEl.classList.add("hidden");
        (document.getElementById("match-modal-source") as HTMLElement).textContent = `"${matchTitle}"`;
        matchInput.value = matchTitle;
        matchModal.classList.remove("opacity-0", "pointer-events-none");
        setMatchProvider(matchMediaType === "movie" ? "tmdb" : "tvdb");
      });
    });

    // Auto-fill and Open Modals based on URL Query Parameters
    const params = new URLSearchParams(window.location.search);
    const mode = params.get('mode');
    
    if (mode === 'season') {
      const uri = params.get('src_uri');
      const season = params.get('src_season');

      if (uri) {
        resetModalState();
        remapModal.classList.remove("opacity-0", "pointer-events-none");

        // The source side defaults to the search picker with its manual fields
        // hidden — reveal them, or the pre-filled id is invisible and the
        // Lookup button the deep-link clicks appears to do nothing.
        sourceManualGroup.classList.remove("hidden");
        sourceManualToggle.classList.add("hidden");

        const provider = uri.startsWith("tvdb:") ? "tvdb" : "tmdb";
        const sourceType = document.getElementById("source-show-id-type") as HTMLSelectElement | null;
        const targetType = document.getElementById("target-show-id-type") as HTMLSelectElement | null;
        if (sourceType) sourceType.value = provider;
        if (targetType) targetType.value = provider;

        sourceShowTmdbInput.value = uri;
        targetShowTmdbInput.value = uri;

        // 2. Pre-fill season coordinates
        if (season) {
          sourceSeasonInput.value = season;
          targetSeasonInput.value = season;
        }

        // 3. Trigger lookups
        sourceShowLookupBtn.click();
        targetShowLookupBtn.click();

        // 4. Validate form
        validateForm();
      }
      // Remove params from URL so refresh doesn't pop it open again
      window.history.replaceState({}, document.title, window.location.pathname);
    } else if (mode === 'ep') {
      const uri = params.get('src_uri');
      const season = params.get('src_season');
      const ep = params.get('src_ep');

      if (uri) {
        openEpModal();
        epSrcTmdbInput.value = uri;
        epTgtTmdbInput.value = uri;

        // 2. Fill coordinates
        if (season) epSrcSeasonInput.value = season;
        if (ep) epSrcEpisodeStartInput.value = ep;
        
        // Trigger target TMDB id listener
        epSrcTmdbInput.dispatchEvent(new Event("input"));
      }
      // Remove params from URL so refresh doesn't pop it open again
      window.history.replaceState({}, document.title, window.location.pathname);
    }

  });
</script>
