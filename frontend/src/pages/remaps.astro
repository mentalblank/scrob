---
import Base from "../layouts/Base.astro";
import { api, tmdbImageUrl } from "../lib/api";

const { token } = Astro.locals;
if (!token) {
  return Astro.redirect("/login");
}

// Which provider's id the remap/rename pickers should default to.
const primaryMetadataSource = Astro.cookies.get("primary_metadata_source")?.value === "tvdb" ? "tvdb" : "tmdb";

let seasonOverrides = [];
let episodeOverrides = [];
let groupedShowsList = [];
let customTitles = [];
let groupedCustomTitlesList = [];
let matchedShows = [];
let matchedMovies = [];
let unmatchedSeasons = [];
let movieConversions = [];
let unmatchedTitles = [];
let error = "";

try {
  const [dataSeason, dataEp, dataTitles, settings, dataMatchedShows, dataMatchedMovies, dataUnmatched, dataConversions] = await Promise.all([
    api.sync.getSeasonOverrides(token),
    api.sync.getEpisodeOverrides(token),
    api.sync.getCustomTitles(token),
    api.auth.getSettings(token),
    api.sync.getMatchedShows(token),
    api.sync.getMatchedMovies(token),
    api.sync.getUnmatchedWarnings(token).catch(() => ({ seasons: [], titles: [] })),
    api.sync.getEpisodeMovieConversions(token).catch(() => ({ conversions: [] })),
  ]);
  
  seasonOverrides = dataSeason;
  episodeOverrides = dataEp.overrides || [];
  matchedShows = dataMatchedShows || [];
  matchedMovies = dataMatchedMovies || [];
  unmatchedSeasons = dataUnmatched?.seasons || [];
  unmatchedTitles = dataUnmatched?.titles || [];
  movieConversions = dataConversions?.conversions || [];
  
  // Group episode overrides by show URI
  const groupedEpisodeOverrides: Record<string, any> = {};
  episodeOverrides.forEach((override: any) => {
    const showKey = override.source_show_uri_id ?? String(override.source_show_id);
    if (!groupedEpisodeOverrides[showKey]) {
      groupedEpisodeOverrides[showKey] = {
        show_key: showKey.replace(/[^a-zA-Z0-9_-]/g, '_'),
        show_title: override.source_show_title,
        show_uri_id: override.source_show_uri_id,
        // source_show_id is the local row id, not a provider id.
        show_tmdb_id: override.source_show_tmdb_id,
        show_tvdb_id: override.source_show_tvdb_id,
        show_poster_path: override.source_show_poster_path,
        overrides: [],
        seasons: {}
      };
    }
    groupedEpisodeOverrides[showKey].overrides.push(override);

    const seasonNum = override.source_season_number;
    if (!groupedEpisodeOverrides[showKey].seasons[seasonNum]) {
      groupedEpisodeOverrides[showKey].seasons[seasonNum] = [];
    }
    groupedEpisodeOverrides[showKey].seasons[seasonNum].push(override);
  });
  groupedShowsList = Object.values(groupedEpisodeOverrides);
  
  customTitles = dataTitles.results || [];
  
  // Group custom titles by show ID
  const groupedCustomTitles: Record<string, any> = {};
  customTitles.forEach((item: any) => {
    // Group per provider as well as per show: TVDB and TMDB number seasons
    // differently, so lumping both into one panel hides which catalogue a
    // rename actually applies to.
    let groupId = `${item.provider ?? 'tmdb'}:${item.show_uri_id ?? String(item.show_tmdb_id ?? 0)}`;
    let groupTitle = item.show_title || "Global / Unlinked";
    let groupPoster = item.show_poster_path || null;

    if (item.type === 'movie') {
      groupId = "movies";
      groupTitle = "Movies";
      groupPoster = null;
    }

    if (!groupedCustomTitles[groupId]) {
      groupedCustomTitles[groupId] = {
        show_key: groupId.replace(/[^a-zA-Z0-9_-]/g, '_'),
        show_title: groupTitle,
        provider: item.type === 'movie' ? null : (item.provider ?? 'tmdb'),
        show_uri_id: item.show_uri_id ?? null,
        show_tmdb_id: item.show_tmdb_id || 0,
        show_poster_path: groupPoster,
        items: [],
        isMovies: item.type === 'movie'
      };
    }
    groupedCustomTitles[groupId].items.push(item);
  });
  // Sort groups: movies first, then shows alphabetically, unlinked last
  groupedCustomTitlesList = Object.values(groupedCustomTitles).sort((a: any, b: any) => {
    if (a.isMovies) return -1;
    if (b.isMovies) return 1;
    if (!a.show_uri_id && !a.show_tmdb_id) return 1;
    if (!b.show_uri_id && !b.show_tmdb_id) return -1;
    return a.show_title.localeCompare(b.show_title);
  });
  
} catch (e: any) {
  error = e.message;
}
---

<Base title="Metadata Overrides">
  <div id="app-data" data-token={token} data-primary-source={primaryMetadataSource} class="hidden" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header with Back Button -->
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-3">
        <div class="flex items-center gap-4">
          <a href="/settings" class="p-2 hover:bg-zinc-800 rounded-full text-zinc-400 hover:text-zinc-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </a>
          <h1 class="text-3xl font-bold text-zinc-100 tracking-tight">Metadata Overrides</h1>
        </div>
        {(seasonOverrides.length > 0 || (episodeOverrides && episodeOverrides.length > 0)) && (
          <button id="apply-all-overrides-btn" class="flex items-center gap-2 px-4 py-2.5 bg-emerald-600/20 hover:bg-emerald-600/35 border border-emerald-500/40 text-emerald-300 text-sm font-bold rounded-xl transition-all shadow-lg active:scale-95 cursor-pointer shrink-0 ml-12 sm:ml-0" title="Apply all overrides and remap episodes">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            Apply All Remaps
          </button>
        )}
      </div>
      <p class="text-zinc-400 ml-12 text-sm sm:text-base">Point specific seasons, episodes, or titles of a TV show in your collection to different TMDB shows, seasons, or custom entries to resolve metadata mismatches and share progress states.</p>
    </div>

    {error && (
      <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 mb-8">{error}</div>
    )}

    <!-- Toolbar -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
      <h2 class="section-headline mb-1 flex items-center gap-2">
        Active Season Remaps
        <span class="text-xs bg-zinc-800 text-zinc-400 font-bold px-2 py-0.5 rounded-full">{seasonOverrides.length}</span>
      </h2>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        {seasonOverrides.length > 0 && (
          <input 
            type="text" 
            id="season-search" 
            placeholder="Search season remaps..." 
            class="px-4 py-2 bg-zinc-950/40 border border-zinc-800 focus:border-indigo-500 rounded-xl text-xs text-zinc-200 focus:outline-none focus:ring-1 focus:ring-indigo-500 w-full sm:w-64 placeholder-zinc-600 transition-all"
          />
        )}
        <button id="add-remap-btn" class="flex items-center justify-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl text-sm transition-all shadow-lg active:scale-95 cursor-pointer shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
          Add Season Remap
        </button>
      </div>
    </div>

    <!-- Active Overrides List -->
    {seasonOverrides.length === 0 ? (
      <div class="flex flex-col items-center justify-center py-20 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
        <div class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-4 shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/></svg>
        </div>
        <h3 class="text-zinc-200 font-semibold mb-1">No Season Remaps</h3>
        <p class="text-zinc-500 text-xs max-w-sm text-center">All your TV show seasons are currently using their standard synced TMDB mappings.</p>
      </div>
    ) : (
      <div>
        <div class="grid grid-cols-1 gap-4">
          {seasonOverrides.map((override) => (
            <div class="season-remap-card flex flex-col md:flex-row items-center justify-between p-5 bg-zinc-900/40 border border-zinc-800 rounded-2xl gap-6 hover:border-zinc-700/80 transition-all duration-300 hover:shadow-lg">
              
              <!-- Source Show -->
              <div class="flex items-center gap-3 w-full md:w-2/5 min-w-0">
                <div class="w-10 h-14 rounded-lg overflow-hidden bg-zinc-950 border border-zinc-800 shrink-0 shadow-sm">
                  {override.source_show_poster_path ? (
                    <img src={tmdbImageUrl(override.source_show_poster_path, "w185")} alt="" class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-[8px] text-zinc-600 font-bold bg-zinc-900">NO ART</div>
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <span class="text-[9px] font-extrabold uppercase text-zinc-500 tracking-wider">Source Show</span>
                  {override.source_show_uri_id
                    ? <a href={`/show/${override.source_show_uri_id}`} class="block text-zinc-100 font-bold truncate text-sm mt-0.5 hover:text-blue-400 transition-colors" title={override.source_show_title}>{override.source_show_title}</a>
                    : <span class="block text-zinc-100 font-bold truncate text-sm mt-0.5">{override.source_show_title}</span>
                  }
                  <div class="flex flex-wrap items-center gap-1.5 mt-1">
                    <span class="px-2 py-0.5 bg-zinc-800 border border-zinc-700 rounded-md text-[10px] font-bold text-zinc-300">Season {override.source_season_number}</span>
                    {override.source_show_tmdb_id && <span class="text-[9px] text-sky-400 font-medium bg-sky-500/10 px-1.5 py-0.5 rounded border border-sky-500/30">tmdb:s:{override.source_show_tmdb_id}</span>}
                    {override.source_show_tvdb_id && <span class="text-[9px] text-indigo-400 font-medium bg-indigo-500/10 px-1.5 py-0.5 rounded border border-indigo-500/30">tvdb:s:{override.source_show_tvdb_id}</span>}
                    {!override.source_show_tmdb_id && !override.source_show_tvdb_id && (
                      <span class="text-[9px] text-zinc-500 font-medium bg-zinc-950/60 px-1.5 py-0.5 rounded border border-zinc-800">{override.source_show_uri_id}</span>
                    )}
                  </div>
                </div>
              </div>

              <!-- Arrow Indicator -->
              <div class="flex flex-col items-center justify-center shrink-0">
                <div class="w-9 h-9 rounded-full bg-zinc-950 border border-zinc-800 flex items-center justify-center text-blue-500 shadow-md">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </div>

              <!-- Target Show -->
              <div class="flex items-center gap-3 w-full md:w-2/5 min-w-0">
                <div class="w-10 h-14 rounded-lg overflow-hidden bg-zinc-950 border border-zinc-800 shrink-0 shadow-sm">
                  {override.target_show_poster_path ? (
                    <img src={tmdbImageUrl(override.target_show_poster_path, "w185")} alt="" class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-[8px] text-zinc-600 font-bold bg-zinc-900">NO ART</div>
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <span class="text-[9px] font-extrabold uppercase text-blue-400 tracking-wider">Target TMDB Show</span>
                  {override.target_show_uri_id
                    ? <a href={`/show/${override.target_show_uri_id}`} class="block text-zinc-100 font-bold truncate text-sm mt-0.5 hover:text-blue-400 transition-colors" title={override.target_show_title}>{override.target_show_title}</a>
                    : <span class="block text-zinc-100 font-bold truncate text-sm mt-0.5">{override.target_show_title}</span>
                  }
                  <div class="flex flex-wrap items-center gap-1.5 mt-1">
                    <span class="px-2 py-0.5 bg-blue-950/40 border border-blue-900/30 rounded-md text-[10px] font-bold text-blue-400">Season {override.target_season_number}</span>
                    {override.target_show_tmdb_id && <span class="text-[9px] text-sky-400 font-medium bg-sky-500/10 px-1.5 py-0.5 rounded border border-sky-500/30">tmdb:s:{override.target_show_tmdb_id}</span>}
                    {override.target_show_tvdb_id && <span class="text-[9px] text-indigo-400 font-medium bg-indigo-500/10 px-1.5 py-0.5 rounded border border-indigo-500/30">tvdb:s:{override.target_show_tvdb_id}</span>}
                    {!override.target_show_tmdb_id && !override.target_show_tvdb_id && (
                      <span class="text-[9px] text-zinc-500 font-medium bg-zinc-950/60 px-1.5 py-0.5 rounded border border-zinc-800">{override.target_show_uri_id}</span>
                    )}
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-2 w-full md:w-auto justify-end shrink-0 border-t border-zinc-800 md:border-t-0 pt-4 md:pt-0">
                <button class="edit-season-btn flex items-center gap-1.5 px-3 py-2 bg-zinc-800 hover:bg-zinc-700 active:scale-95 text-zinc-200 text-xs font-bold rounded-xl transition-all cursor-pointer shadow-sm" data-source-uri={override.source_show_uri_id} data-source-season={override.source_season_number} data-target-uri={override.target_show_uri_id} data-target-season={override.target_season_number} title="Edit override">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                  Edit
                </button>
                <button data-apply-id={override.id} class="flex items-center gap-1.5 px-3 py-2 bg-zinc-800 hover:bg-zinc-700 active:scale-95 text-zinc-200 text-xs font-bold rounded-xl transition-all cursor-pointer shadow-sm" title="Re-apply override & fetch TMDB metadata">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                  Apply
                </button>
                <button data-delete-id={override.id} class="flex items-center gap-1.5 px-3 py-2 bg-rose-950/20 hover:bg-rose-900/30 border border-rose-900/40 text-rose-300 text-xs font-bold rounded-xl transition-all cursor-pointer shadow-sm active:scale-95" title="Delete override">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>
                  Delete
                </button>
              </div>

            </div>
          ))}
        </div>
        <!-- Season search empty state -->
        <div id="no-season-results" class="hidden flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
          <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-3 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <h3 class="text-zinc-300 font-semibold mb-1 text-sm">No Matching Season Remaps</h3>
          <p class="text-zinc-500 text-xs text-center">Try adjusting your keywords or search query.</p>
        </div>
      </div>
    )}
    
    <!-- Episode Remaps Section -->
    <div class="mt-16 mb-8">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
        <h2 class="section-headline mb-1 flex items-center gap-2">
          Active Episode Remaps
          <span class="text-xs bg-zinc-800 text-zinc-400 font-bold px-2 py-0.5 rounded-full">{episodeOverrides.length}</span>
        </h2>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          {episodeOverrides.length > 0 && (
            <input 
              type="text" 
              id="episode-search" 
              placeholder="Search episode remaps..." 
              class="px-4 py-2 bg-zinc-950/40 border border-zinc-800 focus:border-indigo-500 rounded-xl text-xs text-zinc-200 focus:outline-none focus:ring-1 focus:ring-indigo-500 w-full sm:w-64 placeholder-zinc-600 transition-all"
            />
          )}
          <button id="add-ep-remap-btn" class="flex items-center justify-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-sm transition-all shadow-lg active:scale-95 cursor-pointer shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
            Add Episode Remap
          </button>
        </div>
      </div>

      <!-- Episode Overrides List Grouped by Show -->
      {episodeOverrides.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
          <div class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-4 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
          </div>
          <h3 class="text-zinc-200 font-semibold mb-1">No Episode Remaps</h3>
          <p class="text-zinc-500 text-xs max-w-sm text-center">No individual episodes have been remapped.</p>
        </div>
      ) : (
        <div class="space-y-4">
          {groupedShowsList.map((showGroup: any) => (
            <div class="show-episodes-panel border border-zinc-800 rounded-3xl bg-zinc-900/20 overflow-hidden backdrop-blur-md transition-all duration-300" data-show-uri={showGroup.show_uri_id ?? showGroup.show_key}>
              
              <!-- Show Panel Header (Collapsible Toggle) -->
              <div 
                class="flex items-center justify-between p-5 bg-zinc-900/60 border-b border-zinc-800 cursor-pointer select-none hover:bg-zinc-800/40 transition-colors"
                data-show-toggle={showGroup.show_key}
              >
                <div class="flex items-center gap-4 min-w-0">
                  <!-- Collapsible chevron icon -->
                  <svg 
                    class="w-5 h-5 text-zinc-400 transition-transform duration-300 transform" 
                    id={`chevron-${showGroup.show_key}`} 
                    xmlns="http://www.w3.org/2000/svg" 
                    width="24" 
                    height="24" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2.5" 
                    stroke-linecap="round" 
                    stroke-linejoin="round"
                  >
                    <path d="m9 18 6-6-6-6"/>
                  </svg>

                  <!-- Show Poster Image -->
                  <div class="w-10 h-14 rounded-lg overflow-hidden bg-zinc-950 border border-zinc-800 shrink-0 shadow-sm">
                    {showGroup.show_poster_path ? (
                      <img src={tmdbImageUrl(showGroup.show_poster_path, "w185")} alt="" class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-[8px] text-zinc-600 font-bold bg-zinc-900">NO ART</div>
                    )}
                  </div>

                  <div class="min-w-0">
                    <h3 class="text-base font-bold text-zinc-100 truncate hover:text-indigo-400 transition-colors">
                      {showGroup.show_title}
                    </h3>
                    <div class="flex flex-wrap items-center gap-1.5 mt-1">
                      {showGroup.show_tmdb_id && <span class="text-[10px] text-sky-400 font-bold bg-sky-500/10 px-2 py-0.5 rounded border border-sky-500/30">tmdb:s:{showGroup.show_tmdb_id}</span>}
                      {showGroup.show_tvdb_id && <span class="text-[10px] text-indigo-400 font-bold bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-500/30">tvdb:s:{showGroup.show_tvdb_id}</span>}
                      {!showGroup.show_tmdb_id && !showGroup.show_tvdb_id && (
                        <span class="text-[10px] text-zinc-500 font-bold bg-zinc-950 px-2 py-0.5 rounded border border-zinc-800">{showGroup.show_uri_id}</span>
                      )}
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-3 shrink-0">
                  <span class="text-xs bg-zinc-800 text-zinc-400 border border-zinc-700 px-2.5 py-0.5 rounded-full font-extrabold">
                    {showGroup.overrides.length} remaps
                  </span>
                </div>
              </div>

              <!-- Collapsible Content Panel (Hidden by default) -->
              <div 
                id={`panel-${showGroup.show_key}`} 
                class="hidden divide-y divide-zinc-800 bg-zinc-950/20"
              >
                
                <!-- Bulk Actions Toolbar -->
                <div class="px-5 py-3 bg-zinc-900/20 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-zinc-800">
                  <div class="flex items-center gap-2">
                    <input 
                      type="checkbox" 
                      class="bulk-show-select-all rounded border-zinc-700 bg-zinc-950 text-indigo-600 focus:ring-indigo-500 cursor-pointer w-4 h-4" 
                      data-show-id={showGroup.show_key} 
                    />
                    <span class="text-xs font-bold text-zinc-400">Select All in Show</span>
                  </div>
                  
                  <div class="flex items-center gap-2">
                    <button 
                      class="bulk-apply-btn flex items-center justify-center gap-1.5 px-3 py-1.5 bg-emerald-950/20 hover:bg-emerald-900/30 border border-emerald-900/40 text-emerald-400 text-xs font-bold rounded-xl transition-all cursor-pointer shadow-sm active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
                      data-show-id={showGroup.show_key}
                      disabled
                    >
                      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11-4 4 4 4M5 15h11a4 4 0 0 0 4-4v-1"/></svg>
                      Apply Selected (<span class="bulk-selected-count">0</span>)
                    </button>

                    <button 
                      class="bulk-apply-all-show-btn flex items-center justify-center gap-1.5 px-3 py-1.5 bg-indigo-950/20 hover:bg-indigo-900/30 border border-indigo-900/40 text-indigo-400 text-xs font-bold rounded-xl transition-all cursor-pointer shadow-sm active:scale-95"
                      data-show-id={showGroup.show_key}
                    >
                      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                      Apply All in Show
                    </button>
                    
                    <button 
                      class="bulk-delete-btn flex items-center justify-center gap-1.5 px-3 py-1.5 bg-rose-950/20 hover:bg-rose-900/30 border border-rose-900/40 text-rose-400 text-xs font-bold rounded-xl transition-all cursor-pointer shadow-sm active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
                      data-show-id={showGroup.show_key}
                      disabled
                    >
                      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>
                      Delete Selected (<span class="bulk-selected-count">0</span>)
                    </button>
                  </div>
                </div>

                <!-- Season Groups -->
                <div class="divide-y divide-zinc-800/60">
                  {Object.entries(showGroup.seasons)
                    .sort(([a], [b]) => Number(a) - Number(b))
                    .map(([seasonNum, overrides]: [string, any]) => {
                      // Sort episodes in season group by episode number ascending
                      const sortedOverrides = [...overrides].sort((a: any, b: any) => a.source_episode_number - b.source_episode_number);
                      
                      return (
                        <div class="season-group-container bg-zinc-950/10" data-season-num={seasonNum} data-show-id={showGroup.show_key}>
                          <!-- Season Sub-Header -->
                          <div class="px-5 py-2.5 bg-zinc-900/15 flex items-center justify-between border-b border-zinc-800/40">
                            <div class="flex items-center gap-2.5">
                              <input
                                type="checkbox"
                                class="bulk-season-select-all rounded border-zinc-700 bg-zinc-950 text-indigo-600 focus:ring-indigo-500 cursor-pointer w-3.5 h-3.5 shrink-0"
                                data-show-id={showGroup.show_key}
                                data-season-num={seasonNum}
                                title={`Select all in Season ${seasonNum}`}
                              />
                              <span class="text-xs font-black uppercase text-indigo-400 tracking-wider">
                                Season {seasonNum}
                              </span>
                            </div>
                            <span class="text-[10px] bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded-full font-bold">
                              {overrides.length} remaps
                            </span>
                          </div>

                          <!-- Individual Overrides in Season — compact chip grid -->
                          <div class="p-3 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-1.5">
                            {sortedOverrides.map((override: any) => (
                              <div 
                                class="override-row-container group flex items-center gap-2 px-3 py-2 rounded-xl bg-zinc-900/30 border border-zinc-800/60 hover:border-zinc-700/80 hover:bg-zinc-800/30 transition-all duration-150"
                                data-source-season={override.source_season_number}
                                data-source-episode={override.source_episode_number}
                                data-target-season={override.target_season_number}
                                data-target-episode={override.target_episode_number}
                                data-source-title={(override.source_episode_title || "").toLowerCase()}
                                data-target-title={(override.target_episode_title || "").toLowerCase()}
                                data-show-title={showGroup.show_title.toLowerCase()}
                                data-show-uri={showGroup.show_uri_id ?? showGroup.show_key}
                              >
                                <!-- Checkbox -->
                                <input 
                                  type="checkbox" 
                                  class="override-row-checkbox rounded border-zinc-700 bg-zinc-950 text-indigo-600 focus:ring-indigo-500 cursor-pointer w-3.5 h-3.5 shrink-0" 
                                  data-override-id={override.id}
                                  data-show-id={showGroup.show_key}
                                />

                                <!-- Mapping chips -->
                                <div class="flex items-center gap-1.5 flex-1 min-w-0">
                                  <span class="font-mono text-[11px] font-bold text-zinc-300 bg-zinc-800 border border-zinc-700/70 px-1.5 py-0.5 rounded shrink-0">
                                    S{override.source_season_number.toString().padStart(2, '0')}E{override.source_episode_number.toString().padStart(2, '0')}
                                  </span>
                                  <svg class="w-3 h-3 text-zinc-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                  <span class="font-mono text-[11px] font-bold text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-1.5 py-0.5 rounded shrink-0">
                                    S{override.target_season_number.toString().padStart(2, '0')}E{override.target_episode_number.toString().padStart(2, '0')}
                                  </span>
                                  {override.source_show_uri_id !== override.target_show_uri_id && (
                                    <span class="text-[9px] bg-amber-500/10 text-amber-400 border border-amber-500/20 px-1.5 py-0.5 rounded font-black truncate" title={override.target_show_title}>
                                      {override.target_show_title}
                                    </span>
                                  )}
                                </div>

                                <!-- Actions (visible on hover) -->
                                <div class="flex items-center gap-1 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                                  <button class="edit-ep-btn p-1 rounded-lg text-zinc-500 hover:text-blue-400 hover:bg-zinc-800 transition-all cursor-pointer" data-src-uri={override.source_show_uri_id} data-src-season={override.source_season_number} data-src-ep={override.source_episode_number} data-tgt-uri={override.target_show_uri_id} data-tgt-season={override.target_season_number} data-tgt-ep={override.target_episode_number} title="Edit">
                                    <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                  </button>
                                  <button data-ep-apply-id={override.id} class="p-1 rounded-lg text-zinc-500 hover:text-emerald-400 hover:bg-zinc-800 transition-all cursor-pointer" title="Re-apply">
                                    <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                  </button>
                                  <button data-ep-delete-id={override.id} class="p-1 rounded-lg text-zinc-500 hover:text-rose-400 hover:bg-zinc-800 transition-all cursor-pointer" title="Delete">
                                    <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>
                                  </button>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      );
                    })}
                </div>

              </div>

            </div>
          ))}
          <!-- Episode search empty state -->
          <div id="no-episode-results" class="hidden flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
            <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-3 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <h3 class="text-zinc-300 font-semibold mb-1 text-sm">No Matching Episode Remaps</h3>
            <p class="text-zinc-500 text-xs text-center">Try adjusting your keywords or search query.</p>
          </div>
        </div>
    )}
    <!-- Matched as Movies Section -->
    <div class="mt-16">
      <div class="flex items-center justify-between gap-4 mb-6">
        <h2 class="section-headline mb-1 flex items-center gap-2">
          Matched as Movies
          <span class="text-xs bg-zinc-800 text-zinc-400 font-bold px-2 py-0.5 rounded-full">{movieConversions.length}</span>
        </h2>
        <button
          id="add-movie-match-btn"
          class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold rounded-xl text-xs flex items-center gap-1.5 shadow-lg shadow-indigo-600/10 cursor-pointer transition-all shrink-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
          Add Movie Match
        </button>
      </div>

      {movieConversions.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
          <div class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-4 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 4 16 0M4 20l16 0M4 4v16M20 4v16M8 4v16M16 4v16"/></svg>
          </div>
          <h3 class="text-zinc-200 font-semibold mb-1">No Episodes Matched as Movies</h3>
          <p class="text-zinc-500 text-xs max-w-sm text-center">When a catalogue files a film as an episode, use "Match as Movies" on an unmatched season to re-file it.</p>
        </div>
      ) : (
        <div class="border border-zinc-800 rounded-3xl bg-zinc-900/20 overflow-hidden backdrop-blur-md divide-y divide-zinc-800/60">
          {movieConversions.map((c: any) => (
            <div class="flex items-center gap-4 p-4">
              {c.movie_poster_path
                ? <img src={tmdbImageUrl(c.movie_poster_path, "w185")} class="w-9 h-13 rounded object-cover shrink-0 border border-zinc-800" loading="lazy" />
                : <div class="w-9 h-13 rounded bg-zinc-950 border border-zinc-800 shrink-0"></div>}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-[10px] bg-blue-900/30 text-blue-400 font-bold px-2 py-0.5 rounded uppercase tracking-wider">Movie</span>
                  <span class="text-sm font-bold text-zinc-100 truncate">{c.movie_title}</span>
                  {c.movie_release_date && <span class="text-xs text-zinc-500">{c.movie_release_date.slice(0, 4)}</span>}
                </div>
                <p class="text-xs text-zinc-500 mt-1">
                  was
                  <span class="text-zinc-400 font-medium"> {c.original_show_title ?? "unknown show"}</span>
                  {c.original_season_number != null && (
                    <span class="text-zinc-400 font-medium"> S{String(c.original_season_number).padStart(2, "0")}E{String(c.original_episode_number ?? 0).padStart(2, "0")}</span>
                  )}
                  {c.original_title && <span class="text-zinc-600"> — “{c.original_title}”</span>}
                </p>
                <span class="text-[10px] text-zinc-600 font-mono">tmdb:m:{c.movie_tmdb_id}</span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <a href={`/media/movie/tmdb:m:${c.movie_tmdb_id}`} class="text-xs px-3 py-1.5 rounded-xl border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-zinc-200 transition-colors bg-zinc-900/40">View</a>
                <button
                  type="button"
                  class="revert-conversion-btn text-xs px-3 py-1.5 rounded-xl border border-rose-900/40 text-rose-400 hover:bg-rose-950/30 hover:border-rose-900/70 transition-colors cursor-pointer"
                  data-conversion-id={c.id}
                  title="Put this back as an episode"
                >Revert</button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Unmatched Media Mappings Section -->
    <div class="mt-16">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <h2 class="section-headline mb-1 flex items-center gap-2">
          Unmatched Media Mappings
          <span class="text-xs bg-zinc-800 text-zinc-400 font-bold px-2 py-0.5 rounded-full">{matchedShows.length + matchedMovies.length + unmatchedSeasons.length + unmatchedTitles.length}</span>
        </h2>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          {(matchedShows.length > 0 || matchedMovies.length > 0) && (
            <input 
              type="text" 
              id="unmatched-search" 
              placeholder="Search mappings..." 
              class="px-4 py-2 bg-zinc-950/40 border border-zinc-800 focus:border-indigo-500 rounded-xl text-xs text-zinc-200 focus:outline-none focus:ring-1 focus:ring-indigo-500 w-full sm:w-64 placeholder-zinc-600 transition-all"
            />
          )}
        </div>
      </div>

      {(unmatchedSeasons.length > 0 || unmatchedTitles.length > 0) && (
        <div class="mb-6 border border-amber-500/25 bg-amber-500/[0.03] rounded-3xl overflow-hidden backdrop-blur-md">
          <div class="px-5 py-4 border-b border-amber-500/20">
            <h3 class="text-sm font-bold text-amber-300">Still unmatched from the last sync</h3>
            <p class="text-xs text-zinc-500 mt-1">Each row shows the catalogue the lookup failed against. Remap a season onto the right show, or match a title that has no provider id.</p>
            <button type="button" id="restore-dismissed-btn" class="mt-2 text-[10px] font-bold text-zinc-500 hover:text-zinc-300 uppercase tracking-widest transition-colors cursor-pointer">Restore dismissed items</button>
          </div>
          <div class="divide-y divide-zinc-800/60">
            {unmatchedSeasons.map((w: any) => (
              <div class="flex items-center gap-3 px-5 py-3">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">{w.show}</span>
                  <span class="ml-2 text-xs text-zinc-500">Season {w.season}</span>
                  <span class={`ml-2 text-[10px] font-black px-1.5 py-0.5 rounded border ${w.provider === 'tvdb' ? 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30' : 'bg-sky-500/10 text-sky-400 border-sky-500/30'}`}>No {w.provider.toUpperCase()} match</span>
                  <p class="text-xs text-zinc-500 mt-0.5">{w.affected_episodes} episode{w.affected_episodes === 1 ? '' : 's'} affected</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <a
                    href={`/remaps?mode=season&src_uri=${encodeURIComponent(w.source_uri_id)}&src_season=${w.season}`}
                    class="text-xs px-3 py-1.5 rounded-xl border bg-amber-500/15 border-amber-500/40 text-amber-400 hover:bg-amber-500/25 transition-colors"
                  >Remap</a>
                  <button
                    type="button"
                    class="ep-to-movie-btn text-xs px-3 py-1.5 rounded-xl border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-zinc-200 transition-colors bg-zinc-900/40 cursor-pointer"
                    data-show-uri={w.source_uri_id}
                    data-season={w.season}
                    data-show={w.show}
                    title="These are films on TMDB, not episodes"
                  >Match as Movies</button>
                  <button
                    type="button"
                    class="dismiss-warning-btn p-1.5 rounded-lg text-zinc-600 hover:text-zinc-300 hover:bg-zinc-800 transition-colors cursor-pointer"
                    data-dismiss-key={w.dismiss_key}
                    title="Dismiss — hide this from the unmatched list"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  </button>
                </div>
              </div>
            ))}
            {unmatchedTitles.map((w: any) => (
              <div class="flex items-center gap-3 px-5 py-3">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">{w.title}</span>
                  <span class="ml-2 text-xs text-zinc-600">{w.media_type}</span>
                  <span class="ml-2 text-[10px] font-black px-1.5 py-0.5 rounded border bg-sky-500/10 text-sky-400 border-sky-500/30">No {w.provider.toUpperCase()} match</span>
                  <p class="text-xs text-zinc-500 mt-0.5">{w.reason}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    class="unmatched-match-btn text-xs px-3 py-1.5 rounded-xl border bg-amber-500/15 border-amber-500/40 text-amber-400 hover:bg-amber-500/25 cursor-pointer transition-colors"
                    data-title={w.title}
                    data-media-type={w.media_type}
                  >Match</button>
                  <button
                    type="button"
                    class="dismiss-warning-btn p-1.5 rounded-lg text-zinc-600 hover:text-zinc-300 hover:bg-zinc-800 transition-colors cursor-pointer"
                    data-dismiss-key={w.dismiss_key}
                    title="Dismiss — hide this from the unmatched list"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {matchedShows.length === 0 && matchedMovies.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
          <div class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-4 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h3 class="text-zinc-200 font-semibold mb-1">No Unmatched Mappings</h3>
          <p class="text-zinc-500 text-xs max-w-sm text-center">You haven't mapped any unmatched local show or movie titles to TMDB/TVDB.</p>
        </div>
      ) : (
        <div class="space-y-3" id="unmatched-mappings-list">
          {/* Unmatched Shows */}
          {matchedShows.map((s: any) => {
            const displayTitle = s.show_title_matched || s.show_title;
            const targetHref = s.show_uri_id ? `/show/${s.show_uri_id}` : (s.tvdb_id ? `/show/tvdb:s:${s.tvdb_id}` : '');
            return (
              <div class="unmatched-map-row flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 bg-zinc-900/20 border border-zinc-800 hover:border-zinc-700/80 rounded-2xl transition-all backdrop-blur-md" data-title={s.show_title} data-matched-title={displayTitle} data-type="show">
                <div class="w-10 h-14 rounded-lg overflow-hidden bg-zinc-950 border border-zinc-800 shrink-0 shadow-sm">
                  {s.poster_path ? (
                    <img src={tmdbImageUrl(s.poster_path, "w185")} alt="" class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-[8px] text-zinc-600 font-bold bg-zinc-900">NO ART</div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-[10px] bg-indigo-500/10 text-indigo-400 font-bold px-2 py-0.5 rounded-full border border-indigo-500/20 uppercase tracking-wider">Show</span>
                    <span class="text-zinc-400 text-xs">Original Local Title:</span>
                    <span class="text-sm font-semibold text-zinc-200">{s.show_title}</span>
                  </div>
                  <div class="mt-1 flex items-center gap-1.5 text-xs text-zinc-400 flex-wrap">
                    <span>Mapped to:</span>
                    {targetHref ? (
                      <a href={targetHref} class="text-indigo-400 hover:underline font-medium">{displayTitle}</a>
                    ) : (
                      <span class="font-medium text-zinc-300">{displayTitle}</span>
                    )}
                    {s.tvdb_id && <span class="text-zinc-600 font-mono">(TVDB ID: {s.tvdb_id})</span>}
                    {s.show_id && <span class="text-zinc-600 font-mono">(TMDB ID: {s.show_id})</span>}
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                  <button 
                    type="button" 
                    class="edit-unmatched-show-btn text-xs px-3 py-1.5 rounded-xl border border-green-700/50 text-green-400 hover:bg-green-900/20 cursor-pointer transition-colors"
                    data-show-title={s.show_title}
                  >
                    Edit
                  </button>
                  <button 
                    type="button" 
                    class="unmatch-show-btn text-xs px-3 py-1.5 rounded-xl border border-rose-950/30 text-rose-400 hover:bg-rose-950/20 border-rose-900/35 hover:border-rose-900/60 cursor-pointer transition-colors"
                    data-show-title={s.show_title}
                  >
                    Remove
                  </button>
                </div>
              </div>
            );
          })}

          {/* Unmatched Movies */}
          {matchedMovies.map((m: any) => {
            const displayTitle = m.movie_title_matched || m.movie_title;
            const targetHref = m.tmdb_id ? `/media/movie/tmdb:m:${m.tmdb_id}` : '';
            return (
              <div class="unmatched-map-row flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 bg-zinc-900/20 border border-zinc-800 hover:border-zinc-700/80 rounded-2xl transition-all backdrop-blur-md" data-title={m.movie_title} data-matched-title={displayTitle} data-type="movie">
                <div class="w-10 h-14 rounded-lg overflow-hidden bg-zinc-950 border border-zinc-800 shrink-0 shadow-sm">
                  {m.poster_path ? (
                    <img src={tmdbImageUrl(m.poster_path, "w185")} alt="" class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-[8px] text-zinc-600 font-bold bg-zinc-900">NO ART</div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-[10px] bg-amber-500/10 text-amber-400 font-bold px-2 py-0.5 rounded-full border border-amber-500/20 uppercase tracking-wider">Movie</span>
                    <span class="text-zinc-400 text-xs">Original Local Title:</span>
                    <span class="text-sm font-semibold text-zinc-200">{m.movie_title}</span>
                  </div>
                  <div class="mt-1 flex items-center gap-1.5 text-xs text-zinc-400 flex-wrap">
                    <span>Mapped to:</span>
                    {targetHref ? (
                      <a href={targetHref} class="text-indigo-400 hover:underline font-medium">{displayTitle}</a>
                    ) : (
                      <span class="font-medium text-zinc-300">{displayTitle}</span>
                    )}
                    {m.tmdb_id && <span class="text-zinc-600 font-mono">(TMDB ID: {m.tmdb_id})</span>}
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                  <button 
                    type="button" 
                    class="edit-unmatched-movie-btn text-xs px-3 py-1.5 rounded-xl border border-green-700/50 text-green-400 hover:bg-green-900/20 cursor-pointer transition-colors"
                    data-movie-title={m.movie_title}
                  >
                    Edit
                  </button>
                  <button 
                    type="button" 
                    class="unmatch-movie-btn text-xs px-3 py-1.5 rounded-xl border border-rose-950/30 text-rose-400 hover:bg-rose-950/20 border-rose-900/35 hover:border-rose-900/60 cursor-pointer transition-colors"
                    data-movie-title={m.movie_title}
                  >
                    Remove
                  </button>
                </div>
              </div>
            );
          })}
          
          <!-- Unmatched search empty state -->
          <div id="no-unmatched-results" class="hidden flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
            <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-3 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <h3 class="text-zinc-300 font-semibold mb-1 text-sm">No Matching Mappings</h3>
            <p class="text-zinc-500 text-xs text-center">Try adjusting your search query.</p>
          </div>
        </div>
      )}
    </div>

    <!-- Custom Renames Section -->
    <div class="mt-16">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <h2 class="section-headline mb-1 flex items-center gap-2">
          Global Custom Renames
          <span class="text-xs bg-zinc-800 text-zinc-400 font-bold px-2 py-0.5 rounded-full">{customTitles.length}</span>
        </h2>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          {customTitles.length > 0 && (
            <input 
              type="text" 
              id="rename-search" 
              placeholder="Search custom renames..." 
              class="px-4 py-2 bg-zinc-950/40 border border-zinc-800 focus:border-indigo-500 rounded-xl text-xs text-zinc-200 focus:outline-none focus:ring-1 focus:ring-indigo-500 w-full sm:w-64 placeholder-zinc-600 transition-all"
            />
          )}
          <button 
            id="add-rename-btn" 
            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold rounded-xl text-xs flex items-center gap-1.5 shadow-lg shadow-indigo-600/10 cursor-pointer transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
            Add Rename
          </button>
        </div>
      </div>

      {customTitles.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
          <div class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-4 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <h3 class="text-zinc-200 font-semibold mb-1">No Custom Renames</h3>
          <p class="text-zinc-500 text-xs max-w-sm text-center">You haven't renamed any shows, seasons, or episodes.</p>
        </div>
      ) : (
        <div class="space-y-4">
          {groupedCustomTitlesList.map((showGroup: any) => (
            <div class="show-renames-panel border border-zinc-800 rounded-3xl bg-zinc-900/20 overflow-hidden backdrop-blur-md transition-all duration-300" data-rename-uri={showGroup.show_uri_id ?? showGroup.show_key}>
              
              <!-- Show Panel Header (Collapsible Toggle) -->
              <div 
                class="flex items-center justify-between p-5 bg-zinc-900/60 border-b border-zinc-800 cursor-pointer select-none hover:bg-zinc-800/40 transition-colors"
                data-rename-toggle={showGroup.show_key}
              >
                <div class="flex items-center gap-4 min-w-0">
                  <!-- Collapsible chevron icon -->
                  <svg 
                    class="w-5 h-5 text-zinc-400 transition-transform duration-300 transform" 
                    id={`rename-chevron-${showGroup.show_key}`} 
                    xmlns="http://www.w3.org/2000/svg" 
                    width="24" 
                    height="24" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2.5" 
                    stroke-linecap="round" 
                    stroke-linejoin="round"
                  >
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                  
                  <!-- Show Poster Image -->
                  {!!(showGroup.show_uri_id || showGroup.show_tmdb_id) && (
                    <div class="w-10 h-14 rounded-lg overflow-hidden bg-zinc-950 border border-zinc-800 shrink-0 shadow-sm">
                      {showGroup.show_poster_path ? (
                        <img src={tmdbImageUrl(showGroup.show_poster_path, "w185")} alt="" class="w-full h-full object-cover" loading="lazy" />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-[8px] text-zinc-600 font-bold bg-zinc-900">NO ART</div>
                      )}
                    </div>
                  )}

                  <div class="min-w-0">
                    <h3 class="text-base font-bold text-zinc-100 truncate hover:text-indigo-400 transition-colors">
                      {showGroup.show_title}
                    </h3>
                    {!!(showGroup.show_uri_id || showGroup.show_tmdb_id) && (
                      <>
                        <span class="text-[10px] text-zinc-500 font-bold bg-zinc-950 px-2 py-0.5 rounded border border-zinc-800 mt-1 inline-block">{showGroup.show_uri_id ?? ("TMDB ID: " + showGroup.show_tmdb_id)}</span>
                        {showGroup.provider && (
                          <span class={`ml-1.5 text-[10px] font-black px-2 py-0.5 rounded border mt-1 inline-block ${showGroup.provider === 'tvdb' ? 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30' : 'bg-sky-500/10 text-sky-400 border-sky-500/30'}`}>{showGroup.provider.toUpperCase()}</span>
                        )}
                      </>
                    )}
                  </div>
                </div>

                <div class="flex items-center gap-3 shrink-0">
                  <span class="text-xs bg-zinc-800 text-zinc-400 border border-zinc-700 px-2.5 py-0.5 rounded-full font-extrabold">
                    {showGroup.items.length} renames
                  </span>
                </div>
              </div>

              <!-- Collapsible Content Panel (Hidden by default) -->
              <div 
                id={`rename-panel-${showGroup.show_key}`} 
                class="hidden divide-y divide-zinc-800 bg-zinc-950/20"
              >
                <div class="overflow-x-auto">
                  <table class="w-full text-left border-collapse">
                    <thead>
                      <tr class="bg-zinc-900 border-b border-zinc-800 text-xs text-zinc-500 uppercase tracking-wider">
                        <th class="px-5 py-3 font-semibold w-24">Type</th>
                        <th class="px-5 py-3 font-semibold">Context</th>
                        <th class="px-5 py-3 font-semibold">Original Title</th>
                        <th class="px-5 py-3 font-semibold">Custom Title</th>
                        <th class="px-5 py-3 font-semibold text-right w-28">Actions</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/50 text-sm">
                      {showGroup.items.map((item: any) => (
                        <tr class="custom-rename-row hover:bg-zinc-800/10 transition-colors">
                          <td class="px-5 py-4 whitespace-nowrap">
                            {item.type === 'show' && <span class="px-2 py-1 bg-purple-900/30 text-purple-400 rounded font-bold text-xs">Show</span>}
                            {item.type === 'season' && <span class="px-2 py-1 bg-teal-900/30 text-teal-400 rounded font-bold text-xs">Season</span>}
                            {item.type === 'episode' && <span class="px-2 py-1 bg-orange-900/30 text-orange-400 rounded font-bold text-xs">Episode</span>}
                            {item.type === 'movie' && <span class="px-2 py-1 bg-blue-900/30 text-blue-400 rounded font-bold text-xs">Movie</span>}
                          </td>
                          <td class="px-5 py-4 text-zinc-400">
                            {item.context}
                            {item.provider && (
                              <span class={`ml-2 text-[9px] font-black px-1.5 py-0.5 rounded border align-middle ${item.provider === 'tvdb' ? 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30' : 'bg-sky-500/10 text-sky-400 border-sky-500/30'}`}>
                                {item.provider.toUpperCase()}
                              </span>
                            )}
                          </td>
                          <td class="px-5 py-4 text-zinc-500 line-through decoration-zinc-600">{item.original_title}</td>
                          <td class="px-5 py-4 text-zinc-200 font-bold">{item.custom_title}</td>
                          <td class="px-5 py-4 text-right">
                            <button class="custom-rename-edit-btn p-1.5 text-zinc-500 hover:text-blue-400 transition-colors" data-payload={JSON.stringify(item)} title="Edit">
                              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                            </button>
                            <button class="custom-rename-delete-btn p-1.5 text-zinc-500 hover:text-red-400 transition-colors ml-2" data-payload={JSON.stringify(item)} title="Remove Override">
                              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

            </div>
          ))}
          <!-- Rename search empty state -->
          <div id="no-rename-results" class="hidden flex flex-col items-center justify-center py-16 border border-zinc-800 bg-zinc-950/20 rounded-3xl backdrop-blur-md">
            <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-3 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <h3 class="text-zinc-300 font-semibold mb-1 text-sm">No Matching Custom Renames</h3>
            <p class="text-zinc-500 text-xs text-center">Try adjusting your keywords or search query.</p>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Wizard Modal -->
  <!-- Episode -> movie modal -->
  <div id="epmovie-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/85 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="relative w-full max-w-2xl bg-zinc-900 border border-zinc-800 rounded-3xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-800">
        <div class="min-w-0">
          <h3 class="text-sm font-bold text-zinc-100">Match Episodes to Movies</h3>
          <p id="epmovie-source" class="text-xs text-zinc-500 truncate"></p>
        </div>
        <button type="button" id="epmovie-close" class="p-2 text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="px-6 py-4 overflow-y-auto flex-1">
        <p class="text-xs text-zinc-500 mb-4">Use this when a catalogue lists films as episodes. Converting keeps the item's collected status and watch history.</p>

        <div id="epmovie-picker" class="hidden space-y-4 mb-5">
          <div>
            <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Show</label>
            <div class="flex gap-2">
              <input type="text" id="epmovie-show-search" placeholder="Search your shows by title or ID…" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-indigo-500 transition-all" />
            </div>
            <div id="epmovie-show-results" class="hidden mt-2 space-y-1 max-h-48 overflow-y-auto"></div>
            <div id="epmovie-show-selected" class="hidden mt-2 flex items-center justify-between gap-3 p-2.5 bg-indigo-600/10 border border-indigo-500/30 rounded-xl">
              <span id="epmovie-show-title" class="text-sm font-bold text-zinc-100 truncate"></span>
              <button type="button" id="epmovie-show-change" class="text-xs text-zinc-400 hover:text-zinc-200 cursor-pointer shrink-0">Change</button>
            </div>
          </div>
          <div id="epmovie-season-group" class="hidden">
            <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Season</label>
            <div id="epmovie-season-buttons" class="flex flex-wrap gap-2"></div>
          </div>
        </div>

        <div id="epmovie-list" class="space-y-2"></div>
        <p id="epmovie-error" class="hidden text-xs text-red-400 mt-3"></p>
      </div>
      <div class="flex justify-end px-6 py-4 border-t border-zinc-800">
        <button type="button" id="epmovie-done" class="px-5 py-2 text-zinc-400 hover:text-zinc-200 text-sm font-bold transition-colors cursor-pointer">Close</button>
      </div>
    </div>
  </div>

  <!-- Match unmatched title modal -->
  <div id="match-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/85 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="relative w-full max-w-lg bg-zinc-900 border border-zinc-800 rounded-3xl shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-800">
        <div class="min-w-0">
          <h3 class="text-sm font-bold text-zinc-100">Match Title</h3>
          <p id="match-modal-source" class="text-xs text-zinc-500 truncate"></p>
        </div>
        <button type="button" id="match-modal-close" class="p-2 text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="px-6 py-5 space-y-4">
        <div id="match-provider-tabs" class="flex gap-1 p-1 bg-zinc-950 rounded-xl">
          <button type="button" data-match-tab="tvdb" class="flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer">TVDB</button>
          <button type="button" data-match-tab="tmdb" class="flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer">TMDB</button>
        </div>
        <div class="flex gap-2">
          <input type="text" id="match-search-input" placeholder="Show title…" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-indigo-500 transition-all" />
          <button type="button" id="match-search-btn" class="px-4 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 text-sm font-medium rounded-xl transition-colors cursor-pointer shrink-0">Search</button>
        </div>
        <div id="match-results" class="space-y-1 max-h-64 overflow-y-auto"></div>
        <p id="match-error" class="hidden text-xs text-red-400"></p>
      </div>
      <div class="flex justify-end gap-3 px-6 py-4 border-t border-zinc-800">
        <button type="button" id="match-cancel" class="px-5 py-2 text-zinc-400 hover:text-zinc-200 text-sm font-bold transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="match-save" disabled class="px-6 py-2 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed text-white text-sm font-bold rounded-xl transition-colors cursor-pointer">Match &amp; Apply</button>
      </div>
    </div>
  </div>

  <div id="remap-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/85 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="bg-zinc-900/85 border border-zinc-800/85 rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh] backdrop-blur-xl">
      
      <!-- Modal Header -->
      <div class="px-6 py-5 border-b border-zinc-800 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-zinc-100">Add Custom Season Remap</h2>
          <p class="text-xs text-zinc-400 mt-0.5">Define a new source-to-target season override mapping.</p>
        </div>
        <button id="close-modal-btn" class="w-8 h-8 rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-300 flex items-center justify-center cursor-pointer transition">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="p-6 overflow-y-auto space-y-6 flex-1">
        
        <!-- STEP 1: SOURCE SHOW & SEASON -->
        <div class="space-y-4">
          <h3 class="text-sm font-bold text-zinc-200 uppercase tracking-wider flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-zinc-800 text-zinc-400 text-xs flex items-center justify-center font-bold">1</span>
            Source Season (From Library)
          </h3>

          <!-- Source Show Search -->
          <div class="space-y-2">
            <div class="flex gap-2">
              <input 
                type="text" 
                id="source-show-search" 
                placeholder="Search show in your collection..." 
                class="flex-1 px-4 py-2.5 bg-zinc-950/50 border border-zinc-800 focus:border-indigo-500 rounded-xl text-sm text-zinc-200 focus:outline-none placeholder-zinc-700"
              />
              <button id="source-show-search-btn" class="px-4 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-xl text-xs font-bold transition cursor-pointer">Search</button>
            </div>
            <div id="source-show-results" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-48 overflow-y-auto hidden no-scrollbar">
              <!-- Search results will appear here -->
            </div>
          </div>

          <!-- Selected Source Show Card -->
          <div id="source-selected-show-card" class="flex items-center justify-between p-3 bg-indigo-600/10 border border-indigo-500/30 rounded-2xl hidden">
            <div class="flex items-center gap-4 min-w-0">
              <img id="source-selected-show-poster" src="" class="w-10 h-14 rounded object-cover shadow-lg border border-indigo-500/20" />
              <div class="min-w-0">
                <h4 id="source-selected-show-title" class="text-sm font-bold text-zinc-100 truncate"></h4>
                <p id="source-selected-show-meta" class="text-[10px] text-zinc-500 font-bold mt-0.5"></p>
                <div id="source-provider-toggle" class="hidden mt-2 flex items-center gap-1.5">
                  <span class="text-[9px] font-bold text-zinc-500 uppercase tracking-widest">Use</span>
                  <div class="flex rounded-lg border border-zinc-700 bg-zinc-950 p-0.5" role="group" aria-label="Source provider">
                    <button type="button" data-source-provider="tmdb" class="rounded-md px-2 py-0.5 text-[10px] font-bold transition-colors cursor-pointer">TMDB</button>
                    <button type="button" data-source-provider="tvdb" class="rounded-md px-2 py-0.5 text-[10px] font-bold transition-colors cursor-pointer">TVDB</button>
                  </div>
                </div>
              </div>
            </div>
            <button id="source-change-show-btn" class="p-2 text-zinc-500 hover:text-zinc-300 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>

          <div id="source-manual-toggle" class="pt-2">
            <button id="source-show-manual-btn" class="text-[10px] font-bold text-zinc-500 hover:text-zinc-400 uppercase tracking-widest transition">
              Or Enter ID Manually
            </button>
          </div>

          <div id="source-manual-group" class="grid grid-cols-1 sm:grid-cols-2 gap-4 hidden">
            <div>
