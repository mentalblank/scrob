    function updateBulkDeleteState(showId: string) {
      const panel = document.getElementById(`panel-${showId}`);
      if (!panel) return;

      const checkedBoxes = panel.querySelectorAll(".override-row-checkbox:checked");
      const totalBoxes = panel.querySelectorAll(".override-row-checkbox");
      const selectAllCheckbox = panel.querySelector(".bulk-show-select-all") as HTMLInputElement;
      const bulkDeleteBtn = panel.querySelector(".bulk-delete-btn") as HTMLButtonElement;
      const bulkApplyBtn = panel.querySelector(".bulk-apply-btn") as HTMLButtonElement;
      const countSpans = panel.querySelectorAll(".bulk-selected-count");

      countSpans.forEach(span => {
        span.textContent = checkedBoxes.length.toString();
      });

      if (checkedBoxes.length > 0) {
        if (bulkDeleteBtn) bulkDeleteBtn.removeAttribute("disabled");
        if (bulkApplyBtn) bulkApplyBtn.removeAttribute("disabled");
      } else {
        if (bulkDeleteBtn) bulkDeleteBtn.setAttribute("disabled", "true");
        if (bulkApplyBtn) bulkApplyBtn.setAttribute("disabled", "true");
