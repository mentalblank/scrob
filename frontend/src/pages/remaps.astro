    function updateManualRenameType() {
      const type = renameManualMediaType.value;
      if (type === "movie") {
        renameTypeMovie.classList.remove("hidden");
        renameTypeShow.classList.add("hidden");
        renameTypeSeason.classList.add("hidden");
        renameTypeEpisode.classList.add("hidden");
        selectRenameType("movie");
      } else {
        renameTypeMovie.classList.add("hidden");
        renameTypeShow.classList.remove("hidden");
        renameTypeSeason.classList.remove("hidden");
        renameTypeEpisode.classList.remove("hidden");
        selectRenameType("show");
      }
    }

    renameManualMediaType.addEventListener("change", () => {
      updateManualRenameType();
      validateRenameForm();
    });

    renameManualIdType.addEventListener("change", validateRenameForm);
    renameManualIdInput.addEventListener("input", validateRenameForm);
    renameManualSeasonInput.addEventListener("input", validateRenameForm);
    renameManualEpisodeInput.addEventListener("input", validateRenameForm);

    function validateRenameForm() {
      let isValid = false;
      const hasTitle = renameCustomTitleInput.value.trim().length > 0;
      
      if (isManualRename) {
        const hasId = renameManualIdInput.value.trim().length > 0;
        if (renameType === "show" || renameType === "movie") {
          isValid = hasId && hasTitle;
        } else if (renameType === "season") {
          const hasSeason = renameManualSeasonInput.value.trim().length > 0;
          isValid = hasId && hasSeason && hasTitle;
        } else if (renameType === "episode") {
          const hasSeason = renameManualSeasonInput.value.trim().length > 0;
          const hasEpisode = renameManualEpisodeInput.value.trim().length > 0;
          isValid = hasId && hasSeason && hasEpisode && hasTitle;
        }
      } else {
        if (renameType === "show" || renameType === "movie") {
          isValid = !!renameSelectedShow && hasTitle;
        } else if (renameType === "season") {
          isValid = !!renameSelectedShow && renameSelectedSeason !== null && hasTitle;
        } else if (renameType === "episode") {
          isValid = !!renameSelectedShow && renameSelectedSeason !== null && !!renameSelectedEpisode && hasTitle;
        }
      }

      saveRenameBtn.disabled = !isValid;
    }

    function resetRenameModal() {
      isManualRename = false;
      if (renameShowManualBtn) renameShowManualBtn.textContent = "Or Enter ID Manually";
      if (renameManualFields) renameManualFields.classList.add("hidden");
      if (renameManualIdInput) renameManualIdInput.value = "";
      if (renameManualSeasonInput) renameManualSeasonInput.value = "";
      if (renameManualEpisodeInput) renameManualEpisodeInput.value = "";
      if (renameManualMediaType) renameManualMediaType.value = "show";
      if (renameManualIdType) renameManualIdType.value = "tmdb";

      renameType = "show";
      renameSelectedShow = null;
      renameSelectedSeason = null;
      renameSelectedEpisode = null;

      // Reset tabs
      renameTypeMovie.classList.add("hidden");
      renameTypeShow.classList.remove("hidden");
      renameTypeSeason.classList.remove("hidden");
      renameTypeEpisode.classList.remove("hidden");

      renameTypeShow.className = "flex-1 px-4 py-2.5 rounded-xl border border-indigo-500/30 bg-indigo-600/10 text-zinc-100 font-bold text-xs transition cursor-pointer text-center";
      renameTypeSeason.className = "flex-1 px-4 py-2.5 rounded-xl border border-zinc-800 bg-zinc-900/40 text-zinc-400 font-bold text-xs transition cursor-pointer text-center";
      renameTypeEpisode.className = "flex-1 px-4 py-2.5 rounded-xl border border-zinc-800 bg-zinc-900/40 text-zinc-400 font-bold text-xs transition cursor-pointer text-center";

      renameShowSearch.value = "";
      renameShowSearch.classList.remove("hidden");
      renameShowSearchBtn.classList.remove("hidden");
      renameShowResults.innerHTML = "";
      renameShowResults.classList.add("hidden");
      
      renameSelectedShowCard.classList.add("hidden");
      renameTypeSection.classList.add("hidden");
      renameSeasonSection.classList.add("hidden");
      renameSeasonButtons.innerHTML = "";
      renameEpisodeSection.classList.add("hidden");
      renameEpisodeContainer.innerHTML = "";
      renameCustomTitleInput.value = "";
      saveRenameBtn.disabled = true;
    }

    async function resolveManualEpisodeMediaId(showUri: string, seasonNumber: number, episodeNumber: number) {
      try {
        const res = await fetch(`/api/proxy/shows/${encodeURIComponent(showUri)}/season/${seasonNumber}`, {
          headers: { "Authorization": `Bearer ${token}` }
        });
        if (res.ok) {
          const data = await res.json();
          const episodes = data.episodes || [];
          const ep = episodes.find((e: any) => e.episode_number === episodeNumber);
          return ep ? ep.id : null;
        }
      } catch (err) {
        console.error("Error resolving manual episode media ID", err);
      }
      return null;
    }

    // Save Custom Rename Action
    saveRenameBtn.addEventListener("click", async () => {
      const customTitle = renameCustomTitleInput.value.trim();
      const body: any = {};

      if (isManualRename) {
        const idType = renameManualIdType.value;
        const idVal = renameManualIdInput.value.trim();
        const showUri = `${idType}:s:${idVal}`;

        if (renameType === "show") {
          body.show_uri_id = showUri;
          body.custom_title = customTitle;
        } else if (renameType === "movie") {
          const matchedMovie = localMoviesList.find(m => m.tmdb_id?.toString() === idVal);
          if (!matchedMovie) {
            window.showToast?.("Movie not found in collection. Ensure it is synced first.", "error");
            return;
          }
          body.media_id = matchedMovie.id;
          body.custom_title = customTitle;
        } else if (renameType === "season") {
          body.show_uri_id = showUri;
          body.season_number = parseInt(renameManualSeasonInput.value);
          body.season_custom_name = customTitle;
        } else if (renameType === "episode") {
          const seasonNum = parseInt(renameManualSeasonInput.value);
          const episodeNum = parseInt(renameManualEpisodeInput.value);
          
          saveRenameBtn.disabled = true;
          saveRenameBtn.textContent = "Resolving Episode...";
          
          const resolvedMediaId = await resolveManualEpisodeMediaId(showUri, seasonNum, episodeNum);
          if (!resolvedMediaId) {
            window.showToast?.("Episode not found in collection. Ensure it is synced first.", "error");
            saveRenameBtn.disabled = false;
            saveRenameBtn.textContent = "Save Custom Rename";
            return;
          }
          body.media_id = resolvedMediaId;
          body.custom_title = customTitle;
        }
      } else {
        if (renameType === "show") {
          body.show_uri_id = uriFor(renameSelectedShow, renameProvider);
          body.custom_title = customTitle;
        } else if (renameType === "movie") {
          body.media_id = renameSelectedShow.id;
          body.custom_title = customTitle;
        } else if (renameType === "season") {
          body.show_uri_id = uriFor(renameSelectedShow, renameProvider);
          body.season_number = renameSelectedSeason;
          body.season_custom_name = customTitle;
        } else if (renameType === "episode") {
          body.media_id = renameSelectedEpisode.id;
          body.custom_title = customTitle;
        }
      }

      saveRenameBtn.disabled = true;
      saveRenameBtn.textContent = "Saving...";

      try {
        const res = await fetch("/api/proxy/sync/custom-title", {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${token}`
          },
          body: JSON.stringify(body)
        });

        if (res.ok) {
          window.showToast?.("Custom rename applied successfully", "success");
          closeRenameModal();
          setTimeout(() => window.location.reload(), 800);
        } else {
          const detail = await res.json();
          window.showToast?.(detail.detail || "Failed to apply custom rename", "error");
          saveRenameBtn.disabled = false;
          saveRenameBtn.textContent = "Save Custom Rename";
        }
      } catch (err) {
        window.showToast?.("Error saving custom rename", "error");
        saveRenameBtn.disabled = false;
        saveRenameBtn.textContent = "Save Custom Rename";
      }
    });

    // Setup bulk apply action
    const applyAllBtn = document.getElementById("apply-all-overrides-btn");
    if (applyAllBtn) {
      applyAllBtn.addEventListener("click", async () => {
        if (!confirm("Are you sure you want to re-apply all overrides and update metadata? This may take some time.")) return;

        const icon = applyAllBtn.querySelector("svg");
        if (icon) icon.classList.add("animate-spin");
        applyAllBtn.setAttribute("disabled", "true");

        try {
          const res = await fetch("/api/proxy/sync/overrides/apply-all", {
            method: "POST",
            headers: { "Authorization": `Bearer ${token}` }
          });
          if (res.ok) {
            const data = await res.json();
            window.showToast?.(`Successfully applied all overrides! Remapped ${data.remapped} episodes.`, "success");
            setTimeout(() => window.location.reload(), 1500);
          } else {
            window.showToast?.("Failed to apply all overrides.", "error");
          }
        } catch (err) {
          window.showToast?.("Error applying all overrides.", "error");
        } finally {
          if (icon) icon.classList.remove("animate-spin");
          applyAllBtn.removeAttribute("disabled");
        }
      });
    }

    // Setup direct actions on existing items (Apply and Delete)
    document.querySelectorAll("[data-apply-id]").forEach(button => {
      button.addEventListener("click", async () => {
        const id = button.getAttribute("data-apply-id");
        if (!id) return;

        const icon = button.querySelector("svg");
        if (icon) icon.classList.add("animate-spin");
        button.setAttribute("disabled", "true");

        try {
          const res = await fetch(`/api/proxy/sync/season-overrides/${id}/apply`, {
            method: "POST",
            headers: { "Authorization": `Bearer ${token}` }
          });
          if (res.ok) {
            const data = await res.json();
            window.showToast?.(`Applied mapping successfully! Remapped ${data.remapped} episodes.`, "success");
          } else {
            window.showToast?.("Failed to apply season remapping override.", "error");
          }
        } catch (err) {
          window.showToast?.("Error applying override.", "error");
        } finally {
          if (icon) icon.classList.remove("animate-spin");
          button.removeAttribute("disabled");
        }
      });
    });

    document.querySelectorAll("[data-delete-id]").forEach(button => {
      button.addEventListener("click", async () => {
        const id = button.getAttribute("data-delete-id");
        if (!id) return;

        if (!confirm("Are you sure you want to delete this season override? Any previously remapped episodes will remain, but future sync operations will revert to standard mapping.")) {
          return;
        }

        try {
          const res = await fetch(`/api/proxy/sync/season-overrides/${id}`, {
            method: "DELETE",
            headers: { "Authorization": `Bearer ${token}` }
          });
          if (res.ok) {
            window.showToast?.("Override deleted successfully", "success");
            setTimeout(() => window.location.reload(), 600);
          } else {
            window.showToast?.("Failed to delete season override", "error");
          }
        } catch (err) {
          window.showToast?.("Error deleting override", "error");
        }
